     # cap at 64 jobs to avoid overwhelming system resources on high-CPU machines
@@ -460,7 +472,9 @@ rm -f ${RPM_BUILD_ROOT}%{_mandir}/man1/wcurl.1*
 %doc docs/TheArtOfHttpScripting.md
 %{_bindir}/curl
 %{_mandir}/man1/curl.1*
-%{_datadir}/zsh
