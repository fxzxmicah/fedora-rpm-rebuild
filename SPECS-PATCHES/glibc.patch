+from collections import defaultdict
+from pathlib import Path
+import sys
+
+
+def read_manifest(manifest):
+    packages = {}
+    owners = {}
+    for line in manifest.splitlines():
+        if not line:
+            continue
+        name, modules = line.split("\t", 1)
+        if ((name != "common" and not name.startswith("gconv-")) or
+                "/" in name or name in packages):
+            raise ValueError(f"Invalid or duplicate package: {name!r}")
+        packages[name] = []
+        for module in modules.split():
+            if module in owners:
+                raise ValueError(f"Duplicate ownership of {module}")
+            owners[module] = name
+    if not {"common", "gconv-other"} <= packages.keys():
+        raise ValueError("The manifest must include common and gconv-other")
+    return packages, owners
+
+
+def split_modules(directory, manifest):
+    packages, declared_owners = read_manifest(manifest)
+    owners = {}
+    for path in sorted(directory.glob("*.so")):
+        module = path.stem
+        owner = declared_owners.get(module, "gconv-other")
+        owners[module] = owner
+        packages[owner].append(path)
+        if module not in declared_owners:
+            print(f"gconv-other retains unclassified module: {path.name}")
+    return packages, owners
+
+
+def split_registrations(sources, owners):
+    """Keep aliases with their converters."""
+    registrations = defaultdict(list)
+    aliases = {}
+    charset_owners = defaultdict(set)
+    header = []
+    for source in sources:
+        for line in source.read_text().splitlines():
+            fields = line.split()
+            if not fields or fields[0].startswith("#"):
+                if source == sources[0] and not (registrations or aliases):
+                    header.append(line)
+                continue
+            if fields[0] == "module" and len(fields) in (4, 5):
+                origin, target, module = fields[1:4]
+                if module not in owners:
+                    raise ValueError(f"Registered module is not installed: {module}")
+                owner = owners[module]
+                registrations[owner].append(line)
+                if target == "INTERNAL":
+                    charset_owners[origin].add(owner)
+                if origin == "INTERNAL":
+                    charset_owners[target].add(owner)
+            elif fields[0] == "alias" and len(fields) == 3:
+                alias, target = fields[1:]
+                if alias in aliases and aliases[alias][0] != target:
+                    raise ValueError(f"Conflicting alias: {alias}")
+                aliases[alias] = (target, line)
+            else:
+                raise ValueError(f"Unrecognized gconv record in {source}: {line}")
+
+    for target, line in aliases.values():
+        seen = set()
+        while target in aliases:
+            if target in seen:
+                raise ValueError(f"Cyclic gconv alias: {target}")
+            seen.add(target)
+            target = aliases[target][0]
+        # Follow INTERNAL routes; built-in charsets belong to common.
+        for package in sorted(charset_owners.get(target, ("common",))):
+            registrations[package].append(line)
+    return "\n".join(header).rstrip() + "\n\n", registrations
+
+
+def split(root, libdir, manifest):
+    root = Path(root).resolve()
+    if root == Path("/"):
+        raise ValueError("The sysroot must be a staging directory, not the live system")
+    directory = root / libdir.lstrip("/") / "gconv"
+    packages, owners = split_modules(directory, manifest)
+    fragments = sorted((directory / "gconv-modules.d").glob("*.conf"))
+    header, registrations = split_registrations(
+        [directory / "gconv-modules", *fragments], owners)
+
+    # Replace input fragments only after validation.
+    for fragment in fragments:
+        fragment.unlink()
+    for name, paths in packages.items():
+        lines = ["/" + str(path.relative_to(root)) for path in paths]
+        if registrations[name] or name == "common":
+            config = (directory / "gconv-modules" if name == "common" else
+                      directory / "gconv-modules.d" / f"gconv-modules-{name[6:]}.conf")
+            config.write_text(header + "\n".join(registrations[name]) + "\n")
+            # Base config is listed in %%files common.
+            if name != "common":
+                lines.append("%%verify(not md5 size mtime) %%config(noreplace) /" +
+                             str(config.relative_to(root)))
+        Path(f"{name}.filelist").write_text(
+            "".join(line + "\n" for line in sorted(lines)))
+
+
+try:
+    split(sys.argv[1], sys.argv[2], """\
+%{lua: print_gconv_manifest()}
+""")
+except (OSError, ValueError) as error:
+    raise SystemExit(f"gconv split: {error}")
+GCONV_SPLIT
 
