+# Classify every converter, including the former glibc baseline modules.
+# The Lua package table also drives module ownership and registration files.
+%{__python3} - "%{glibc_sysroot}" "%{_libdir}" <<'GCONV_SPLIT'
+from collections import defaultdict
+from pathlib import Path
+import sys
+
+
+def read_manifest(manifest):
+    packages = {}
+    owners = {}
+    for line in manifest.splitlines():
+        if not line:
+            continue
+        name, modules = line.split("\t", 1)
+        if ((name != "common" and not name.startswith("gconv-")) or
+                "/" in name or name in packages):
+            raise ValueError(f"Invalid or duplicate package: {name!r}")
+        packages[name] = []
+        for module in modules.split():
+            if module in owners:
+                raise ValueError(f"Duplicate ownership of {module}")
+            owners[module] = name
+    if not {"common", "gconv-other"} <= packages.keys():
+        raise ValueError("The manifest must include common and gconv-other")
+    return packages, owners
+
+
+def split_modules(directory, packages, declared_owners):
+    installed = {path.name: path for path in directory.glob("*.so")}
+    owners = {}
+    unclassified = []
+    for name, path in sorted(installed.items()):
+        module = name.removesuffix(".so")
+        owner = declared_owners.get(module, "gconv-other")
+        owners[module] = owner
+        packages[owner].append(path)
+        if module not in declared_owners:
+            unclassified.append(name)
+    if unclassified:
+        print("gconv-other retains unclassified modules: " + ", ".join(unclassified))
+    return owners
+
+
+def split_registrations(directory, owners):
+    """Keep aliases with their canonical converters, including alias chains."""
+    sources = [directory / "gconv-modules",
+               directory / "gconv-modules.d/gconv-modules-extra.conf"]
+    records = []
+    aliases = {}
+    canonical_owners = defaultdict(set)
+    direct_owners = defaultdict(set)
+    header = []
+    for source in sources:
+        for line in source.read_text().splitlines():
+            fields = line.split()
+            if not fields or fields[0].startswith("#"):
+                if source == sources[0] and not records:
+                    header.append(line)
+                continue
+            if fields[0] == "module" and len(fields) in (4, 5):
+                origin, target, module = fields[1:4]
+                if module not in owners:
+                    raise ValueError(f"Registered module is not installed: {module}")
+                owner = owners[module]
+                records.append((owner, line))
+                for charset in (origin, target):
+                    if charset != "INTERNAL":
+                        direct_owners[charset].add(owner)
+                if target == "INTERNAL":
+                    canonical_owners[origin].add(owner)
+                if origin == "INTERNAL":
+                    canonical_owners[target].add(owner)
+            elif fields[0] == "alias" and len(fields) == 3:
+                alias, target = fields[1:]
+                if alias in aliases and aliases[alias] != target:
+                    raise ValueError(f"Conflicting alias: {alias}")
+                aliases[alias] = target
+                records.append((None, line))
+            else:
+                raise ValueError(f"Unrecognized gconv record in {source}: {line}")
+
+    result = defaultdict(list)
+    for owner, line in records:
+        if owner is not None:
+            result[owner].append(line)
+            continue
+        target = line.split()[2]
+        seen = set()
+        while target in aliases:
+            if target in seen:
+                raise ValueError(f"Cyclic gconv alias: {target}")
+            seen.add(target)
+            target = aliases[target]
+        # Keep aliases for libc's built-in conversions in the common config.
+        targets = canonical_owners.get(target) or direct_owners.get(target) or {"common"}
+        for package in sorted(targets):
+            result[package].append(line)
+    return "\n".join(header).rstrip() + "\n\n", result
+
+
+def split(root, libdir, manifest):
+    root = Path(root).resolve()
+    if root == Path("/"):
+        raise ValueError("The sysroot must be a staging directory, not the live system")
+    directory = root / libdir.lstrip("/") / "gconv"
+    packages, declared_owners = read_manifest(manifest)
+    owners = split_modules(directory, packages, declared_owners)
+    header, registrations = split_registrations(directory, owners)
+
+    # Validate the complete partition before changing the installed files.
+    if registrations.keys() - packages.keys():
+        raise ValueError("Registrations reference an undeclared package")
+    for name, paths in packages.items():
+        lines = ["/" + str(path.relative_to(root)) for path in paths]
+        if registrations[name]:
+            config = (directory / "gconv-modules" if name == "common" else
+                      directory / "gconv-modules.d" / f"gconv-modules-{name[6:]}.conf")
+            config.write_text(header + "\n".join(registrations[name]) + "\n")
+            # The common base configuration is listed explicitly in %%files.
+            if name != "common":
+                lines.append("%%verify(not md5 size mtime) %%config(noreplace) /" +
+                             str(config.relative_to(root)))
+        Path(f"{name}.filelist").write_text(
+            "\n".join(sorted(lines)) + ("\n" if lines else ""))
+    (directory / "gconv-modules.d/gconv-modules-extra.conf").unlink()
+
