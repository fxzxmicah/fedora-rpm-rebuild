+  LogicalMonitor *logical_monitor;
+
+  logical_monitor = g_new0 (LogicalMonitor, 1);
+  logical_monitor->monitors = g_ptr_array_new ();
+  g_variant_get (variant, "(iidub@a(ssss)@a{sv})",
+                 &logical_monitor->x,
+                 &logical_monitor->y,
+                 &logical_monitor->scale,
+                 &logical_monitor->transform,
+                 &logical_monitor->is_primary,
+                 &monitor_specs,
+                 &properties);
+  logical_monitor->properties = g_steal_pointer (&properties);
+
+  g_variant_iter_init (&iter, monitor_specs);
+  while ((spec = g_variant_iter_next_value (&iter)))
+    {
+      const char *connector;
+      Monitor *monitor;
+
+      g_variant_get_child (spec, 0, "&s", &connector);
+      monitor = g_hash_table_lookup (state->monitors_by_connector, connector);
+      g_assert_nonnull (monitor);
+      g_ptr_array_add (logical_monitor->monitors, monitor);
+      g_variant_unref (spec);
+    }
+
+  return logical_monitor;
+}
+
+static MonitorsState *
+monitors_state_new (GError **error)
+{
+  g_autoptr (GVariant) current_state = NULL;
+  g_autoptr (GVariant) monitors = NULL;
+  g_autoptr (GVariant) logical_monitors = NULL;
+  g_autoptr (GVariant) properties = NULL;
+  GVariantIter iter;
+  GVariant *variant;
+  MonitorsState *state;
+  unsigned int layout_mode;
+
+  state = g_new0 (MonitorsState, 1);
+  state->proxy = g_dbus_proxy_new_for_bus_sync (
+    G_BUS_TYPE_SESSION,
+    G_DBUS_PROXY_FLAGS_NONE,
+    NULL,
+    DISPLAY_CONFIG_NAME,
+    DISPLAY_CONFIG_PATH,
+    DISPLAY_CONFIG_INTERFACE,
+    NULL,
+    error);
+  if (!state->proxy)
+    goto fail;
+
+  current_state = g_dbus_proxy_call_sync (state->proxy,
+                                          "GetCurrentState",
+                                          NULL,
+                                          G_DBUS_CALL_FLAGS_NO_AUTO_START,
+                                          -1,
+                                          NULL,
+                                          error);
+  if (!current_state)
+    goto fail;
+
+  g_variant_get (current_state,
+                 "(u@a((ssss)a(siiddada{sv})a{sv})"
+                 "@a(iiduba(ssss)a{sv})@a{sv})",
+                 &state->serial,
+                 &monitors,
+                 &logical_monitors,
+                 &properties);
+  state->properties = g_steal_pointer (&properties);
+  g_variant_lookup (state->properties,
+                    "supports-changing-layout-mode",
+                    "b",
+                    &state->supports_changing_layout_mode);
+  if (g_variant_lookup (state->properties,
+                        "layout-mode", "u", &layout_mode))
+    state->layout_mode = layout_mode;
+  else
+    state->layout_mode = LAYOUT_MODE_LOGICAL;
+
+  state->monitors =
+    g_ptr_array_new_with_free_func ((GDestroyNotify) monitor_free);
+  state->monitors_by_connector = g_hash_table_new (g_str_hash, g_str_equal);
+  g_variant_iter_init (&iter, monitors);
+  while ((variant = g_variant_iter_next_value (&iter)))
+    {
+      Monitor *monitor = monitor_new_from_variant (variant);
+
+      g_ptr_array_add (state->monitors, monitor);
+      g_hash_table_insert (state->monitors_by_connector,
+                           monitor->connector,
+                           monitor);
+      g_variant_unref (variant);
+    }
+
+  state->logical_monitors =
+    g_ptr_array_new_with_free_func ((GDestroyNotify) logical_monitor_free);
+  g_variant_iter_init (&iter, logical_monitors);
+  while ((variant = g_variant_iter_next_value (&iter)))
+    {
+      LogicalMonitor *logical_monitor =
+        logical_monitor_new_from_variant (state, variant);
+
+      g_ptr_array_add (state->logical_monitors, logical_monitor);
+      g_variant_unref (variant);
+    }
+
+  return state;
+
+fail:
+  monitors_state_free (state);
+  return NULL;
+}
+
+static gboolean
+level_is_active (GArray *levels,
+                 int     level)
+{
+  unsigned int i;
+
+  for (i = 0; i < levels->len; i++)
+    {
+      if (g_array_index (levels, int, i) == level)
+        return TRUE;
+    }
+
+  return FALSE;
+}
+
+static void
+remove_active_level (GArray *levels,
+                     int     level)
+{
+  unsigned int i;
+
+  for (i = 0; i < levels->len; i++)
+    {
+      if (g_array_index (levels, int, i) == level)
+        {
+          g_array_remove_index (levels, i);
+          return;
+        }
+    }
+}
+
+static void
+print_data (int         level,
+            gboolean    is_last,
+            GArray     *levels,
+            const char *data)
+{
+  g_autoptr (GString) line = g_string_new (NULL);
+  int i;
+
+  if (level < 0)
+    {
+      g_print ("%s\n", data);
+      return;
+    }
+
+  for (i = 0; i < level * 4 - 1; i++)
+    {
+      gboolean is_line_position =
+        (i == 0 && level_is_active (levels, 0)) ||
+        (i >= 3 && (i + 1) % 4 == 0 &&
+         level_is_active (levels, (i + 1) / 4));
+
+      g_string_append (line, is_line_position ? "│" : " ");
+    }
+  g_string_append (line, is_last ? "└──" : "├──");
+  g_string_append (line, data);
+  g_print ("%s\n", line->str);
+
+  if (is_last)
+    remove_active_level (levels, level);
+  else if (!level_is_active (levels, level))
+    g_array_append_val (levels, level);
+}
+
+static char *
+format_double (double value)
+{
+  char buffer[G_ASCII_DTOSTR_BUF_SIZE];
+
+  g_ascii_dtostr (buffer, sizeof (buffer), value);
+  if (!strchr (buffer, '.') && !strchr (buffer, 'e') && !strchr (buffer, 'E'))
+    return g_strconcat (buffer, ".0", NULL);
+
+  return g_strdup (buffer);
+}
+
+static char *
+format_monitor_title (Monitor  *monitor,
+                      gboolean  include_prefix)
+{
+  const char *prefix = include_prefix ? "Monitor " : "";
+
+  if (monitor->display_name && *monitor->display_name)
+    return g_strdup_printf ("%s%s (%s)",
+                            prefix,
+                            monitor->connector,
+                            monitor->display_name);
+
+  return g_strconcat (prefix, monitor->connector, NULL);
+}
+
+static const char *
+enum_property_to_string (const char *name,
+                         unsigned int value)
+{
+  if (g_str_equal (name, "layout-mode"))
+    return layout_mode_to_string (value);
+  if (g_str_equal (name, "color-mode") ||
+      g_str_equal (name, "supported-color-modes"))
+    {
+      if (value < G_N_ELEMENTS (color_mode_names))
+        return color_mode_names[value];
+    }
+  if (g_str_equal (name, "rgb-range"))
+    {
+      if (value < G_N_ELEMENTS (rgb_range_names))
+        return rgb_range_names[value];
+    }
+
+  return NULL;
+}
+
+static char *
+property_value_to_string_full (const char *name,
+                               GVariant   *value,
+                               gboolean    nested)
+{
+  const GVariantType *type = g_variant_get_type (value);
+
+  if (g_variant_type_equal (type, G_VARIANT_TYPE_BOOLEAN))
+    {
+      if (nested)
+        return g_strdup (g_variant_get_boolean (value) ? "True" : "False");
+      return g_strdup (g_variant_get_boolean (value) ? "yes" : "no");
+    }
+  if (g_variant_type_equal (type, G_VARIANT_TYPE_STRING))
+    return g_variant_dup_string (value, NULL);
+  if (g_variant_type_equal (type, G_VARIANT_TYPE_UINT32))
+    {
+      unsigned int number = g_variant_get_uint32 (value);
+      const char *enum_name = enum_property_to_string (name, number);
+
+      if (enum_name)
+        return g_strdup (enum_name);
+      return g_strdup_printf ("%u", number);
+    }
+  if (g_variant_type_equal (type, G_VARIANT_TYPE_INT32))
+    return g_strdup_printf ("%d", g_variant_get_int32 (value));
+  if (g_variant_type_equal (type, G_VARIANT_TYPE_DOUBLE))
+    return format_double (g_variant_get_double (value));
+  if (g_variant_type_is_array (type))
+    {
+      g_autoptr (GString) result = g_string_new ("[");
+      GVariantIter iter;
+      GVariant *element;
+      gboolean first = TRUE;
+
+      g_variant_iter_init (&iter, value);
+      while ((element = g_variant_iter_next_value (&iter)))
+        {
+          g_autofree char *element_string =
+            property_value_to_string_full (name, element, TRUE);
+
+          if (!first)
+            g_string_append (result, ", ");
+          g_string_append (result, element_string);
+          first = FALSE;
+          g_variant_unref (element);
+        }
+      g_string_append_c (result, ']');
+      return g_string_free (g_steal_pointer (&result), FALSE);
+    }
+  if (g_variant_type_is_tuple (type))
+    {
+      g_autoptr (GString) result = g_string_new ("(");
+      gsize n_children = g_variant_n_children (value);
+      gsize i;
+
+      for (i = 0; i < n_children; i++)
+        {
+          g_autoptr (GVariant) child = g_variant_get_child_value (value, i);
+          g_autofree char *child_string =
+            property_value_to_string_full (name, child, TRUE);
+
+          if (i > 0)
+            g_string_append (result, ", ");
+          g_string_append (result, child_string);
+        }
+      if (n_children == 1)
+        g_string_append_c (result, ',');
+      g_string_append_c (result, ')');
+      return g_string_free (g_steal_pointer (&result), FALSE);
+    }
+
+  return g_variant_print (value, FALSE);
+}
+
+static char *
+property_value_to_string (const char *name,
+                          GVariant   *value)
+{
+  return property_value_to_string_full (name, value, FALSE);
+}
+
+static void
+print_properties (int       level,
+                  GArray   *levels,
+                  GVariant *properties)
+{
+  GVariantIter iter;
+  const char *key;
+  GVariant *value;
+  gsize n_properties;
+  gsize i = 0;
+  g_autofree char *title = NULL;
+
+  n_properties = g_variant_n_children (properties);
+  title = g_strdup_printf ("Properties: (%" G_GSIZE_FORMAT ")", n_properties);
+  print_data (level, TRUE, levels, title);
+
+  g_variant_iter_init (&iter, properties);
+  while (g_variant_iter_next (&iter, "{&sv}", &key, &value))
+    {
+      g_autofree char *value_string = property_value_to_string (key, value);
+      g_autofree char *line = g_strdup_printf ("%s ⇒  %s", key, value_string);
+
+      print_data (level + 1, i == n_properties - 1, levels, line);
+      i++;
+      g_variant_unref (value);
+    }
+}
+
+static GVariant *
+find_backlight (MonitorsState *state,
+                Monitor       *monitor,
+                unsigned int  *serial)
+{
+  g_autoptr (GVariant) backlight = NULL;
+  g_autoptr (GVariant) entries = NULL;
+  GVariantIter iter;
+  GVariant *entry;
+
+  if (!state->proxy)
+    return NULL;
+
+  backlight = g_dbus_proxy_get_cached_property (state->proxy, "Backlight");
+  if (!backlight)
+    return NULL;
+
+  g_variant_get (backlight, "(u@aa{sv})", serial, &entries);
+  g_variant_iter_init (&iter, entries);
+  while ((entry = g_variant_iter_next_value (&iter)))
+    {
+      const char *connector;
+
+      if (g_variant_lookup (entry, "connector", "&s", &connector) &&
+          g_str_equal (connector, monitor->connector))
+        return entry;
+      g_variant_unref (entry);
+    }
+
+  return NULL;
+}
+
+static void
+print_monitor_preferences (MonitorsState *state,
+                           Monitor       *monitor,
+                           int            level,
+                           GArray        *levels,
+                           gboolean       is_last)
+{
+  g_autoptr (GVariant) backlight = NULL;
+  unsigned int serial;
+
+  print_data (level, is_last, levels, "Preferences");
+  backlight = find_backlight (state, monitor, &serial);
+  if (!backlight)
+    {
+      print_data (level + 1, TRUE, levels, "Backlight: None");
+      return;
+    }
+
+  print_data (level + 1, TRUE, levels, "Backlight:");
+  {
+    GVariantIter iter;
+    const char *key;
+    GVariant *value;
+    gsize n_properties = g_variant_n_children (backlight) - 1;
+    gsize i = 0;
+
+    g_variant_iter_init (&iter, backlight);
+    while (g_variant_iter_next (&iter, "{&sv}", &key, &value))
+      {
+        g_autofree char *value_string = NULL;
+        g_autofree char *line = NULL;
+
+        if (g_str_equal (key, "connector"))
+          {
+            g_variant_unref (value);
+            continue;
+          }
+
+        value_string = property_value_to_string_full (key, value, TRUE);
+        line = g_strdup_printf ("%s ⇒  %s", key, value_string);
+        print_data (level + 2, i == n_properties - 1, levels, line);
+        i++;
+        g_variant_unref (value);
+      }
+  }
+}
+
+static void
+print_mode (MonitorMode *mode,
+            gboolean     is_last,
+            gboolean     show_properties,
+            GArray      *levels)
+{
+  print_data (2, is_last, levels, mode->id);
+
+  if (show_properties)
+    {
+      char refresh_rate_value[G_ASCII_DTOSTR_BUF_SIZE];
+      g_autofree char *dimension = NULL;
+      g_autofree char *refresh_rate = NULL;
+      g_autofree char *preferred_scale = NULL;
+      g_autoptr (GString) scales = g_string_new ("Supported scales: [");
+      unsigned int i;
+
+      dimension = g_strdup_printf ("Dimension: %dx%d",
+                                   mode->width,
+                                   mode->height);
+      g_ascii_formatd (refresh_rate_value,
+                       sizeof (refresh_rate_value),
+                       "%.3f",
+                       mode->refresh_rate);
+      refresh_rate = g_strdup_printf ("Refresh rate: %s",
+                                      refresh_rate_value);
+      preferred_scale = format_double (mode->preferred_scale);
+      {
+        g_autofree char *line =
+          g_strdup_printf ("Preferred scale: %s", preferred_scale);
+
+        print_data (3, FALSE, levels, dimension);
+        print_data (3, FALSE, levels, refresh_rate);
+        print_data (3, FALSE, levels, line);
+      }
+
+      for (i = 0; i < mode->supported_scales->len; i++)
+        {
+          double scale = g_array_index (mode->supported_scales, double, i);
+          g_autofree char *scale_string = format_double (scale);
+
+          if (i > 0)
+            g_string_append (scales, ", ");
+          g_string_append (scales, scale_string);
+        }
+      g_string_append_c (scales, ']');
+      print_data (3, FALSE, levels, scales->str);
+      print_properties (3, levels, mode->properties);
+    }
+}
+
+static void
+print_current_state (MonitorsState *state,
+                     gboolean       show_modes,
+                     gboolean       show_properties)
+{
+  g_autoptr (GArray) levels = g_array_new (FALSE, FALSE, sizeof (int));
+  unsigned int i;
+
+  g_print ("Monitors:\n");
+  for (i = 0; i < state->monitors->len; i++)
+    {
+      Monitor *monitor = g_ptr_array_index (state->monitors, i);
+      gboolean is_last = i == state->monitors->len - 1;
+      g_autofree char *title = format_monitor_title (monitor, TRUE);
+
+      print_data (0, is_last, levels, title);
+
+      if (monitor->vendor[0])
+        {
+          g_autofree char *line =
+            g_strdup_printf ("Vendor: %s", monitor->vendor);
+          print_data (1, FALSE, levels, line);
+        }
+      if (monitor->product[0])
+        {
+          g_autofree char *line =
+            g_strdup_printf ("Product: %s", monitor->product);
+          print_data (1, FALSE, levels, line);
+        }
+      if (monitor->serial[0])
+        {
+          g_autofree char *line =
+            g_strdup_printf ("Serial: %s", monitor->serial);
+          print_data (1, FALSE, levels, line);
+        }
+
+      if (show_modes)
+        {
+          g_autofree char *line =
+            g_strdup_printf ("Modes (%u)", monitor->modes->len);
+          unsigned int j;
+
+          print_data (1, !show_properties, levels, line);
+          for (j = 0; j < monitor->modes->len; j++)
+            {
+              MonitorMode *mode = g_ptr_array_index (monitor->modes, j);
+
+              print_mode (mode,
+                          j == monitor->modes->len - 1,
+                          show_properties,
+                          levels);
+            }
+        }
+      else
+        {
+          MonitorMode *mode = monitor->current_mode;
+          const char *mode_type = "Current mode";
+
+          if (!mode)
+            {
+              mode = monitor->preferred_mode;
+              mode_type = "Preferred mode";
+            }
+          if (mode)
+            {
+              print_data (1, FALSE, levels, mode_type);
+              print_mode (mode, TRUE, show_properties, levels);
+            }
+        }
+
+      print_monitor_preferences (state,
+                                 monitor,
+                                 1,
+                                 levels,
+                                 !show_properties);
+      if (show_properties)
+        print_properties (1, levels, monitor->properties);
+    }
+
+  g_print ("\nLogical monitors:\n");
+  for (i = 0; i < state->logical_monitors->len; i++)
+    {
+      LogicalMonitor *logical_monitor =
+        g_ptr_array_index (state->logical_monitors, i);
+      g_autofree char *title =
+        g_strdup_printf ("Logical monitor #%u", i + 1);
+      g_autofree char *position =
+        g_strdup_printf ("Position: (%d, %d)",
+                         logical_monitor->x,
+                         logical_monitor->y);
+      g_autofree char *scale_value = format_double (logical_monitor->scale);
+      g_autofree char *scale = g_strdup_printf ("Scale: %s", scale_value);
+      g_autofree char *transform =
+        g_strdup_printf ("Transform: %s",
+                         transform_names[logical_monitor->transform]);
+      g_autofree char *primary =
+        g_strdup_printf ("Primary: %s",
+                         logical_monitor->is_primary ? "yes" : "no");
+      g_autofree char *monitors =
+        g_strdup_printf ("Monitors: (%u)", logical_monitor->monitors->len);
+      unsigned int j;
+
+      print_data (0, i == state->logical_monitors->len - 1, levels, title);
+      print_data (1, FALSE, levels, position);
+      print_data (1, FALSE, levels, scale);
+      print_data (1, FALSE, levels, transform);
+      print_data (1, FALSE, levels, primary);
+      print_data (1, !show_properties, levels, monitors);
+      for (j = 0; j < logical_monitor->monitors->len; j++)
+        {
+          Monitor *monitor = g_ptr_array_index (logical_monitor->monitors, j);
+          g_autofree char *monitor_title =
+            format_monitor_title (monitor, FALSE);
+
+          print_data (2,
+                      j == logical_monitor->monitors->len - 1,
+                      levels,
+                      monitor_title);
+        }
+
+      if (show_properties)
+        print_properties (1, levels, logical_monitor->properties);
+    }
+
+  if (show_properties)
+    {
+      g_print ("\n");
+      print_properties (-1, levels, state->properties);
+    }
+}
+
+static MonitorMode *
+find_monitor_mode (Monitor    *monitor,
+                   const char *mode_id)
+{
+  unsigned int i;
+
+  for (i = 0; i < monitor->modes->len; i++)
+    {
+      MonitorMode *mode = g_ptr_array_index (monitor->modes, i);
+
+      if (g_str_equal (mode->id, mode_id))
+        return mode;
+    }
+
+  return NULL;
+}
+
+static gboolean
+parse_int (const char  *value,
+           int         *result,
+           GError     **error)
+{
+  char *end = NULL;
+  int64_t number;
+
+  number = g_ascii_strtoll (value, &end, 10);
+  if (!end || *end || number < G_MININT || number > G_MAXINT)
+    {
+      g_set_error (error, G_OPTION_ERROR, G_OPTION_ERROR_BAD_VALUE,
+                   "Invalid integer %s", value);
+      return FALSE;
+    }
+
+  *result = number;
+  return TRUE;
+}
+
+static gboolean
+parse_double (const char  *value,
+              double      *result,
+              GError     **error)
+{
+  char *end = NULL;
+
+  *result = g_ascii_strtod (value, &end);
+  if (!end || *end || !isfinite (*result))
+    {
+      g_set_error (error, G_OPTION_ERROR, G_OPTION_ERROR_BAD_VALUE,
+                   "Invalid number %s", value);
+      return FALSE;
+    }
+
+  return TRUE;
+}
