+
+static gboolean
+option_name_is (const char *option_name,
+                const char *long_name,
+                char        short_name)
+{
+  return g_str_equal (option_name, long_name) ||
+         (option_name[0] == '-' &&
+          option_name[1] == short_name &&
+          option_name[2] == '\0');
+}
+
+static gboolean
+parse_show_option (const char  *option_name,
+                   const char  *value,
+                   gpointer     user_data,
+                   GError     **error)
+{
+  ShowParseData *data = user_data;
+
+  if (option_name_is (option_name, "--modes", 'm'))
+    data->modes = TRUE;
+  else if (option_name_is (option_name, "--properties", 'p'))
+    data->properties = TRUE;
+  else if (option_name_is (option_name, "--verbose", 'v'))
+    data->modes = data->properties = TRUE;
+  else
+    g_assert_not_reached ();
+
+  return TRUE;
+}
+
+static gboolean
+parse_show_arguments (int         argc,
+                      char      **argv,
+                      gboolean   *modes,
+                      gboolean   *properties,
+                      GError    **error)
+{
+  g_autoptr (GOptionContext) context = NULL;
+  GOptionGroup *group;
+  ShowParseData data = {0};
+
+  context = g_option_context_new (NULL);
+  g_option_context_set_summary (context, "Show display configuration");
+  group = g_option_group_new ("show",
+                              "Show options",
+                              "Show display options",
+                              &data,
+                              NULL);
+  g_option_group_add_entries (group, show_options);
+  g_option_context_set_main_group (context, group);
+
+  if (!g_option_context_parse (context, &argc, &argv, error))
+    return FALSE;
+
+  if (argc > 1)
+    {
+      g_set_error (error, G_OPTION_ERROR, G_OPTION_ERROR_UNKNOWN_OPTION,
+                   "Unknown argument %s", argv[1]);
+      return FALSE;
+    }
+
+  *modes = data.modes;
+  *properties = data.properties;
+  return TRUE;
+}
+
+static gboolean
+parse_set_option (const char  *option_name,
+                  const char  *value,
+                  gpointer     user_data,
+                  GError     **error)
+{
+  SetParseData *data = user_data;
+  SetArguments *args = data->args;
+
+  if (option_name_is (option_name, "--persistent", 'P') ||
+      option_name_is (option_name, "--verify", 'V') ||
+      option_name_is (option_name, "--verbose", 'v') ||
+      option_name_is (option_name, "--layout-mode", 'l'))
+    {
+      if (data->logical_monitor)
+        {
+          g_set_error (error, G_OPTION_ERROR, G_OPTION_ERROR_FAILED,
+                       "%s must be passed in global scope", option_name);
+          return FALSE;
+        }
+
+      if (option_name_is (option_name, "--persistent", 'P'))
+        args->persistent = TRUE;
+      else if (option_name_is (option_name, "--verify", 'V'))
+        args->verify = TRUE;
+      else if (option_name_is (option_name, "--verbose", 'v'))
+        args->verbose = TRUE;
+      else
+        {
+          if (!parse_layout_mode (value, &args->layout_mode, error))
+            return FALSE;
+          args->has_layout_mode = TRUE;
+        }
+    }
+  else if (option_name_is (option_name, "--logical-monitor", 'L'))
+    {
+      data->logical_monitor = g_new0 (LogicalMonitorArguments, 1);
+      data->logical_monitor->monitors =
+        g_ptr_array_new_with_free_func (
+          (GDestroyNotify) monitor_arguments_free);
+      data->logical_monitor->transform = TRANSFORM_NORMAL;
+      g_ptr_array_add (args->logical_monitor_args, data->logical_monitor);
+      data->monitor = NULL;
+    }
+  else if (option_name_is (option_name, "--for-lease-monitor", 'e'))
+    {
+      g_ptr_array_add (args->monitor_lease_connectors, g_strdup (value));
+    }
+  else if (option_name_is (option_name, "--monitor", 'M'))
+    {
+      if (!data->logical_monitor)
+        goto no_logical_monitor;
+
+      data->monitor = g_new0 (MonitorArguments, 1);
+      data->monitor->connector = g_strdup (value);
+      data->monitor->color_mode = -1;
+      data->monitor->rgb_range = -1;
+      g_ptr_array_add (data->logical_monitor->monitors, data->monitor);
+    }
+  else if (option_name_is (option_name, "--mode", 'm') ||
+           option_name_is (option_name, "--color-mode", 'c') ||
+           option_name_is (option_name, "--rgb-range", 'r'))
+    {
+      if (!data->monitor)
+        {
+          g_set_error (error, G_OPTION_ERROR, G_OPTION_ERROR_FAILED,
+                       "No current monitor for %s", option_name);
+          return FALSE;
+        }
+
+      if (option_name_is (option_name, "--mode", 'm'))
+        {
+          g_free (data->monitor->mode);
+          data->monitor->mode = g_strdup (value);
+        }
+      else if (option_name_is (option_name, "--color-mode", 'c'))
+        {
+          if (!parse_named_value (value,
+                                  color_mode_names,
+                                  G_N_ELEMENTS (color_mode_names),
+                                  &data->monitor->color_mode,
+                                  error))
+            return FALSE;
+        }
+      else if (!parse_named_value (value,
+                                   rgb_range_names,
+                                   G_N_ELEMENTS (rgb_range_names),
+                                   &data->monitor->rgb_range,
+                                   error))
+        {
+          return FALSE;
+        }
+    }
+  else
+    {
+      char **relative_position = NULL;
+
+      if (!data->logical_monitor)
+        goto no_logical_monitor;
+
+      if (option_name_is (option_name, "--primary", 'p'))
+        data->logical_monitor->is_primary = TRUE;
+      else if (option_name_is (option_name, "--scale", 's'))
+        {
+          if (!parse_double (value, &data->logical_monitor->scale, error))
+            return FALSE;
+        }
+      else if (option_name_is (option_name, "--transform", 't'))
+        {
+          if (!parse_transform (value,
+                                &data->logical_monitor->transform,
+                                error))
+            return FALSE;
+        }
+      else if (option_name_is (option_name, "--x", 'x'))
+        {
+          if (!parse_int (value, &data->logical_monitor->x, error))
+            return FALSE;
+          data->logical_monitor->has_x = TRUE;
+        }
+      else if (option_name_is (option_name, "--y", 'y'))
+        {
+          if (!parse_int (value, &data->logical_monitor->y, error))
+            return FALSE;
+          data->logical_monitor->has_y = TRUE;
+        }
+      else if (g_str_equal (option_name, "--right-of"))
+        relative_position = &data->logical_monitor->right_of;
+      else if (g_str_equal (option_name, "--left-of"))
+        relative_position = &data->logical_monitor->left_of;
+      else if (g_str_equal (option_name, "--above"))
+        relative_position = &data->logical_monitor->above;
+      else if (g_str_equal (option_name, "--below"))
+        relative_position = &data->logical_monitor->below;
+      else
+        g_assert_not_reached ();
+
+      if (relative_position)
+        {
+          g_free (*relative_position);
+          *relative_position = g_strdup (value);
+        }
+    }
+
+  return TRUE;
+
+no_logical_monitor:
+  g_set_error (error, G_OPTION_ERROR, G_OPTION_ERROR_FAILED,
+               "No current logical monitor for %s", option_name);
+  return FALSE;
+}
+
+static gboolean
+parse_set_arguments (int            argc,
+                     char         **argv,
+                     SetArguments  *args,
+                     GError       **error)
+{
+  g_autoptr (GOptionContext) context = NULL;
+  GOptionGroup *global_group;
+  SetParseData data = {
+    .args = args,
+  };
+
+  args->logical_monitor_args =
+    g_ptr_array_new_with_free_func (
+      (GDestroyNotify) logical_monitor_arguments_free);
+  args->monitor_lease_connectors = g_ptr_array_new_with_free_func (g_free);
+
+  context = g_option_context_new (NULL);
+  g_option_context_set_summary (context, "Set display configuration");
+  g_option_context_set_description (
+    context,
+    "Logical monitor options apply after --logical-monitor; monitor options "
+    "apply after --monitor.");
+
+  global_group = g_option_group_new ("set",
+                                     "Options",
+                                     "Show all options",
+                                     &data,
+                                     NULL);
+  g_option_group_add_entries (global_group, set_global_options);
+  g_option_group_add_entries (global_group, set_logical_monitor_options);
+  g_option_group_add_entries (global_group, set_monitor_options);
+  g_option_context_set_main_group (context, global_group);
+
+  if (!g_option_context_parse (context, &argc, &argv, error))
+    return FALSE;
+
+  if (argc > 1)
+    {
+      g_set_error (error, G_OPTION_ERROR, G_OPTION_ERROR_UNKNOWN_OPTION,
+                   "Unknown argument %s", argv[1]);
+      return FALSE;
+    }
+
+  return TRUE;
+}
+
+static gboolean
+resolve_set_arguments (MonitorsState  *state,
+                       SetArguments   *args,
+                       GError        **error)
+{
+  unsigned int i;
+
+  args->logical_monitors =
+    g_ptr_array_new_with_free_func ((GDestroyNotify) logical_monitor_free);
+  args->monitors_for_lease = g_ptr_array_new ();
+
+  for (i = 0; i < args->monitor_lease_connectors->len; i++)
+    {
+      const char *connector =
+        g_ptr_array_index (args->monitor_lease_connectors, i);
+      Monitor *monitor =
+        g_hash_table_lookup (state->monitors_by_connector, connector);
+
+      if (!monitor)
+        {
+          g_set_error (error, G_OPTION_ERROR, G_OPTION_ERROR_BAD_VALUE,
+                       "Monitor %s not found", connector);
+          return FALSE;
+        }
+      g_ptr_array_add (args->monitors_for_lease, monitor);
+    }
+
+  for (i = 0; i < args->logical_monitor_args->len; i++)
+    {
+      LogicalMonitorArguments *logical_monitor_args =
+        g_ptr_array_index (args->logical_monitor_args, i);
+      LogicalMonitor *logical_monitor = g_new0 (LogicalMonitor, 1);
+      unsigned int j;
+
+      logical_monitor->monitors = g_ptr_array_new ();
+      logical_monitor->x = logical_monitor_args->x;
+      logical_monitor->y = logical_monitor_args->y;
+      logical_monitor->scale = logical_monitor_args->scale;
+      logical_monitor->transform = logical_monitor_args->transform;
+      logical_monitor->is_primary = logical_monitor_args->is_primary;
+      logical_monitor->has_x = logical_monitor_args->has_x;
+      logical_monitor->has_y = logical_monitor_args->has_y;
+      logical_monitor->right_of = g_strdup (logical_monitor_args->right_of);
+      logical_monitor->left_of = g_strdup (logical_monitor_args->left_of);
+      logical_monitor->above = g_strdup (logical_monitor_args->above);
+      logical_monitor->below = g_strdup (logical_monitor_args->below);
+      g_ptr_array_add (args->logical_monitors, logical_monitor);
+
+      for (j = 0; j < logical_monitor_args->monitors->len; j++)
+        {
+          MonitorArguments *monitor_args =
+            g_ptr_array_index (logical_monitor_args->monitors, j);
+          Monitor *monitor =
+            g_hash_table_lookup (state->monitors_by_connector,
+                                 monitor_args->connector);
+
+          if (!monitor)
+            {
+              g_set_error (error, G_OPTION_ERROR, G_OPTION_ERROR_BAD_VALUE,
+                           "Monitor %s not found", monitor_args->connector);
+              return FALSE;
+            }
+
+          monitor->configured_mode = NULL;
+          if (monitor_args->mode)
+            {
+              monitor->configured_mode =
+                find_monitor_mode (monitor, monitor_args->mode);
+              if (!monitor->configured_mode)
+                {
+                  g_set_error (error,
+                               G_OPTION_ERROR,
+                               G_OPTION_ERROR_BAD_VALUE,
+                               "No mode %s available for %s",
+                               monitor_args->mode,
+                               monitor->connector);
+                  return FALSE;
+                }
+            }
+          monitor->color_mode = monitor_args->color_mode;
+          monitor->rgb_range = monitor_args->rgb_range;
+          g_ptr_array_add (logical_monitor->monitors, monitor);
+        }
+    }
+
+  return TRUE;
+}
+
+static gboolean
+find_closest_scale (MonitorMode  *mode,
+                    double        requested_scale,
+                    double       *scale,
+                    GError      **error)
+{
+  gboolean found = FALSE;
+  double best_distance = 0.0;
+  unsigned int i;
+
+  for (i = 0; i < mode->supported_scales->len; i++)
+    {
+      double supported_scale =
+        g_array_index (mode->supported_scales, double, i);
+      double distance = fabs (requested_scale - supported_scale);
+
+      if (distance > 0.1)
+        continue;
+      if (!found || distance < best_distance)
+        {
+          *scale = supported_scale;
+          best_distance = distance;
+          found = TRUE;
+        }
+    }
+
+  if (!found)
+    {
+      g_autofree char *scale_string = format_double (requested_scale);
+
+      g_set_error (error, G_OPTION_ERROR, G_OPTION_ERROR_BAD_VALUE,
+                   "Scale %s not supported by mode", scale_string);
+      return FALSE;
+    }
+
+  return TRUE;
+}
+
+static gboolean
+prepare_logical_monitor (LogicalMonitor  *logical_monitor,
+                         GError         **error)
+{
+  MonitorMode *common_mode = NULL;
+  unsigned int i;
+
+  if (logical_monitor->monitors->len == 0)
+    {
+      g_set_error (error, G_OPTION_ERROR, G_OPTION_ERROR_FAILED,
+                   "Logical monitor empty");
+      return FALSE;
+    }
+
+  for (i = 0; i < logical_monitor->monitors->len; i++)
+    {
+      Monitor *monitor = g_ptr_array_index (logical_monitor->monitors, i);
+      MonitorMode *mode = monitor->configured_mode;
+
+      if (!mode)
+        mode = monitor->preferred_mode;
+      if (!mode)
+        {
+          g_set_error (error, G_OPTION_ERROR, G_OPTION_ERROR_FAILED,
+                       "No preferred mode available for %s",
+                       monitor->connector);
+          return FALSE;
+        }
+      monitor->configured_mode = mode;
+
+      if (!common_mode)
+        {
+          common_mode = mode;
+          if (logical_monitor->scale == 0.0)
+            logical_monitor->scale = mode->preferred_scale;
+          else if (!find_closest_scale (mode,
+                                        logical_monitor->scale,
+                                        &logical_monitor->scale,
+                                        error))
+            return FALSE;
+        }
+      else if (mode->width != common_mode->width ||
+               mode->height != common_mode->height)
+        {
+          g_set_error (error, G_OPTION_ERROR, G_OPTION_ERROR_FAILED,
+                       "Different monitor resolutions within the same "
+                       "logical monitor");
+          return FALSE;
+        }
+    }
+
+  return TRUE;
+}
+
+static void
+get_logical_monitor_size (LogicalMonitor *logical_monitor,
+                          LayoutMode      layout_mode,
+                          int            *width,
+                          int            *height)
+{
+  Monitor *monitor = g_ptr_array_index (logical_monitor->monitors, 0);
+  MonitorMode *mode = monitor->configured_mode;
+
+  *width = mode->width;
+  *height = mode->height;
+  if (logical_monitor->transform == TRANSFORM_90 ||
+      logical_monitor->transform == TRANSFORM_270 ||
+      logical_monitor->transform == TRANSFORM_FLIPPED_90 ||
+      logical_monitor->transform == TRANSFORM_FLIPPED_270)
+    {
+      int tmp = *width;
+
+      *width = *height;
+      *height = tmp;
+    }
+  if (layout_mode == LAYOUT_MODE_LOGICAL)
+    {
+      *width = rint (*width / logical_monitor->scale);
+      *height = rint (*height / logical_monitor->scale);
+    }
+}
+
+static LogicalMonitor *
+lookup_logical_monitor (GHashTable  *monitor_mappings,
+                        const char  *connector,
+                        const char  *option,
+                        GError     **error)
+{
+  LogicalMonitor *logical_monitor =
+    g_hash_table_lookup (monitor_mappings, connector);
+
+  if (!logical_monitor)
+    {
+      g_set_error (error, G_OPTION_ERROR, G_OPTION_ERROR_BAD_VALUE,
+                   "Invalid connector %s passed to %s", connector, option);
+      return NULL;
+    }
+  if (!logical_monitor->position_calculated)
+    {
+      g_set_error (error, G_OPTION_ERROR, G_OPTION_ERROR_FAILED,
+                   "Logical monitor position configured before %s",
+                   connector);
+      return NULL;
+    }
+
+  return logical_monitor;
+}
+
+static gboolean
+calculate_logical_monitor_position (LogicalMonitor  *logical_monitor,
+                                    LayoutMode       layout_mode,
+                                    GHashTable      *monitor_mappings,
+                                    PositionType    *position_types,
+                                    GError         **error)
+{
+  int horizontal_args;
+  int vertical_args;
+  int width;
+  int height;
+
+  horizontal_args = !!logical_monitor->right_of +
+                    !!logical_monitor->left_of +
+                    logical_monitor->has_x;
+  vertical_args = !!logical_monitor->above +
+                  !!logical_monitor->below +
+                  logical_monitor->has_y;
+  if (horizontal_args > 1)
+    {
+      g_set_error (error, G_OPTION_ERROR, G_OPTION_ERROR_FAILED,
+                   "Multiple horizontal placement instructions used");
+      return FALSE;
+    }
+  if (vertical_args > 1)
+    {
+      g_set_error (error, G_OPTION_ERROR, G_OPTION_ERROR_FAILED,
+                   "Multiple vertical placement instructions used");
+      return FALSE;
+    }
+
+  get_logical_monitor_size (logical_monitor, layout_mode, &width, &height);
+  if (logical_monitor->has_x)
+    {
+      if (vertical_args == 0)
+        logical_monitor->y = 0;
+      *position_types |= POSITION_ABSOLUTE_X;
+    }
+  else if (logical_monitor->right_of)
+    {
+      LogicalMonitor *other =
+        lookup_logical_monitor (monitor_mappings,
+                                logical_monitor->right_of,
+                                "--right-of",
+                                error);
+      int other_width;
+      int other_height;
+
+      if (!other)
+        return FALSE;
+      get_logical_monitor_size (other,
+                                layout_mode,
+                                &other_width,
+                                &other_height);
+      logical_monitor->x = other->x + other_width;
+      if (vertical_args == 0)
+        logical_monitor->y = other->y;
+      *position_types |= POSITION_RELATIVE_X;
+    }
+  else if (logical_monitor->left_of)
+    {
+      LogicalMonitor *other =
+        lookup_logical_monitor (monitor_mappings,
+                                logical_monitor->left_of,
+                                "--left-of",
+                                error);
+
+      if (!other)
+        return FALSE;
+      logical_monitor->x = other->x - width;
+      if (vertical_args == 0)
+        logical_monitor->y = other->y;
+      *position_types |= POSITION_RELATIVE_X;
+    }
+  else
+    {
+      logical_monitor->x = 0;
+    }
+
+  if (logical_monitor->has_y)
+    {
+      if (horizontal_args == 0)
+        logical_monitor->x = 0;
+      *position_types |= POSITION_ABSOLUTE_Y;
+    }
+  else if (logical_monitor->below)
+    {
+      LogicalMonitor *other =
+        lookup_logical_monitor (monitor_mappings,
+                                logical_monitor->below,
+                                "--below",
+                                error);
+      int other_width;
+      int other_height;
+
+      if (!other)
+        return FALSE;
+      get_logical_monitor_size (other,
+                                layout_mode,
+                                &other_width,
+                                &other_height);
+      logical_monitor->y = other->y + other_height;
+      if (horizontal_args == 0)
+        logical_monitor->x = other->x;
+      *position_types |= POSITION_RELATIVE_Y;
+    }
+  else if (logical_monitor->above)
+    {
+      LogicalMonitor *other =
+        lookup_logical_monitor (monitor_mappings,
+                                logical_monitor->above,
+                                "--above",
+                                error);
+
+      if (!other)
+        return FALSE;
+      logical_monitor->y = other->y - height;
+      if (horizontal_args == 0)
+        logical_monitor->x = other->x;
+      *position_types |= POSITION_RELATIVE_Y;
+    }
+  else if (vertical_args == 0)
+    {
+      logical_monitor->y = 0;
+    }
+
+  logical_monitor->position_calculated = TRUE;
+  return TRUE;
+}
+
+static gboolean
+calculate_positions (GPtrArray   *logical_monitors,
+                     LayoutMode   layout_mode,
+                     GHashTable  *monitor_mappings,
+                     GError     **error)
+{
+  PositionType position_types = POSITION_NONE;
+  unsigned int i;
+
+  for (i = 0; i < logical_monitors->len; i++)
+    {
+      LogicalMonitor *logical_monitor =
+        g_ptr_array_index (logical_monitors, i);
+
+      if (!calculate_logical_monitor_position (logical_monitor,
+                                               layout_mode,
+                                               monitor_mappings,
+                                               &position_types,
+                                               error))
+        return FALSE;
+    }
+
+  if (!(position_types & POSITION_ABSOLUTE_X) && logical_monitors->len > 0)
+    {
+      int min_x = G_MAXINT;
+
+      for (i = 0; i < logical_monitors->len; i++)
+        {
+          LogicalMonitor *logical_monitor =
+            g_ptr_array_index (logical_monitors, i);
+
+          min_x = MIN (min_x, logical_monitor->x);
+        }
+      for (i = 0; i < logical_monitors->len; i++)
+        {
+          LogicalMonitor *logical_monitor =
+            g_ptr_array_index (logical_monitors, i);
+
+          logical_monitor->x -= min_x;
+        }
+    }
+
+  if (!(position_types & POSITION_ABSOLUTE_Y) && logical_monitors->len > 0)
+    {
+      int min_y = G_MAXINT;
+
+      for (i = 0; i < logical_monitors->len; i++)
+        {
+          LogicalMonitor *logical_monitor =
+            g_ptr_array_index (logical_monitors, i);
+
+          min_y = MIN (min_y, logical_monitor->y);
+        }
+      for (i = 0; i < logical_monitors->len; i++)
+        {
+          LogicalMonitor *logical_monitor =
+            g_ptr_array_index (logical_monitors, i);
+
+          logical_monitor->y -= min_y;
+        }
+    }
+
+  return TRUE;
+}
+
+static Config *
+create_config (MonitorsState  *state,
+               SetArguments  *args,
+               GError       **error)
+{
+  g_autoptr (GHashTable) monitor_mappings =
+    g_hash_table_new (g_str_hash, g_str_equal);
+  Config *config;
+  unsigned int i;
+
+  config = g_new0 (Config, 1);
+  config->state = state;
+  config->layout_mode = args->has_layout_mode ?
+    args->layout_mode : state->layout_mode;
+  if (args->has_layout_mode && !state->supports_changing_layout_mode)
+    {
+      g_set_error (error, G_OPTION_ERROR, G_OPTION_ERROR_FAILED,
+                   "Configuring layout mode not supported by the server");
+      goto fail;
+    }
+
+  config->logical_monitors = g_steal_pointer (&args->logical_monitors);
+  config->monitors_for_lease =
+    g_steal_pointer (&args->monitors_for_lease);
+  if (config->logical_monitors->len == 0)
+    {
+      g_set_error_literal (error,
+                           G_OPTION_ERROR,
+                           G_OPTION_ERROR_FAILED,
+                           "No logical monitors configured");
+      goto fail;
+    }
+
+  for (i = 0; i < config->logical_monitors->len; i++)
+    {
+      LogicalMonitor *logical_monitor =
+        g_ptr_array_index (config->logical_monitors, i);
+      unsigned int j;
+
+      if (!prepare_logical_monitor (logical_monitor, error))
+        goto fail;
+      for (j = 0; j < logical_monitor->monitors->len; j++)
+        {
+          Monitor *monitor = g_ptr_array_index (logical_monitor->monitors, j);
+
+          g_hash_table_insert (monitor_mappings,
+                               monitor->connector,
+                               logical_monitor);
+        }
+    }
+
+  if (!calculate_positions (config->logical_monitors,
+                            config->layout_mode,
+                            monitor_mappings,
+                            error))
+    goto fail;
+
+  return config;
+
+fail:
+  config_free (config);
+  return NULL;
+}
+
+static gboolean
+get_config_method (SetArguments  *args,
+                   ConfigMethod  *method,
+                   GError       **error)
+{
+  if (args->persistent && args->verify)
+    {
+      g_set_error (error, G_OPTION_ERROR, G_OPTION_ERROR_FAILED,
+                   "Configuration can't be both persistent and verify-only");
+      return FALSE;
+    }
+  if (args->persistent)
+    *method = CONFIG_METHOD_PERSISTENT;
+  else if (args->verify)
+    *method = CONFIG_METHOD_VERIFY;
+  else
+    *method = CONFIG_METHOD_TEMPORARY;
+
+  return TRUE;
+}
+
+static void
+print_config (Config *config)
+{
+  g_autoptr (GArray) levels = g_array_new (FALSE, FALSE, sizeof (int));
+  g_autofree char *layout_mode =
+    g_strdup_printf ("Layout mode: %s",
+                     layout_mode_to_string (config->layout_mode));
+  g_autofree char *logical_monitors =
+    g_strdup_printf ("Logical monitors (%u)",
+                     config->logical_monitors->len);
+  g_autofree char *monitors_for_lease =
+    g_strdup_printf ("Monitors for lease (%u)",
+                     config->monitors_for_lease->len);
+  unsigned int i;
+
+  g_print ("Configuration:\n");
+  print_data (0, FALSE, levels, layout_mode);
+  print_data (0, FALSE, levels, logical_monitors);
+  for (i = 0; i < config->logical_monitors->len; i++)
+    {
+      LogicalMonitor *logical_monitor =
+        g_ptr_array_index (config->logical_monitors, i);
+      g_autofree char *title =
+        g_strdup_printf ("Logical monitor #%u", i + 1);
+      g_autofree char *position =
+        g_strdup_printf ("Position: (%d, %d)",
+                         logical_monitor->x,
+                         logical_monitor->y);
+      g_autofree char *scale_value = format_double (logical_monitor->scale);
+      g_autofree char *scale = g_strdup_printf ("Scale: %s", scale_value);
+      g_autofree char *transform =
+        g_strdup_printf ("Transform: %s",
+                         transform_names[logical_monitor->transform]);
+      g_autofree char *primary =
+        g_strdup_printf ("Primary: %s",
+                         logical_monitor->is_primary ? "yes" : "no");
+      g_autofree char *monitors =
+        g_strdup_printf ("Monitors: (%u)", logical_monitor->monitors->len);
+      unsigned int j;
+
+      print_data (1, i == config->logical_monitors->len - 1, levels, title);
+      print_data (2, FALSE, levels, position);
+      print_data (2, FALSE, levels, scale);
+      print_data (2, FALSE, levels, transform);
+      print_data (2, FALSE, levels, primary);
+      print_data (2, TRUE, levels, monitors);
+      for (j = 0; j < logical_monitor->monitors->len; j++)
+        {
+          Monitor *monitor = g_ptr_array_index (logical_monitor->monitors, j);
+          gboolean has_color_mode = monitor->color_mode >= 0;
+          gboolean has_rgb_range = monitor->rgb_range >= 0;
+          g_autofree char *monitor_title = format_monitor_title (monitor, TRUE);
+          g_autofree char *mode =
+            g_strdup_printf ("Mode: %s", monitor->configured_mode->id);
+
+          print_data (3,
+                      j == logical_monitor->monitors->len - 1,
+                      levels,
+                      monitor_title);
+          print_data (4,
+                      !has_color_mode && !has_rgb_range,
+                      levels,
+                      mode);
+          if (has_color_mode)
+            {
+              g_autofree char *line =
+                g_strdup_printf ("Color mode: %s",
+                                 color_mode_names[monitor->color_mode]);
+              print_data (4, !has_rgb_range, levels, line);
+            }
+          if (has_rgb_range)
+            {
+              g_autofree char *line =
+                g_strdup_printf ("RGB mode: %s",
+                                 rgb_range_names[monitor->rgb_range]);
+              print_data (4, TRUE, levels, line);
+            }
+        }
+    }
+
+  print_data (0, TRUE, levels, monitors_for_lease);
+  for (i = 0; i < config->monitors_for_lease->len; i++)
+    {
+      Monitor *monitor = g_ptr_array_index (config->monitors_for_lease, i);
+      g_autofree char *title = format_monitor_title (monitor, TRUE);
+
+      print_data (1,
+                  i == config->monitors_for_lease->len - 1,
+                  levels,
+                  title);
+    }
+}
+
+static GVariant *
+create_apply_parameters (Config       *config,
+                         ConfigMethod  method)
+{
+  GVariantBuilder logical_monitors;
+  GVariantBuilder properties;
+  unsigned int i;
+
+  g_variant_builder_init (&logical_monitors,
+                          G_VARIANT_TYPE ("a(iiduba(ssa{sv}))"));
+  for (i = 0; i < config->logical_monitors->len; i++)
+    {
+      LogicalMonitor *logical_monitor =
+        g_ptr_array_index (config->logical_monitors, i);
+      GVariantBuilder monitors;
+      unsigned int j;
+
+      g_variant_builder_init (&monitors, G_VARIANT_TYPE ("a(ssa{sv})"));
+      for (j = 0; j < logical_monitor->monitors->len; j++)
+        {
+          Monitor *monitor = g_ptr_array_index (logical_monitor->monitors, j);
+          GVariantBuilder monitor_properties;
+
+          g_variant_builder_init (&monitor_properties,
+                                  G_VARIANT_TYPE_VARDICT);
+          if (monitor->color_mode >= 0)
+            g_variant_builder_add (&monitor_properties,
+                                   "{sv}",
+                                   "color-mode",
+                                   g_variant_new_uint32 (monitor->color_mode));
+          if (monitor->rgb_range >= 0)
+            g_variant_builder_add (&monitor_properties,
+                                   "{sv}",
+                                   "rgb-range",
+                                   g_variant_new_uint32 (monitor->rgb_range));
+          g_variant_builder_add (&monitors,
+                                 "(ss@a{sv})",
+                                 monitor->connector,
+                                 monitor->configured_mode->id,
+                                 g_variant_builder_end (&monitor_properties));
+        }
+      g_variant_builder_add (&logical_monitors,
+                             "(iidub@a(ssa{sv}))",
+                             logical_monitor->x,
+                             logical_monitor->y,
+                             logical_monitor->scale,
+                             logical_monitor->transform,
+                             logical_monitor->is_primary,
+                             g_variant_builder_end (&monitors));
+    }
+
+  g_variant_builder_init (&properties, G_VARIANT_TYPE_VARDICT);
+  if (config->state->supports_changing_layout_mode)
+    g_variant_builder_add (&properties,
+                           "{sv}",
+                           "layout-mode",
+                           g_variant_new_uint32 (config->layout_mode));
+  if (config->monitors_for_lease->len > 0)
+    {
+      GVariantBuilder monitors_for_lease;
+
+      g_variant_builder_init (&monitors_for_lease,
+                              G_VARIANT_TYPE ("a(ssss)"));
+      for (i = 0; i < config->monitors_for_lease->len; i++)
+        {
+          Monitor *monitor = g_ptr_array_index (config->monitors_for_lease, i);
+
+          g_variant_builder_add (&monitors_for_lease,
+                                 "(ssss)",
+                                 monitor->connector,
+                                 monitor->vendor,
+                                 monitor->product,
+                                 monitor->serial);
+        }
+      g_variant_builder_add (&properties,
+                             "{sv}",
+                             "monitors-for-lease",
+                             g_variant_builder_end (&monitors_for_lease));
+    }
+
+  return g_variant_new ("(uu@a(iiduba(ssa{sv}))@a{sv})",
+                        config->state->serial,
+                        method,
+                        g_variant_builder_end (&logical_monitors),
+                        g_variant_builder_end (&properties));
+}
+
+static gboolean
+apply_config (Config        *config,
+              ConfigMethod   method,
+              GError       **error)
+{
+  g_autoptr (GVariant) parameters = NULL;
+  g_autoptr (GVariant) result = NULL;
+
+  parameters = g_variant_ref_sink (create_apply_parameters (config, method));
+  result = g_dbus_proxy_call_sync (config->state->proxy,
+                                   "ApplyMonitorsConfig",
+                                   parameters,
+                                   G_DBUS_CALL_FLAGS_NO_AUTO_START,
+                                   -1,
+                                   NULL,
+                                   error);
+
+  return result != NULL;
+}
+
+static gboolean
+set_backlight (MonitorsState  *state,
+               Monitor        *monitor,
+               int             value,
+               GError        **error)
+{
+  g_autoptr (GVariant) backlight = NULL;
+  g_autoptr (GVariant) result = NULL;
+  unsigned int serial = 0;
+
+  backlight = find_backlight (state, monitor, &serial);
+
+  result = g_dbus_proxy_call_sync (state->proxy,
+                                   "SetBacklight",
+                                   g_variant_new ("(usi)",
+                                                  serial,
+                                                  monitor->connector,
+                                                  value),
+                                   G_DBUS_CALL_FLAGS_NO_AUTO_START,
+                                   -1,
+                                   NULL,
+                                   error);
+  return result != NULL;
+}
+
+static gboolean
+parse_prefs_option (const char  *option_name,
+                    const char  *value,
+                    gpointer     user_data,
+                    GError     **error)
+{
+  PrefsParseData *data = user_data;
+
+  if (option_name_is (option_name, "--monitor", 'M'))
+    {
+      data->monitor = g_new0 (MonitorPrefs, 1);
+      data->monitor->connector = g_strdup (value);
+      g_ptr_array_add (data->args->monitors, data->monitor);
+    }
+  else if (option_name_is (option_name, "--backlight", 'b'))
+    {
+      if (!data->monitor)
+        {
+          g_set_error (error, G_OPTION_ERROR, G_OPTION_ERROR_FAILED,
+                       "No current monitor for %s", option_name);
+          return FALSE;
+        }
+      if (!parse_double (value, &data->monitor->backlight, error))
+        return FALSE;
+      data->monitor->has_backlight = TRUE;
+    }
+  else
+    {
+      g_assert_not_reached ();
+    }
+
+  return TRUE;
+}
+
+static gboolean
+parse_prefs_arguments (int             argc,
+                       char          **argv,
+                       PrefsArguments *args,
+                       GError        **error)
+{
+  g_autoptr (GOptionContext) context = NULL;
+  GOptionGroup *group;
+  PrefsParseData data = {
+    .args = args,
+  };
+
+  args->monitors =
+    g_ptr_array_new_with_free_func ((GDestroyNotify) monitor_prefs_free);
+
+  context = g_option_context_new (NULL);
+  g_option_context_set_summary (context, "Set display preferences");
+  group = g_option_group_new ("prefs",
+                              "Preference options",
+                              "Show preference options",
+                              &data,
+                              NULL);
+  g_option_group_add_entries (group, prefs_options);
+  g_option_context_set_main_group (context, group);
+
+  if (!g_option_context_parse (context, &argc, &argv, error))
+    return FALSE;
+
+  if (argc > 1)
+    {
+      g_set_error (error, G_OPTION_ERROR, G_OPTION_ERROR_UNKNOWN_OPTION,
+                   "Unknown argument %s", argv[1]);
+      return FALSE;
+    }
+
+  return TRUE;
+}
+
+static gboolean
+apply_prefs (MonitorsState  *state,
+             PrefsArguments *args,
+             GError        **error)
+{
+  unsigned int i;
+
+  for (i = 0; i < args->monitors->len; i++)
+    {
+      MonitorPrefs *monitor_prefs = g_ptr_array_index (args->monitors, i);
+      Monitor *monitor =
+        g_hash_table_lookup (state->monitors_by_connector,
+                             monitor_prefs->connector);
+
+      if (!monitor)
+        {
+          g_set_error (error, G_OPTION_ERROR, G_OPTION_ERROR_BAD_VALUE,
+                       "Monitor with connector %s not found",
+                       monitor_prefs->connector);
+          return FALSE;
+        }
+      if (monitor_prefs->has_backlight &&
+          !set_backlight (state,
+                          monitor,
+                          round (monitor_prefs->backlight),
+                          error))
+        return FALSE;
+    }
+
+  return TRUE;
+}
