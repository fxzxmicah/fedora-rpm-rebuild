+static gboolean
+config_file_is_writable (const char *file_path)
+{
+  g_autofree char *parent_path = NULL;
+
+  if (g_file_test (file_path, G_FILE_TEST_EXISTS))
+    return g_access (file_path, W_OK) == 0;
+
+  parent_path = g_path_get_dirname (file_path);
+  return g_access (parent_path, W_OK) == 0;
+}
+
+GFile *
+meta_monitor_config_store_get_writable_system_file (
+  const char * const *system_dirs)
+{
+  const char *system_dir = NULL;
+  g_autofree char *system_file_path = NULL;
+
+  /*
+   * System configuration files are loaded in order, with later files taking
+   * precedence. Only the last directory can therefore be a write target.
+   */
+  for (; system_dirs && *system_dirs; system_dirs++)
+    system_dir = *system_dirs;
+
+  if (!system_dir)
+    return NULL;
+
+  system_file_path = g_build_filename (system_dir, "monitors.xml", NULL);
+  if (config_file_is_writable (system_file_path))
+    return g_file_new_for_path (system_file_path);
+
+  return NULL;
+}
+
+GFile *
+meta_monitor_config_store_select_write_file (GFile            *user_file,
+                                             GFile            *system_file,
+                                             gboolean          has_stores_policy,
+                                             GList            *stores_policy,
+                                             MetaConfigStore  *store)
+{
+  GList *l;
+
+  if (has_stores_policy)
+    {
+      for (l = stores_policy; l; l = l->next)
+        {
+          MetaConfigStore candidate_store = GPOINTER_TO_INT (l->data);
+
+          switch (candidate_store)
+            {
+            case META_CONFIG_STORE_SYSTEM:
+              if (system_file)
+                {
+                  *store = META_CONFIG_STORE_SYSTEM;
+                  return g_object_ref (system_file);
+                }
+              break;
+            case META_CONFIG_STORE_USER:
+              *store = META_CONFIG_STORE_USER;
+              return g_object_ref (user_file);
+            }
+        }
+
+      return NULL;
+    }
+
+  if (!g_file_query_exists (user_file, NULL) && system_file)
+    {
+      *store = META_CONFIG_STORE_SYSTEM;
+      return g_object_ref (system_file);
+    }
+
+  *store = META_CONFIG_STORE_USER;
+  return g_object_ref (user_file);
+}
