+static MonitorMode *
+monitor_mode_new_from_variant (GVariant *variant)
+{
+  g_autoptr (GVariant) scales_variant = NULL;
+  g_autoptr (GVariant) properties = NULL;
+  const char *id;
+  GVariantIter iter;
+  double scale;
+  MonitorMode *mode;
+
+  mode = g_new0 (MonitorMode, 1);
+  g_variant_get (variant, "(&siidd@ad@a{sv})",
+                 &id,
+                 &mode->width,
+                 &mode->height,
+                 &mode->refresh_rate,
+                 &mode->preferred_scale,
+                 &scales_variant,
+                 &properties);
+  mode->id = g_strdup (id);
+  mode->supported_scales = g_array_new (FALSE, FALSE, sizeof (double));
+  g_variant_iter_init (&iter, scales_variant);
+  while (g_variant_iter_next (&iter, "d", &scale))
+    g_array_append_val (mode->supported_scales, scale);
+  mode->properties = g_steal_pointer (&properties);
+  {
+    gboolean unused;
+
+    mode->is_current =
+      g_variant_lookup (mode->properties, "is-current", "b", &unused);
+    mode->is_preferred =
+      g_variant_lookup (mode->properties, "is-preferred", "b", &unused);
+  }
+
+  return mode;
+}
+
+static Monitor *
+monitor_new_from_variant (GVariant *variant)
+{
+  g_autoptr (GVariant) spec = NULL;
+  g_autoptr (GVariant) modes = NULL;
+  g_autoptr (GVariant) properties = NULL;
+  const char *connector;
+  const char *vendor;
+  const char *product;
+  const char *serial;
+  const char *display_name = NULL;
+  GVariantIter iter;
+  GVariant *mode_variant;
+  Monitor *monitor;
+
+  monitor = g_new0 (Monitor, 1);
+  monitor->color_mode = -1;
+  monitor->rgb_range = -1;
+  spec = g_variant_get_child_value (variant, 0);
+  modes = g_variant_get_child_value (variant, 1);
+  properties = g_variant_get_child_value (variant, 2);
+  g_variant_get (spec, "(&s&s&s&s)",
+                 &connector, &vendor, &product, &serial);
+  monitor->connector = g_strdup (connector);
+  monitor->vendor = g_strdup (vendor);
+  monitor->product = g_strdup (product);
+  monitor->serial = g_strdup (serial);
+  if (g_variant_lookup (properties, "display-name", "&s", &display_name))
+    monitor->display_name = g_strdup (display_name);
+  monitor->properties = g_steal_pointer (&properties);
+  monitor->modes =
+    g_ptr_array_new_with_free_func ((GDestroyNotify) monitor_mode_free);
+
+  g_variant_iter_init (&iter, modes);
+  while ((mode_variant = g_variant_iter_next_value (&iter)))
+    {
+      MonitorMode *mode = monitor_mode_new_from_variant (mode_variant);
+
+      g_ptr_array_add (monitor->modes, mode);
+      if (mode->is_current)
+        monitor->current_mode = mode;
+      if (mode->is_preferred)
+        monitor->preferred_mode = mode;
+      g_variant_unref (mode_variant);
+    }
+
+  return monitor;
+}
