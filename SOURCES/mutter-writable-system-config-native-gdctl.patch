+
+static void
+print_option_entry (const GOptionEntry *entry)
+{
+  if (entry->short_name)
+    g_print ("-%c\n", entry->short_name);
+  g_print ("--%s\n", entry->long_name);
+}
+
+static void
+print_option_entries (const GOptionEntry *entries)
+{
+  const GOptionEntry *entry;
+
+  for (entry = entries; entry->long_name; entry++)
+    print_option_entry (entry);
+}
+
+static const GOptionEntry *
+find_option_in_entries (const GOptionEntry *entries,
+                        const char         *long_name)
+{
+  const GOptionEntry *entry;
+
+  for (entry = entries; entry->long_name; entry++)
+    {
+      if (g_str_equal (entry->long_name, long_name))
+        return entry;
+    }
+
+  return NULL;
+}
+
+static const GOptionEntry *
+find_option_entry (const char *command,
+                   const char *option_name)
+{
+  const GOptionEntry *option_sets[3];
+  size_t n_option_sets;
+  size_t i;
+
+  if (g_str_equal (command, "show"))
+    {
+      option_sets[0] = show_options;
+      n_option_sets = 1;
+    }
+  else if (g_str_equal (command, "set"))
+    {
+      option_sets[0] = set_global_options;
+      option_sets[1] = set_logical_monitor_options;
+      option_sets[2] = set_monitor_options;
+      n_option_sets = 3;
+    }
+  else if (g_str_equal (command, "prefs"))
+    {
+      option_sets[0] = prefs_options;
+      n_option_sets = 1;
+    }
+  else
+    {
+      return NULL;
+    }
+
+  for (i = 0; i < n_option_sets; i++)
+    {
+      const GOptionEntry *entry;
+
+      for (entry = option_sets[i]; entry->long_name; entry++)
+        {
+          if ((g_str_has_prefix (option_name, "--") &&
+               g_str_equal (option_name + 2, entry->long_name)) ||
+              (entry->short_name &&
+               option_name[0] == '-' &&
+               option_name[1] == entry->short_name &&
+               option_name[2] == '\0'))
+            return entry;
+        }
+    }
+
+  return NULL;
+}
+
+static int
+complete_option_names (int    argc,
+                       char **argv)
+{
+  const char *command = argc > 0 ? argv[0] : "";
+  const char *scope = argc > 1 ? argv[1] : "global";
+
+  if (*command)
+    g_print ("-h\n--help\n");
+
+  if (g_str_equal (command, "show"))
+    print_option_entries (show_options);
+  else if (g_str_equal (command, "prefs"))
+    {
+      print_option_entry (find_option_in_entries (prefs_options, "monitor"));
+      if (g_str_equal (scope, "monitor"))
+        print_option_entry (find_option_in_entries (prefs_options,
+                                                    "backlight"));
+    }
+  else if (g_str_equal (command, "set"))
+    {
+      if (g_str_equal (scope, "global"))
+        print_option_entries (set_global_options);
+      else
+        {
+          print_option_entry (find_option_in_entries (set_global_options,
+                                                      "logical-monitor"));
+          print_option_entry (find_option_in_entries (set_global_options,
+                                                      "for-lease-monitor"));
+          print_option_entries (set_logical_monitor_options);
+          if (g_str_equal (scope, "monitor"))
+            print_option_entries (set_monitor_options);
+        }
+    }
+  else
+    {
+      const char *commands[] = { "show", "set", "prefs" };
+
+      print_completion_values (commands, G_N_ELEMENTS (commands));
+    }
+
+  return EXIT_SUCCESS;
+}
+
+static int run_completion (int    argc,
+                           char **argv);
+
+static int
+complete_option_value (int    argc,
+                       char **argv)
+{
+  const GOptionEntry *entry;
+  const char *completion;
+  char *completion_argv[3];
+  int completion_argc;
+
+  if (argc < 2)
+    return EXIT_FAILURE;
+
+  entry = find_option_entry (argv[0], argv[1]);
+  if (!entry || !entry->arg_description)
+    return EXIT_FAILURE;
+
+  if (g_str_equal (entry->long_name, "monitor") ||
+      g_str_equal (entry->long_name, "for-lease-monitor") ||
+      g_str_equal (entry->long_name, "right-of") ||
+      g_str_equal (entry->long_name, "left-of") ||
+      g_str_equal (entry->long_name, "above") ||
+      g_str_equal (entry->long_name, "below"))
+    completion = "monitors";
+  else if (g_str_equal (entry->long_name, "layout-mode"))
+    completion = "layout-modes";
+  else if (g_str_equal (entry->long_name, "mode"))
+    completion = "modes";
+  else if (g_str_equal (entry->long_name, "scale"))
+    completion = "scales";
+  else if (g_str_equal (entry->long_name, "transform"))
+    completion = "transforms";
+  else if (g_str_equal (entry->long_name, "color-mode"))
+    completion = "color-modes";
+  else if (g_str_equal (entry->long_name, "rgb-range"))
+    completion = "rgb-ranges";
+  else
+    return EXIT_SUCCESS;
+
+  completion_argv[0] = (char *) completion;
+  completion_argc = 1;
+  if ((g_str_equal (completion, "modes") ||
+       g_str_equal (completion, "scales")) && argc > 2)
+    completion_argv[completion_argc++] = argv[2];
+  if (g_str_equal (completion, "scales") && argc > 3 && argv[3][0])
+    completion_argv[completion_argc++] = argv[3];
+
+  return run_completion (completion_argc, completion_argv);
+}
+
+typedef struct
+{
+  double value;
+  unsigned int order;
+} CompletionScale;
+
+static int
+compare_completion_scales (gconstpointer a,
+                           gconstpointer b,
+                           gpointer      user_data)
+{
+  const CompletionScale *scale_a = a;
+  const CompletionScale *scale_b = b;
+  double preferred_scale = *(double *) user_data;
+  double distance_a = fabs (scale_a->value - preferred_scale);
+  double distance_b = fabs (scale_b->value - preferred_scale);
+
+  if (distance_a < distance_b)
+    return -1;
+  if (distance_a > distance_b)
+    return 1;
+
+  return (scale_a->order > scale_b->order) -
+         (scale_a->order < scale_b->order);
+}
+
+static int
+run_completion (int    argc,
+                char **argv)
+{
+  g_autoptr (MonitorsState) state = NULL;
+  g_autoptr (GError) error = NULL;
+
+  if (argc < 1)
+    return EXIT_SUCCESS;
+
+  if (g_str_equal (argv[0], "options"))
+    return complete_option_names (argc - 1, argv + 1);
+  if (g_str_equal (argv[0], "value"))
+    return complete_option_value (argc - 1, argv + 1);
+
+  if (g_str_equal (argv[0], "layout-modes"))
+    {
+      const char *values[] = { "logical", "physical" };
+
+      print_completion_values (values, G_N_ELEMENTS (values));
+      return EXIT_SUCCESS;
+    }
+  if (g_str_equal (argv[0], "transforms"))
+    {
+      print_completion_values (transform_names,
+                               G_N_ELEMENTS (transform_names));
+      return EXIT_SUCCESS;
+    }
+  if (g_str_equal (argv[0], "color-modes"))
+    {
+      print_completion_values (color_mode_names,
+                               G_N_ELEMENTS (color_mode_names));
+      return EXIT_SUCCESS;
+    }
+  if (g_str_equal (argv[0], "rgb-ranges"))
+    {
+      print_completion_values (rgb_range_names,
+                               G_N_ELEMENTS (rgb_range_names));
+      return EXIT_SUCCESS;
+    }
+
+  state = monitors_state_new (&error);
+  if (!state)
+    return EXIT_SUCCESS;
+
+  if (g_str_equal (argv[0], "monitors"))
+    {
+      unsigned int i;
+
+      for (i = 0; i < state->monitors->len; i++)
+        {
+          Monitor *monitor = g_ptr_array_index (state->monitors, i);
+
+          g_print ("%s\n", monitor->connector);
+        }
+    }
+  else if (g_str_equal (argv[0], "modes") && argc >= 2)
+    {
+      Monitor *monitor =
+        g_hash_table_lookup (state->monitors_by_connector, argv[1]);
+      unsigned int i;
+
+      if (!monitor)
+        return EXIT_SUCCESS;
+      for (i = 0; i < monitor->modes->len; i++)
+        {
+          MonitorMode *mode = g_ptr_array_index (monitor->modes, i);
+
+          g_print ("%s\n", mode->id);
+        }
+    }
+  else if (g_str_equal (argv[0], "scales") && argc >= 2)
+    {
+      Monitor *monitor =
+        g_hash_table_lookup (state->monitors_by_connector, argv[1]);
+      MonitorMode *mode;
+      g_autoptr (GArray) sorted_scales = NULL;
+      unsigned int i;
+
+      if (!monitor)
+        return EXIT_SUCCESS;
+      if (argc >= 3)
+        mode = find_monitor_mode (monitor, argv[2]);
+      else
+        mode = monitor->preferred_mode;
+      if (!mode)
+        return EXIT_SUCCESS;
+
+      sorted_scales = g_array_sized_new (FALSE,
+                                         FALSE,
+                                         sizeof (CompletionScale),
+                                         mode->supported_scales->len);
+      for (i = 0; i < mode->supported_scales->len; i++)
+        {
+          CompletionScale completion_scale = {
+            .value = g_array_index (mode->supported_scales, double, i),
+            .order = i,
+          };
+
+          g_array_append_val (sorted_scales, completion_scale);
+        }
+      g_array_sort_with_data (sorted_scales,
+                              compare_completion_scales,
+                              &mode->preferred_scale);
+      for (i = 0; i < sorted_scales->len; i++)
+        {
+          CompletionScale *completion_scale =
+            &g_array_index (sorted_scales, CompletionScale, i);
+          g_autofree char *scale_string =
+            format_double (completion_scale->value);
+
+          g_print ("%s\n", scale_string);
+        }
+    }
+
+  return EXIT_SUCCESS;
+}
+
+static void
+strip_remote_error (GError *error)
+{
+  if (error && g_dbus_error_is_remote_error (error))
+    g_dbus_error_strip_remote_error (error);
+}
+
+static void
+print_main_help (void)
+{
+  g_print ("Usage: gdctl COMMAND [OPTIONS]\n\n"
+           "Display control utility\n\n"
+           "Commands:\n"
+           "  show    Show display configuration\n"
+           "  set     Set display configuration\n"
+           "  prefs   Set display preferences\n");
+}
+
+static int
+report_argument_error (const char *command,
+                       GError     *error)
+{
+  g_printerr ("gdctl%s%s: error: %s\n",
+              command ? " " : "",
+              command ? command : "",
+              error->message);
+  return 2;
+}
+
+int
+main (int    argc,
+      char **argv)
+{
+  g_autoptr (MonitorsState) state = NULL;
+  g_autoptr (GError) error = NULL;
+  g_auto (SetArguments) set_args = {0};
+  g_auto (PrefsArguments) prefs_args = {0};
+  g_autoptr (Config) config = NULL;
+  const char *command = NULL;
+  gboolean show_modes = FALSE;
+  gboolean show_properties = FALSE;
+  ConfigMethod method;
+
+  if (!setlocale (LC_ALL, ""))
+    g_warning ("Locale not understood by C library");
+
+  if (argc < 2)
+    {
+      g_set_error_literal (&error,
+                           G_OPTION_ERROR,
+                           G_OPTION_ERROR_BAD_VALUE,
+                           "the following argument is required: COMMAND");
+      return report_argument_error (NULL, error);
+    }
+
+  command = argv[1];
+  if (g_str_equal (command, "-h") || g_str_equal (command, "--help"))
+    {
+      print_main_help ();
+      return EXIT_SUCCESS;
+    }
+  if (g_str_equal (command, "complete"))
+    return run_completion (argc - 2, argv + 2);
+
+  if (!g_str_equal (command, "show") &&
+      !g_str_equal (command, "set") &&
+      !g_str_equal (command, "prefs"))
+    {
+      g_set_error (&error,
+                   G_OPTION_ERROR,
+                   G_OPTION_ERROR_BAD_VALUE,
+                   "argument COMMAND: invalid choice: '%s'",
+                   command);
+      return report_argument_error (NULL, error);
+    }
+
+  {
+    g_autofree char *program_name = g_strdup_printf ("gdctl %s", command);
+
+    g_set_prgname (program_name);
+
+    if (g_str_equal (command, "show"))
+      {
+        if (!parse_show_arguments (argc - 1,
+                                   argv + 1,
+                                   &show_modes,
+                                   &show_properties,
+                                   &error))
+          return report_argument_error (command, error);
+      }
+    else if (g_str_equal (command, "set"))
+      {
+        if (!parse_set_arguments (argc - 1,
+                                  argv + 1,
+                                  &set_args,
+                                  &error))
+          return report_argument_error (command, error);
+      }
+    else
+      {
+        if (!parse_prefs_arguments (argc - 1,
+                                    argv + 1,
+                                    &prefs_args,
+                                    &error))
+          return report_argument_error (command, error);
+      }
+  }
+
+  state = monitors_state_new (&error);
+  if (!state)
+    {
+      strip_remote_error (error);
+      g_printerr ("Failed to retrieve current state: %s\n", error->message);
+      return EXIT_FAILURE;
+    }
+
+  if (g_str_equal (command, "show"))
+    {
+      print_current_state (state, show_modes, show_properties);
+      return EXIT_SUCCESS;
+    }
+  else if (g_str_equal (command, "set"))
+    {
+      if (!resolve_set_arguments (state, &set_args, &error))
+        goto create_config_error;
+      config = create_config (state, &set_args, &error);
+      if (!config)
+        goto create_config_error;
+      if (!get_config_method (&set_args, &method, &error))
+        goto create_config_error;
+      if (set_args.verbose)
+        print_config (config);
+      if (!apply_config (config, method, &error))
+        {
+          strip_remote_error (error);
+          g_printerr ("Failed to apply configuration: %s\n", error->message);
+          return EXIT_FAILURE;
+        }
+      return EXIT_SUCCESS;
+
+create_config_error:
+      g_printerr ("Failed to create configuration: %s\n", error->message);
+      return EXIT_FAILURE;
+    }
+  else
+    {
+      if (!apply_prefs (state, &prefs_args, &error))
+        {
+          strip_remote_error (error);
+          g_printerr ("Failed to set preferences: %s\n", error->message);
+          return EXIT_FAILURE;
+        }
+      return EXIT_SUCCESS;
+    }
+}
