+    case LAYOUT_MODE_PHYSICAL:
+      return "physical";
+    }
+
+  g_assert_not_reached ();
+}
+
+static gboolean
+parse_layout_mode (const char  *value,
+                   LayoutMode  *layout_mode,
+                   GError     **error)
+{
+  if (g_str_equal (value, "logical"))
+    *layout_mode = LAYOUT_MODE_LOGICAL;
+  else if (g_str_equal (value, "physical"))
+    *layout_mode = LAYOUT_MODE_PHYSICAL;
+  else
+    {
+      g_set_error (error, G_OPTION_ERROR, G_OPTION_ERROR_BAD_VALUE,
+                   "Invalid layout mode %s", value);
+      return FALSE;
+    }
+
+  return TRUE;
+}
+
+static gboolean
+parse_transform (const char  *value,
+                 Transform   *transform,
+                 GError     **error)
+{
+  size_t i;
+
+  for (i = 0; i < G_N_ELEMENTS (transform_names); i++)
+    {
+      if (g_str_equal (value, transform_names[i]))
+        {
+          *transform = i;
+          return TRUE;
+        }
+    }
+
+  g_set_error (error, G_OPTION_ERROR, G_OPTION_ERROR_BAD_VALUE,
+               "Invalid transform %s", value);
+  return FALSE;
+}
+
+static gboolean
+parse_named_value (const char         *value,
+                   const char * const *names,
+                   size_t              n_names,
+                   int                *result,
+                   GError            **error)
+{
+  size_t i;
+
+  for (i = 0; i < n_names; i++)
+    {
+      if (names[i] && g_str_equal (value, names[i]))
+        {
+          *result = i;
+          return TRUE;
+        }
+    }
+
+  g_set_error (error, G_OPTION_ERROR, G_OPTION_ERROR_BAD_VALUE,
+               "Invalid value %s", value);
+  return FALSE;
+}
