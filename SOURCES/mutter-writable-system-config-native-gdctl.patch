                    meta_test_monitor_store_policy_dbus_invalid);
+  g_test_add_func ("/backends/monitor-store/write-file-selection",
+                   meta_test_monitor_store_write_file_selection);
+  g_test_add_func ("/backends/monitor-store/replace-system-configurations",
+                   meta_test_monitor_store_replace_system_configurations);
