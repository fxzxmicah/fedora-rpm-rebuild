+/*
+ * System configuration files may contain administrator-owned policy and
+ * extension elements. Keep their original representation intact and only
+ * replace the top-level configuration elements owned by the monitor store.
+ */
+char *
+meta_monitor_config_store_replace_configurations (const char  *xml,
+                                                   const char  *configurations,
+                                                   GError     **error)
+{
+  const GMarkupParser markup_parser = {
+    .start_element = handle_config_xml_start_element,
+    .end_element = handle_config_xml_end_element,
+  };
+  g_autoptr (GMarkupParseContext) context = NULL;
+  g_autoptr (GArray) spans = NULL;
+  g_autoptr (GString) updated = NULL;
+  ConfigXmlParser parser = {
+    .xml = xml,
+    .length = strlen (xml),
+    .configuration_start = G_MAXSIZE,
+    .root_start = G_MAXSIZE,
+    .root_end_start = G_MAXSIZE,
+  };
+  gsize cursor = 0;
+  guint i;
+
+  spans = g_array_new (FALSE, FALSE, sizeof (ConfigXmlSpan));
+  parser.spans = spans;
+  context = g_markup_parse_context_new (&markup_parser,
+                                        G_MARKUP_PREFIX_ERROR_POSITION,
+                                        &parser,
+                                        NULL);
+  if (!g_markup_parse_context_parse (context, xml, -1, error) ||
+      !g_markup_parse_context_end_parse (context, error))
+    return NULL;
+
+  if (!parser.seen_root || parser.depth != 0)
+    {
+      g_set_error (error, G_MARKUP_ERROR, G_MARKUP_ERROR_PARSE,
+                   "Invalid monitors XML document");
+      return NULL;
+    }
+
+  updated = g_string_sized_new (parser.length + strlen (configurations));
+  if (spans->len > 0)
+    {
+      for (i = 0; i < spans->len; i++)
+        {
+          ConfigXmlSpan span = g_array_index (spans, ConfigXmlSpan, i);
+
+          g_string_append_len (updated, xml + cursor, span.start - cursor);
+          if (i == 0)
+            g_string_append (updated, configurations);
+          cursor = span.end;
+        }
+      g_string_append_len (updated, xml + cursor, parser.length - cursor);
+    }
+  else if (parser.root_end_start != G_MAXSIZE)
+    {
+      g_string_append_len (updated, xml, parser.root_end_start);
+      if (parser.root_end_start > 0 &&
+          xml[parser.root_end_start - 1] != '\n')
+        g_string_append_c (updated, '\n');
+      g_string_append (updated, configurations);
+      g_string_append_len (updated,
+                           xml + parser.root_end_start,
+                           parser.length - parser.root_end_start);
+    }
+  else
+    {
+      const char *tag_end = strchr (xml + parser.root_start, '>');
+      const char *slash;
+
+      g_assert_nonnull (tag_end);
+      slash = tag_end;
+      while (slash > xml && g_ascii_isspace (slash[-1]))
+        slash--;
+      g_assert_cmpint (slash[-1], ==, '/');
+
+      g_string_append_len (updated, xml, slash - xml - 1);
+      g_string_append (updated, ">\n");
+      g_string_append (updated, configurations);
+      g_string_append (updated, "</monitors>");
+      g_string_append_len (updated,
+                           tag_end + 1,
+                           parser.length - (tag_end + 1 - xml));
+    }
+
+  return g_string_free (g_steal_pointer (&updated), FALSE);
+}
