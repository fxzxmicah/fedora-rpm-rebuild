+typedef struct
+{
+  gsize start;
+  gsize end;
+} ConfigXmlSpan;
+
+typedef struct
+{
+  const char *xml;
+  gsize length;
+  GArray *spans;
+  unsigned int depth;
+  gboolean seen_root;
+  gsize configuration_start;
+  gsize root_start;
+  gsize root_end_start;
+} ConfigXmlParser;
+
+static gsize
+xml_position_to_offset (ConfigXmlParser    *parser,
+                        GMarkupParseContext *context)
+{
+  const char *line_start = parser->xml;
+  int line;
+  int column;
+  int current_line;
+
+  g_markup_parse_context_get_position (context, &line, &column);
+  for (current_line = 1; current_line < line; current_line++)
+    {
+      line_start = strchr (line_start, '\n');
+      g_assert_nonnull (line_start);
+      line_start++;
+    }
+
+  /* GMarkup reports the column as a byte offset into the current line. */
+  return line_start - parser->xml + column - 1;
+}
+
+static gsize
+include_tag_indentation (const char *xml,
+                         gsize       tag_start)
+{
+  gsize start = tag_start;
+
+  while (start > 0 && (xml[start - 1] == ' ' || xml[start - 1] == '\t'))
+    start--;
+
+  if (start > 0 && xml[start - 1] != '\n' && xml[start - 1] != '\r')
+    return tag_start;
+
+  return start;
+}
+
+static gsize
+include_trailing_newline (const char *xml,
+                          gsize       length,
+                          gsize       tag_end)
+{
+  if (tag_end < length && xml[tag_end] == '\r')
+    tag_end++;
+  if (tag_end < length && xml[tag_end] == '\n')
+    tag_end++;
+
+  return tag_end;
+}
+
+static void
+handle_config_xml_start_element (GMarkupParseContext  *context,
+                                 const char           *element_name,
+                                 const char          **attribute_names,
+                                 const char          **attribute_values,
+                                 gpointer              user_data,
+                                 GError              **error)
+{
+  ConfigXmlParser *parser = user_data;
+  gsize position = xml_position_to_offset (parser, context);
+  const char *tag;
+
+  if (parser->depth == 0)
+    {
+      if (parser->seen_root || !g_str_equal (element_name, "monitors"))
+        {
+          g_set_error (error, G_MARKUP_ERROR, G_MARKUP_ERROR_PARSE,
+                       "Invalid monitors XML document");
+          return;
+        }
+
+      tag = g_strrstr_len (parser->xml, position, "<monitors");
+      g_assert_nonnull (tag);
+      parser->root_start = tag - parser->xml;
+      parser->seen_root = TRUE;
+    }
+  else if (parser->depth == 1 &&
+           g_str_equal (element_name, "configuration"))
+    {
+      tag = g_strrstr_len (parser->xml, position, "<configuration");
+      g_assert_nonnull (tag);
+      parser->configuration_start =
+        include_tag_indentation (parser->xml, tag - parser->xml);
+    }
+
+  parser->depth++;
+}
+
+static void
+handle_config_xml_end_element (GMarkupParseContext  *context,
+                               const char           *element_name,
+                               gpointer              user_data,
+                               GError              **error)
+{
+  ConfigXmlParser *parser = user_data;
+  gsize position = xml_position_to_offset (parser, context);
+
+  if (parser->depth == 2 &&
+      g_str_equal (element_name, "configuration"))
+    {
+      ConfigXmlSpan span = {
+        .start = parser->configuration_start,
+        .end = include_trailing_newline (parser->xml,
+                                        parser->length,
+                                        position),
+      };
+
+      g_array_append_val (parser->spans, span);
+      parser->configuration_start = G_MAXSIZE;
+    }
+  else if (parser->depth == 1 && g_str_equal (element_name, "monitors"))
+    {
+      const char *tag =
+        g_strrstr_len (parser->xml, position, "</monitors");
+
+      if (tag)
+        parser->root_end_start =
+          include_tag_indentation (parser->xml, tag - parser->xml);
+    }
+
+  parser->depth--;
+}
