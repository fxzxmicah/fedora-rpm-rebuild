+static void
+meta_test_monitor_store_write_file_selection (void)
+{
+  g_autofree char *tmp_dir = NULL;
+  g_autofree char *system_dir = NULL;
+  g_autofree char *system_file_path = NULL;
+  g_autofree char *user_dir = NULL;
+  g_autofree char *user_file_path = NULL;
+  g_autoptr (GFile) write_file = NULL;
+  g_autoptr (GFile) system_file = NULL;
+  g_autoptr (GFile) user_file = NULL;
+  g_autofree char *fallback_system_dir = NULL;
+  const char *system_dirs[3];
+  g_autoptr (GList) stores_policy = NULL;
+  MetaConfigStore store;
+
+  tmp_dir = g_dir_make_tmp ("mutter-monitor-store-XXXXXX", NULL);
+  g_assert_nonnull (tmp_dir);
+  system_dir = g_build_filename (tmp_dir, "system", NULL);
+  system_file_path = g_build_filename (system_dir, "monitors.xml", NULL);
+  user_dir = g_build_filename (tmp_dir, "user", NULL);
+  user_file_path = g_build_filename (user_dir, "monitors.xml", NULL);
+  user_file = g_file_new_for_path (user_file_path);
+  fallback_system_dir = g_build_filename (tmp_dir, "fallback-system", NULL);
+  system_dirs[0] = fallback_system_dir;
+  system_dirs[1] = system_dir;
+  system_dirs[2] = NULL;
+
+  g_assert_cmpint (g_mkdir (fallback_system_dir, 0700), ==, 0);
+  g_assert_cmpint (g_mkdir (system_dir, 0700), ==, 0);
+
+  system_file =
+    meta_monitor_config_store_get_writable_system_file (system_dirs);
+  g_assert_nonnull (system_file);
+  write_file = meta_monitor_config_store_select_write_file (
+    user_file,
+    system_file,
+    FALSE,
+    NULL,
+    &store);
+  g_assert_cmpint (store, ==, META_CONFIG_STORE_SYSTEM);
+  g_assert_true (g_file_equal (write_file, system_file));
+
+  g_clear_object (&write_file);
+  g_clear_object (&system_file);
+  g_assert_cmpint (g_chmod (system_dir, 0500), ==, 0);
+  system_file =
+    meta_monitor_config_store_get_writable_system_file (system_dirs);
+  g_assert_null (system_file);
+  g_assert_cmpint (g_chmod (system_dir, 0700), ==, 0);
+
+  g_assert_true (g_file_set_contents (system_file_path, "", 0, NULL));
+  g_assert_cmpint (g_chmod (system_dir, 0500), ==, 0);
+  system_file =
+    meta_monitor_config_store_get_writable_system_file (system_dirs);
+  g_assert_nonnull (system_file);
+  g_clear_object (&system_file);
+  g_assert_cmpint (g_chmod (system_dir, 0700), ==, 0);
+  g_assert_cmpint (g_remove (system_file_path), ==, 0);
+
+  system_file =
+    meta_monitor_config_store_get_writable_system_file (system_dirs);
+  g_assert_nonnull (system_file);
+
+  g_clear_object (&write_file);
+  g_assert_cmpint (g_mkdir (user_dir, 0700), ==, 0);
+  g_assert_true (g_file_set_contents (user_file_path, "", 0, NULL));
+
+  write_file = meta_monitor_config_store_select_write_file (
+    user_file,
+    system_file,
+    FALSE,
+    NULL,
+    &store);
+  g_assert_cmpint (store, ==, META_CONFIG_STORE_USER);
+  g_assert_true (g_file_equal (write_file, user_file));
+
+  g_clear_object (&write_file);
+  stores_policy = g_list_append (stores_policy,
+                                 GINT_TO_POINTER (META_CONFIG_STORE_SYSTEM));
+  write_file = meta_monitor_config_store_select_write_file (
+    user_file,
+    system_file,
+    TRUE,
+    stores_policy,
+    &store);
+  g_assert_cmpint (store, ==, META_CONFIG_STORE_SYSTEM);
+  g_assert_true (g_file_equal (write_file, system_file));
+
+  g_clear_object (&write_file);
+  stores_policy = g_list_prepend (stores_policy,
+                                  GINT_TO_POINTER (META_CONFIG_STORE_USER));
+  write_file = meta_monitor_config_store_select_write_file (
+    user_file,
+    system_file,
+    TRUE,
+    stores_policy,
+    &store);
+  g_assert_cmpint (store, ==, META_CONFIG_STORE_USER);
+  g_assert_true (g_file_equal (write_file, user_file));
+
+  g_clear_object (&write_file);
+  g_clear_pointer (&stores_policy, g_list_free);
+  stores_policy = g_list_append (stores_policy,
+                                 GINT_TO_POINTER (META_CONFIG_STORE_SYSTEM));
+  g_assert_null (meta_monitor_config_store_select_write_file (
+                   user_file,
+                   NULL,
+                   TRUE,
+                   stores_policy,
+                   &store));
+
+  g_assert_cmpint (g_remove (user_file_path), ==, 0);
+  g_assert_cmpint (g_rmdir (user_dir), ==, 0);
+  g_assert_cmpint (g_rmdir (system_dir), ==, 0);
+  g_assert_cmpint (g_rmdir (fallback_system_dir), ==, 0);
+  g_assert_cmpint (g_rmdir (tmp_dir), ==, 0);
+}
+
+static void
+meta_test_monitor_store_replace_system_configurations (void)
+{
+  const char *xml =
+    "<?xml version=\"1.0\"?>\n"
+    "<monitors version=\"2\">\n"
+    "  <!-- This is managed by the administrator. -->\n"
+    "  <policy>\n"
+    "    <stores>\n"
+    "      <store>system</store>\n"
+    "    </stores>\n"
+    "  </policy>\n"
+    "  <configuration>\n"
+    "    <old/>\n"
+    "  </configuration>\n"
+    "  <extension key=\"preserve-me\">\n"
+    "    <configuration>not-a-top-level-configuration</configuration>\n"
+    "  </extension>\n"
+    "  <configuration/>\n"
+    "</monitors>\n";
+  const char *configurations =
+    "  <configuration>\n"
+    "    <new/>\n"
+    "  </configuration>\n";
+  const char *expected =
+    "<?xml version=\"1.0\"?>\n"
+    "<monitors version=\"2\">\n"
+    "  <!-- This is managed by the administrator. -->\n"
+    "  <policy>\n"
+    "    <stores>\n"
+    "      <store>system</store>\n"
+    "    </stores>\n"
+    "  </policy>\n"
+    "  <configuration>\n"
+    "    <new/>\n"
+    "  </configuration>\n"
+    "  <extension key=\"preserve-me\">\n"
+    "    <configuration>not-a-top-level-configuration</configuration>\n"
+    "  </extension>\n"
+    "</monitors>\n";
+  g_autofree char *updated = NULL;
+  g_autoptr (GError) error = NULL;
+
+  updated = meta_monitor_config_store_replace_configurations (xml,
+                                                              configurations,
+                                                              &error);
+  g_assert_no_error (error);
+  g_assert_cmpstr (updated, ==, expected);
+
+  g_clear_pointer (&updated, g_free);
+  updated = meta_monitor_config_store_replace_configurations (
+    "<monitors version=\"2\"><!-- 管理员 -->"
+    "<configuration/><extension>保留</extension></monitors>\n",
+    configurations,
+    &error);
+  g_assert_no_error (error);
+  g_assert_cmpstr (updated, ==,
+                   "<monitors version=\"2\"><!-- 管理员 -->"
+                   "  <configuration>\n"
+                   "    <new/>\n"
+                   "  </configuration>\n"
+                   "<extension>保留</extension></monitors>\n");
+
+  g_clear_pointer (&updated, g_free);
+  updated = meta_monitor_config_store_replace_configurations (
+    "<monitors version=\"2\">\n"
+    "  <policy><dbus>no</dbus></policy>\n"
+    "</monitors>\n",
+    configurations,
+    &error);
+  g_assert_no_error (error);
+  g_assert_cmpstr (updated, ==,
+                   "<monitors version=\"2\">\n"
+                   "  <policy><dbus>no</dbus></policy>\n"
+                   "  <configuration>\n"
+                   "    <new/>\n"
+                   "  </configuration>\n"
+                   "</monitors>\n");
+
+  g_clear_pointer (&updated, g_free);
+  updated = meta_monitor_config_store_replace_configurations (
+    "<?xml version=\"1.0\"?>\n"
+    "<monitors version=\"2\"/>\n",
+    configurations,
+    &error);
+  g_assert_no_error (error);
+  g_assert_cmpstr (updated, ==,
+                   "<?xml version=\"1.0\"?>\n"
+                   "<monitors version=\"2\">\n"
+                   "  <configuration>\n"
+                   "    <new/>\n"
+                   "  </configuration>\n"
+                   "</monitors>\n");
+
+  g_clear_pointer (&updated, g_free);
+  updated = meta_monitor_config_store_replace_configurations (
+    "<monitors version=\"2\"><configuration></monitors></configuration>",
+    configurations,
+    &error);
+  g_assert_error (error, G_MARKUP_ERROR, G_MARKUP_ERROR_PARSE);
+  g_assert_null (updated);
+
+  g_clear_error (&error);
+  updated = meta_monitor_config_store_replace_configurations (
+    "<extension/><monitors version=\"2\"/>",
+    configurations,
+    &error);
+  g_assert_error (error, G_MARKUP_ERROR, G_MARKUP_ERROR_PARSE);
+  g_assert_null (updated);
+}
