+    parse_set_option, "Set the vertical position", "Y" },
+  { "right-of", 0, 0, G_OPTION_ARG_CALLBACK,
+    parse_set_option, "Place right of a monitor", "CONNECTOR" },
+  { "left-of", 0, 0, G_OPTION_ARG_CALLBACK,
+    parse_set_option, "Place left of a monitor", "CONNECTOR" },
+  { "above", 0, 0, G_OPTION_ARG_CALLBACK,
+    parse_set_option, "Place above a monitor", "CONNECTOR" },
+  { "below", 0, 0, G_OPTION_ARG_CALLBACK,
+    parse_set_option, "Place below a monitor", "CONNECTOR" },
