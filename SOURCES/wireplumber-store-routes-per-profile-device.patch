+-- Save an explicit selection for one profile device.
+function saveProfileRoute (dev_info, profile, device_id, route_info)
+  if route_info.profiles ~= nil and
+      not cutils.arrayContains (route_info.profiles, profile.index) then
+    return
   end
 
-  if #routes > 0 then
-    local key = dev_info.name .. ":profile:" .. profile_name
-    state_table [key] = Json.Array (routes):to_string()
-    state:save_after_timeout (state_table)
+  local key = dev_info.name .. ":profile:" .. profile.name ..
+      ":device:" .. tostring (device_id)
+  if state_table [key] == route_info.name then
+    return
   end
+
+  state_table [key] = route_info.name
+  state:save_after_timeout (state_table)
 end
 
--- returns an array of the route names that were previously selected
--- for the given device and profile
-function getStoredProfileRoutes (dev_info, profile_name)
