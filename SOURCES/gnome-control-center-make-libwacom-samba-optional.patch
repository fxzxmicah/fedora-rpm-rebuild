 ...resource.xml => printers.gresource.xml.in} |   1 +
 po/POTFILES.in                                |   1 +
 shell/cc-panel-list.c                         |   2 +
 shell/meson.build                             |   2 +-
 15 files changed, 329 insertions(+), 218 deletions(-)
 create mode 100644 panels/printers/pp-samba-authentication.ui
 rename panels/printers/{printers.gresource.xml => printers.gresource.xml.in} (98%)

