From 1f090a584c6c19dfc6b9e8b9b45923626e264abd Mon Sep 17 00:00:00 2001
From: Fxzx micah <48860358+fxzxmicah@users.noreply.github.com>
Date: Sat, 19 Sep 2026 20:26:37 +0800
Subject: [PATCH 1/2] build: Make libwacom and Samba support optional

Add build options for libwacom and Samba which default to enabled, preserving the upstream build by default.

Disabling libwacom skips its dependency and the complete Wacom panel. Disabling Samba skips smbclient and pp-samba.c, and removes the Samba discovery, authentication, device, and URI code paths from the printers panel.
---
 meson.build                             |  18 ++--
 meson_options.txt                       |   2 +
 panels/meson.build                      |   9 +-
 panels/printers/meson.build             |  15 ++-
 panels/printers/pp-new-printer-dialog.c | 121 +++++++++++++++++++-----
 panels/printers/pp-print-device.c       |  14 +++
 panels/printers/pp-print-device.h       |   4 +
 panels/printers/pp-utils.c              |  14 ++-
 panels/printers/pp-utils.h              |   4 +
 shell/cc-panel-list.c                   |   2 +
 shell/meson.build                       |   2 +-
 11 files changed, 162 insertions(+), 43 deletions(-)

diff --git a/meson.build b/meson.build
index 7e00915..0b66507 100644
--- a/meson.build
+++ b/meson.build
@@ -367,24 +367,27 @@ config_h.set('HAVE_WWAN', host_is_linux,
 if host_is_linux_not_s390
   # gnome-bluetooth
   gnome_bluetooth_dep = dependency('gnome-bluetooth-ui-3.0')
+else
+  message('Bluetooth panel will not be built (no USB support on this platform)')
+  message('Thunderbolt panel will not be built (not supported on this platform)')
+endif
 
+enable_wacom = host_is_linux_not_s390 and get_option('libwacom')
+if enable_wacom
   libwacom_dep = dependency('libwacom', version: '>= 1.4')
 
   wacom_deps = [
     libwacom_dep,
   ]
-else
-  message('Bluetooth and Wacom panels will not be built (no USB support on this platform)')
-  message('Thunderbolt panel will not be built (not supported on this platform)')
 endif
 config_h.set('BUILD_BLUETOOTH', host_is_linux_not_s390,
              description: 'Define to 1 to build the Bluetooth panel')
