diff --git a/dnf5-plugins/copr_plugin/copr_repo.cpp b/dnf5-plugins/copr_plugin/copr_repo.cpp
index a02013b6..5664fc21 100644
--- a/dnf5-plugins/copr_plugin/copr_repo.cpp
+++ b/dnf5-plugins/copr_plugin/copr_repo.cpp
@@ -42,7 +42,7 @@ std::filesystem::path copr_repo_directory(libdnf5::Base * base) {
     std::filesystem::path installroot = base->get_config().get_installroot_option().get_value();
     if (char * dir = getenv("TEST_COPR_CONFIG_DIR")) {
         result = installroot.empty() ? dir : installroot / dir;
-        return result / "yum.repos.d";
+        return result / "dnf/repos.d";
     }
     return installroot.empty() ? COPR_REPO_DIRECTORY : installroot / COPR_REPO_DIRECTORY;
 }
