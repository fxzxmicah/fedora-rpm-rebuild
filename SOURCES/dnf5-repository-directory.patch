From 436e66f537162c422a02c8dafd02ab4ecc12efbb Mon Sep 17 00:00:00 2001
From: Fxzx micah <48860358+fxzxmicah@users.noreply.github.com>
Date: Sun, 8 Nov 2026 16:06:03 +0800
Subject: [PATCH] Use /etc/dnf/repos.d for system repository configuration

Keep repository configuration under /etc/dnf alongside the main configuration and repository overrides. Update the default search path and Copr destination, and create the directory during installation.

Align the documentation and existing test fixtures and expectations with the new layout. Retain the separate distribution and vendor repository directories.
---
 dnf5-plugins/copr_plugin/copr_constants.hpp    |  2 +-
 dnf5-plugins/copr_plugin/copr_repo.cpp         |  2 +-
 doc/dnf5.8.rst                                 |  2 +-
 doc/dnf5.conf.5.rst                            |  8 ++++----
 doc/dnf5_plugins/config-manager.8.rst          |  4 ++--
 doc/dnf5_plugins/copr.8.rst                    |  6 +++---
 include/libdnf5/conf/const.hpp                 |  2 +-
 libdnf5/CMakeLists.txt                         |  3 +++
 test/dnf5-plugins/copr_plugin/CoprRepoTest.cpp | 10 +++++-----
 9 files changed, 21 insertions(+), 18 deletions(-)

diff --git a/dnf5-plugins/copr_plugin/copr_constants.hpp b/dnf5-plugins/copr_plugin/copr_constants.hpp
index 5c27e395..ebbfdbd2 100644
--- a/dnf5-plugins/copr_plugin/copr_constants.hpp
+++ b/dnf5-plugins/copr_plugin/copr_constants.hpp
@@ -55,7 +55,7 @@ static const char * const COPR_EXTERNAL_DEPS_WARNING =
 
 constexpr const char * COPR_DEFAULT_HUB = "copr.fedorainfracloud.org";
 constexpr const char * COPR_DNF5_COMMAND = "dnf5";
-constexpr const char * COPR_REPO_DIRECTORY = "/etc/yum.repos.d";
+constexpr const char * COPR_REPO_DIRECTORY = "/etc/dnf/repos.d";
 
 
 #endif  // DNF5_COMMANDS_COPR_CONSTANTS_HPP
diff --git a/dnf5-plugins/copr_plugin/copr_repo.cpp b/dnf5-plugins/copr_plugin/copr_repo.cpp
index a02013b6..5664fc21 100644
--- a/dnf5-plugins/copr_plugin/copr_repo.cpp
+++ b/dnf5-plugins/copr_plugin/copr_repo.cpp
@@ -42,7 +42,7 @@ std::filesystem::path copr_repo_directory(libdnf5::Base * base) {
     std::filesystem::path installroot = base->get_config().get_installroot_option().get_value();
     if (char * dir = getenv("TEST_COPR_CONFIG_DIR")) {
         result = installroot.empty() ? dir : installroot / dir;
-        return result / "yum.repos.d";
+        return result / "dnf/repos.d";
     }
     return installroot.empty() ? COPR_REPO_DIRECTORY : installroot / COPR_REPO_DIRECTORY;
 }
diff --git a/doc/dnf5.8.rst b/doc/dnf5.8.rst
index 0f619295..ccec8b39 100644
--- a/doc/dnf5.8.rst
+++ b/doc/dnf5.8.rst
@@ -483,7 +483,7 @@ Files
     /etc/dnf/dnf.conf
 
 ``Repository Configuration``
-    /etc/yum.repos.d/
+    /etc/dnf/repos.d/
 
 ``Repository Persistence``
     /var/lib/dnf/
diff --git a/doc/dnf5.conf.5.rst b/doc/dnf5.conf.5.rst
index e7ac080e..b527174e 100644
--- a/doc/dnf5.conf.5.rst
+++ b/doc/dnf5.conf.5.rst
@@ -583,7 +583,7 @@ repository configuration file should aside from repo ID consists of baseurl, met
     The behavior of ``reposdir`` could differ when it is used
     along with \-\ :ref:`-installroot <installroot_options-label>` option.
 
-    Default: [``/etc/yum.repos.d``, ``/etc/distro.repos.d``, ``/usr/share/dnf5/repos.d``]
+    Default: [``/etc/dnf/repos.d``, ``/etc/distro.repos.d``, ``/usr/share/dnf5/repos.d``]
 
 .. _skip_broken_options-label:
 
@@ -1693,7 +1693,7 @@ Files
 .. _repo_files-label:
 
 ``Repository Files``
-    /etc/yum.repos.d/
+    /etc/dnf/repos.d/
 
 .. _varfiles-label:
 
@@ -1719,10 +1719,10 @@ Directories are listed in the order in which they are processed.
    If multiple repositories with the same ID are defined only the first configuration
    will be loaded. Loading the next one will log an error.
 
-.. _yum_repos_dir-label:
+.. _dnf_repos_dir-label:
 
 ``YUM Repositories Directory``
-    /etc/yum.repos.d/
+    /etc/dnf/repos.d/
 
 .. _distro_repos_dir-label:
 
diff --git a/doc/dnf5_plugins/config-manager.8.rst b/doc/dnf5_plugins/config-manager.8.rst
index a649a6e3..f6af2253 100644
--- a/doc/dnf5_plugins/config-manager.8.rst
+++ b/doc/dnf5_plugins/config-manager.8.rst
@@ -46,7 +46,7 @@ Subcommands
     otherwise it is taken from the source specification. If the ``.repo`` extension is missing from the destination
     filename, it will be added.
 
-    The destination directory path is the first path stored in the ``reposdir`` option (by default ``/etc/yum.repos.d``).
+    The destination directory path is the first path stored in the ``reposdir`` option (by default ``/etc/dnf/repos.d``).
     Overwriting/replacing an existing file can be enabled using the ``--overwrite`` option.
     Before the new repositories configuration file is finally saved, it is analyzed and tested for validity.
     Repository IDs are also tested. Repositories with the same ID must not be defined in other configuration files.
@@ -59,7 +59,7 @@ Subcommands
     The destination file name can be defined using the ``--save-filename`` option, otherwise it is set to the repository ID.
     If the ``.repo`` extension is missing from the destination filename, it will be added.
 
-    The destination directory path is the first path stored in the ``reposdir`` option (by default ``/etc/yum.repos.d``).
+    The destination directory path is the first path stored in the ``reposdir`` option (by default ``/etc/dnf/repos.d``).
     Overwriting/replacing an existing file can be enabled using the ``--overwrite`` option.
     Modifying an existing file can be enabled using the ``--add-or-replace`` option. Modification means
     that the new repository is added to the existing file or a repository with the same ID is replaced in the file.
diff --git a/doc/dnf5_plugins/copr.8.rst b/doc/dnf5_plugins/copr.8.rst
index 42e74acc..3612a5b5 100644
--- a/doc/dnf5_plugins/copr.8.rst
+++ b/doc/dnf5_plugins/copr.8.rst
@@ -43,13 +43,13 @@ Subcommands
     | List Copr repositories.
 
 ``enable <project-spec> [<chroot>]``
-    | Download the repository info from a Copr server and install it as a `/etc/yum.repos.d/*.repo` file.
+    | Download the repository info from a Copr server and install it as a `/etc/dnf/repos.d/*.repo` file.
 
 ``disable <project-spec>``
-    | Disable specified Copr repository (if exists), keep `/etc/yum.repos.d/*.repo` file - just set enabled=0.
+    | Disable specified Copr repository (if exists), keep `/etc/dnf/repos.d/*.repo` file - just set enabled=0.
 
 ``remove <project-spec>``
-    | Remove specified Copr repository from the system. Also removes the `/etc/yum.repos.d/*.repo` file.
+    | Remove specified Copr repository from the system. Also removes the `/etc/dnf/repos.d/*.repo` file.
 
 ``debug``
     | Print info about the system useful for debugging.
diff --git a/include/libdnf5/conf/const.hpp b/include/libdnf5/conf/const.hpp
index 42a7f440..77717fb3 100644
--- a/include/libdnf5/conf/const.hpp
+++ b/include/libdnf5/conf/const.hpp
@@ -40,7 +40,7 @@ constexpr const char * PLUGINS_CONF_DIR = "/etc/dnf/libdnf5-plugins";
 const std::vector<std::string> PLUGINS_CONF_DIRS{"/etc/dnf/libdnf5-plugins", "/usr/share/dnf5/libdnf.plugins.conf.d"};
 
 const std::vector<std::string> REPOSITORY_CONF_DIRS{
-    "/etc/yum.repos.d", "/etc/distro.repos.d", "/usr/share/dnf5/repos.d"};
+    "/etc/dnf/repos.d", "/etc/distro.repos.d", "/usr/share/dnf5/repos.d"};
 constexpr const char * REPOS_OVERRIDE_DIR = "/etc/dnf/repos.override.d";
 // Filename inherited from config-manager plugin which originally owned this file.
 constexpr const char * USER_REPOS_OVERRIDE_FILENAME = "99-config_manager.repo";
diff --git a/libdnf5/CMakeLists.txt b/libdnf5/CMakeLists.txt
index 359e39e5..775b64bc 100644
--- a/libdnf5/CMakeLists.txt
+++ b/libdnf5/CMakeLists.txt
@@ -151,6 +151,9 @@ install(DIRECTORY DESTINATION "${CMAKE_INSTALL_PREFIX}/share/dnf5/libdnf.conf.d"
 # Makes an empty directory for libdnf5 user drop-in configuration files
 install(DIRECTORY DESTINATION "${CMAKE_INSTALL_FULL_SYSCONFDIR}/dnf/libdnf5.conf.d")
 
+# Creates an empty directory for user-defined repository configuration files
+install(DIRECTORY DESTINATION "${CMAKE_INSTALL_FULL_SYSCONFDIR}/dnf/repos.d")
+
 # Creates an empty directory for distribution-supplied repositories configuration overrides
 install(DIRECTORY DESTINATION "${CMAKE_INSTALL_PREFIX}/share/dnf5/repos.override.d")
 
diff --git a/test/dnf5-plugins/copr_plugin/CoprRepoTest.cpp b/test/dnf5-plugins/copr_plugin/CoprRepoTest.cpp
