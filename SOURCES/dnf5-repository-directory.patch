     CPPUNIT_ASSERT_EQUAL(expected, load_file_as_string(saved_file));
 }
 
@@ -163,7 +163,7 @@ void CoprRepoTest::test_disable() {
     install_repofile("jdoe-beakerlib-fedora-38-x86_64.repo", "_copr:copr.example.com:jdoe:beakerlib.repo");
     reload_repofiles();
