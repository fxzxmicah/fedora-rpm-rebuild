From 1b37b03d3d84d0913e64194e8a53c05db8179118 Mon Sep 17 00:00:00 2001
From: Fxzx micah <48860358+fxzxmicah@users.noreply.github.com>
Date: Sat, 19 Sep 2026 20:26:47 +0800
Subject: [PATCH] panels: Hide entries for unavailable system services

Hide the Secure Shell row when the system has no controllable sshd service.

Probe the CUPS service independently of configured printer destinations. Hide the Printers panel when the service is unavailable, while keeping it visible when CUPS is running without any configured printers.
---
 panels/printers/cc-printers-panel.c          | 39 ++++++++++++++++++++
 panels/printers/cc-printers-panel.h          |  3 ++
 panels/system/cc-system-panel.blp            |  2 +-
 panels/system/cc-system-panel.c              | 11 ++++++
 panels/system/cc-systemd-service.h           | 10 +++++
 panels/system/secure-shell/cc-secure-shell.c | 10 -----
 shell/cc-panel-loader.c                      |  3 +-
 7 files changed, 66 insertions(+), 12 deletions(-)

diff --git a/panels/printers/cc-printers-panel.c b/panels/printers/cc-printers-panel.c
index d9b6a50..06c3034 100644
--- a/panels/printers/cc-printers-panel.c
+++ b/panels/printers/cc-printers-panel.c
@@ -18,6 +18,8 @@
 
 #include <config.h>
 
+#include "shell/cc-application.h"
+#include "shell/cc-log.h"
 #include "shell/cc-object-storage.h"
 
 #include "cc-printers-panel.h"
@@ -119,6 +121,43 @@ struct _CcPrintersPanel {
 
 CC_PANEL_REGISTER (CcPrintersPanel, cc_printers_panel)
 
+static void
+set_panel_visibility (gboolean visible)
+{
+    CcApplication *application;
+
+    application = CC_APPLICATION (g_application_get_default ());
+    cc_shell_model_set_panel_visibility (cc_application_get_model (application), "printers",
+                                         visible ? CC_PANEL_VISIBLE : CC_PANEL_HIDDEN);
+
+    g_debug ("Printers panel visible: %s", visible ? "yes" : "no");
+}
+
+static void
+update_panel_visibility (GObject *source_object, GAsyncResult *result, gpointer user_data)
+{
+    g_autoptr(GError) error = NULL;
+    gboolean visible;
+
+    visible = pp_cups_connection_test_finish (PP_CUPS (source_object), result, &error);
+    if (error != NULL) {
+        g_warning ("Could not test connection to the printing service: %s", error->message);
+        return;
+    }
+
+    set_panel_visibility (visible);
+}
+
+void
+cc_printers_panel_static_init_func (void)
+{
+    g_autoptr(PpCups) cups = pp_cups_new ();
+
+    CC_TRACE_MSG ("Updating Printers panel visibility");
+    set_panel_visibility (FALSE);
+    pp_cups_connection_test_async (cups, NULL, update_panel_visibility, NULL);
+}
+
 typedef struct {
     gchar *printer_name;
     GCancellable *cancellable;
diff --git a/panels/printers/cc-printers-panel.h b/panels/printers/cc-printers-panel.h
index 3d04310..6343c27 100644
--- a/panels/printers/cc-printers-panel.h
+++ b/panels/printers/cc-printers-panel.h
@@ -24,4 +24,7 @@ G_BEGIN_DECLS
 
 #define CC_TYPE_PRINTERS_PANEL (cc_printers_panel_get_type ())
 G_DECLARE_FINAL_TYPE (CcPrintersPanel, cc_printers_panel, CC, PRINTERS_PANEL, CcPanel);
+
+void cc_printers_panel_static_init_func (void);
+
 G_END_DECLS
diff --git a/panels/system/cc-system-panel.blp b/panels/system/cc-system-panel.blp
index fa39bf6..46f17a2 100644
--- a/panels/system/cc-system-panel.blp
+++ b/panels/system/cc-system-panel.blp
@@ -47,7 +47,7 @@ template $CcSystemPanel: $CcPanel {
           action-target: "'remote-desktop'";
         }
 
-        $CcListRow {
+          $CcListRow secure_shell_row {
           title: _("Se_cure Shell");
           subtitle: _("SSH network access");
           icon-name: "utilities-terminal-symbolic";
diff --git a/panels/system/cc-system-panel.c b/panels/system/cc-system-panel.c
index 81f77f7..4d9a19b 100644
--- a/panels/system/cc-system-panel.c
+++ b/panels/system/cc-system-panel.c
@@ -42,6 +42,7 @@ struct _CcSystemPanel {
     AdwActionRow *datetime_row;
     AdwActionRow *region_row;
     AdwActionRow *remote_desktop_row;
+    AdwActionRow *secure_shell_row;
     AdwActionRow *users_row;
 
     CcSecureShellPage *secure_shell_dialog;
@@ -135,6 +136,7 @@ cc_system_panel_class_init (CcSystemPanelClass *klass)
     gtk_widget_class_bind_template_child (widget_class, CcSystemPanel, datetime_row);
     gtk_widget_class_bind_template_child (widget_class, CcSystemPanel, region_row);
     gtk_widget_class_bind_template_child (widget_class, CcSystemPanel, remote_desktop_row);
+    gtk_widget_class_bind_template_child (widget_class, CcSystemPanel, secure_shell_row);
     gtk_widget_class_bind_template_child (widget_class, CcSystemPanel, users_row);
     gtk_widget_class_bind_template_child (widget_class, CcSystemPanel, software_updates_group);
 
@@ -162,6 +164,15 @@ cc_system_panel_init (CcSystemPanel *self)
     /* Hide the remote-desktop page if the g-r-d service is either "masked", "static", or "not-found". */
     gtk_widget_set_visible (GTK_WIDGET (self->remote_desktop_row),
                             service_state == CC_SERVICE_STATE_ENABLED || service_state == CC_SERVICE_STATE_DISABLED);
+
+    service_state = cc_get_service_state (SSHD_SERVICE, G_BUS_TYPE_SYSTEM);
+#ifdef HAVE_SSH_SOCKET_ACTIVATION
+    if (service_state != CC_SERVICE_STATE_ENABLED && service_state != CC_SERVICE_STATE_DISABLED)
+        service_state = cc_get_service_state (SSHD_SOCKET, G_BUS_TYPE_SYSTEM);
+#endif
+    gtk_widget_set_visible (GTK_WIDGET (self->secure_shell_row),
+                            service_state == CC_SERVICE_STATE_ENABLED || service_state == CC_SERVICE_STATE_DISABLED);
+
     gtk_widget_set_visible (GTK_WIDGET (self->software_updates_group), show_software_updates_group (self));
 
     cc_panel_add_static_subpage (CC_PANEL (self), "about", CC_TYPE_ABOUT_PAGE);
