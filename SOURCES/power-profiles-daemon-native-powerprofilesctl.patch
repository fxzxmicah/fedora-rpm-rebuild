--- /dev/null
+++ b/src/completions/_powerprofilesctl
@@ -0,0 +1,27 @@
+#compdef powerprofilesctl
+
+local -a commands profiles
+commands=(
+  'list:List available power profiles'
+  'list-holds:List current power profile holds'
+  'list-actions:List available power profile actions'
+  'get:Print the active profile'
+  'set:Set the active profile'
+  'configure-action:Configure a profile action'
+  'configure-battery-aware:Configure dynamic battery changes'
+  'query-battery-aware:Query dynamic battery changes'
+  'launch:Launch a command with a profile hold'
+  'version:Print version information'
+)
+profiles=(power-saver balanced performance)
+
+if (( CURRENT == 2 )); then
+  _describe command commands
+  return
+fi
+
+case $words[2] in
+  set) _values profile $profiles ;;
+  configure-action|configure-battery-aware) _arguments '--enable[enable]' '--disable[disable]' ;;
+  launch) _arguments '-p[profile]:profile:($profiles)' '-r[reason]:reason:' '-i[application ID]:application ID:' '*::command:_normal' ;;
+esac
