+_powerprofilesctl()
+{
+    local cur commands profiles
+    COMPREPLY=()
+    cur="${COMP_WORDS[COMP_CWORD]}"
+    commands="list list-holds list-actions get set configure-action configure-battery-aware query-battery-aware launch version"
+    profiles="power-saver balanced performance"
+
+    if (( COMP_CWORD == 1 )); then
+        COMPREPLY=( $(compgen -W "$commands" -- "$cur") )
+    elif [[ ${COMP_WORDS[1]} == set ]]; then
+        COMPREPLY=( $(compgen -W "$profiles" -- "$cur") )
+    elif [[ ${COMP_WORDS[1]} == configure-action || ${COMP_WORDS[1]} == configure-battery-aware ]]; then
+        COMPREPLY=( $(compgen -W "--enable --disable" -- "$cur") )
+    elif [[ ${COMP_WORDS[1]} == launch ]]; then
+        COMPREPLY=( $(compgen -W "--profile --reason --appid" -- "$cur") )
+    fi
+}
+complete -F _powerprofilesctl powerprofilesctl
