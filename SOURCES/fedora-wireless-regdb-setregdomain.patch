diff --git a/setregdomain/Makefile b/setregdomain/Makefile
new file mode 100644
index 0000000..cc090be
--- /dev/null
+++ b/setregdomain/Makefile
@@ -0,0 +1,33 @@
+CC ?= cc
+PKG_CONFIG ?= pkg-config
+PREFIX ?= /usr
+MANDIR ?= $(PREFIX)/share/man
+SBINDIR ?= $(PREFIX)/sbin
+CFLAGS ?= -O2 -Wall -Wextra
+LDFLAGS ?=
+
+NL_CFLAGS := $(shell $(PKG_CONFIG) --cflags libnl-3.0 libnl-genl-3.0)
+NL_LIBS := $(shell $(PKG_CONFIG) --libs libnl-3.0 libnl-genl-3.0)
+
+CFLAGS += $(NL_CFLAGS)
+LDLIBS += $(NL_LIBS)
+
+BINARY := setregdomain
+SOURCES := setregdomain.c
+OBJECTS := $(SOURCES:.c=.o)
+
+.PHONY: all clean install
+
+all: $(BINARY)
+
+$(BINARY): $(OBJECTS)
+	$(CC) $(CFLAGS) $(LDFLAGS) -o $@ $^ $(LDLIBS)
+
+clean:
+	rm -f $(OBJECTS) $(BINARY)
+
+install: $(BINARY)
+	install -m 755 -d $(DESTDIR)/$(SBINDIR)
+	install -m 755 -t $(DESTDIR)/$(SBINDIR)/ $(BINARY)
+	install -m 755 -d $(DESTDIR)/$(MANDIR)/man1
+	install -m 644 -t $(DESTDIR)/$(MANDIR)/man1/ setregdomain.1
diff --git a/setregdomain/setregdomain.1 b/setregdomain/setregdomain.1
new file mode 100644
index 0000000..af82c0b
--- /dev/null
+++ b/setregdomain/setregdomain.1
@@ -0,0 +1,46 @@
+.\" Copyright 2009 Red Hat, Inc.
+.TH setregdomain 1 2025-12-03 "CRDA" "User Commands"
+.SH NAME
+setregdomain \- set regulatory domain based on country code
+.SH SYNOPSIS
+.B setregdomain
+.SH DESCRIPTION
+setregdomain sets the regulatory domain for your system; it takes no
+arguments and is normally triggered by system scripts (eg, udev) rather
+than manually by an administrator.  The tool is a native nl80211 client
+and communicates directly with the kernel, so no external helper
+programs such as
+.BR iw (1)
+are required.
+
+The regulatory domain is represented by an ISO / IEC 3166-1 alpha2
+country code.  By default, setregdomain attempts to determine
+the appropriate country code by examining the target of the
+.IR /etc/localtime
+symbolic link.  That information is used to look-up the matching
+country code in the
+.IR /usr/share/zoneinfo/zone.tab
+file.
+
+The country code look-up may fail.  This could be due to faulty
+or incomplete information in the
+.IR /usr/share/zoneinfo/zone.tab
+file, or the use of an actual file rather than a symlink for
+.IR /etc/localtime
+, among other possibilities.  In those cases the system
+administrator should define a COUNTRY environment variable in the
+.IR /etc/sysconfig/regdomain
+file.  This value will be used as the country code and the country
+code look-up will be skipped.
+.PP
+All informational and error messages are emitted to the system log via
+the
+.B wireless
+syslog tag.  When run manually an additional copy is printed to the
+terminal for convenience.
+.SH "FILES"
+.BR /etc/sysconfig/regdomain
+.BR /etc/localtime
+.BR /usr/share/zoneinfo/zone.tab
+.SH "SEE ALSO"
+.BR iw (1)
diff --git a/setregdomain/setregdomain.c b/setregdomain/setregdomain.c
new file mode 100644
index 0000000..40016bd
--- /dev/null
+++ b/setregdomain/setregdomain.c
@@ -0,0 +1,437 @@
