+static void
+crypto_format_cb (GObject *source_object, GAsyncResult *res, gpointer user_data)
+{
+  CreateFormatData *data = user_data;
+  GError *error = NULL;
+  gchar *path = NULL;
+  UDisksObject *object = NULL;
+  UDisksBlock *block;
+
+  if (!udisks_block_crypto_call_format_finish (UDISKS_BLOCK_CRYPTO (source_object), &path, res, &error))
+    goto out;
+  udisks_client_settle (data->client);
+  object = udisks_client_get_object (data->client, path);
+  block = object != NULL ? udisks_object_peek_block (object) : NULL;
+  if (block == NULL)
+    {
+      g_set_error_literal (&error, G_IO_ERROR, G_IO_ERROR_NOT_FOUND,
+                           _("The newly created encrypted device is no longer available"));
+      goto out;
+    }
+  g_set_object (&data->block, block);
+  format_filesystem (data);
+
+ out:
+  if (error != NULL)
+    {
+      gdu_utils_show_error (GTK_WINDOW (data->parent_window), _("Error creating encrypted volume"), error);
+      g_error_free (error);
+      create_format_data_free (data);
+    }
+  g_clear_object (&object);
+  g_free (path);
+}
+
+static void
+ensure_unused_cb (UDisksClient *client, GAsyncResult *res, CreateFormatData *data)
+{
+  UDisksBlockCrypto *crypto;
+  GVariantBuilder options;
+  const gchar *password;
+
+  if (!gdu_utils_ensure_unused_finish (client, res, NULL))
+    {
+      create_format_data_free (data);
+      return;
+    }
+  if (!get_encrypt (data))
+    {
+      format_filesystem (data);
+      return;
+    }
+
+  crypto = udisks_object_peek_block_crypto (UDISKS_OBJECT (g_dbus_interface_get_object (G_DBUS_INTERFACE (data->block))));
+  if (crypto == NULL)
+    {
+      GError *error = g_error_new_literal (G_IO_ERROR, G_IO_ERROR_NOT_SUPPORTED,
+                                           _("Encryption support is not available"));
+
+      gdu_utils_show_error (GTK_WINDOW (data->parent_window), _("Error creating encrypted volume"), error);
+      g_error_free (error);
+      create_format_data_free (data);
+      return;
+    }
+
+  password = gdu_create_password_page_get_password (data->password_page);
+  g_variant_builder_init (&options, G_VARIANT_TYPE_VARDICT);
+  g_variant_builder_add (&options, "{sv}", "type", g_variant_new_string ("luks2"));
+  g_variant_builder_add (&options, "{sv}", "update-partition-type", g_variant_new_boolean (TRUE));
+  udisks_block_crypto_call_format (crypto,
+                                   g_variant_new_fixed_array (G_VARIANT_TYPE_BYTE, password, strlen (password), 1),
+                                   g_variant_builder_end (&options),
+                                   NULL,
+                                   crypto_format_cb,
+                                   data);
+}
+
 void
 finish_cb (GtkDialog *assistant, gint response_id, CreateFormatData *data);
 
