 [Jack Line Out Front]
-state.plugged = no
+state.plugged = unknown
 state.unplugged = unknown
 
 [Jack Front Line Out]
-state.plugged = no
+state.plugged = unknown
 state.unplugged = unknown
 
 [Jack Rear Line Out]
-state.plugged = no
+state.plugged = unknown
 state.unplugged = unknown
 
 [Jack Dock Line Out]
-state.plugged = no
+state.plugged = unknown
 state.unplugged = unknown
 
 [Jack Speaker]
