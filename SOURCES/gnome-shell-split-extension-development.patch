+
+#include "config.h"
+
+#include <glib/gi18n.h>
+#include <gmodule.h>
+
+#include "commands.h"
+
+G_MODULE_EXPORT const ExtensionCommand *
+gnome_extensions_get_development_commands (gsize *n_commands)
+{
+  static const ExtensionCommand commands[] = {
+    { "create", N_("Create extension"), handle_create },
+    { "pack", N_("Package extension"), handle_pack },
+    { "upload", N_("Upload extension"), handle_upload },
+  };
+
+  *n_commands = G_N_ELEMENTS (commands);
+  return commands;
+}
diff --git a/subprojects/extensions-tool/src/main.c b/subprojects/extensions-tool/src/main.c
index 251d8db..a2d2abb 100644
--- a/subprojects/extensions-tool/src/main.c
+++ b/subprojects/extensions-tool/src/main.c
@@ -24,6 +24,7 @@
 
 #include <gio/gio.h>
 #include <glib/gi18n.h>
+#include <gmodule.h>
 
 #include "commands.h"
 #include "common.h"
@@ -302,6 +303,42 @@ file_delete_recursively (GFile   *file,
 }
 
 
+static const ExtensionCommand *
+get_development_commands (gsize *n_commands)
+{
+  static const ExtensionCommand *commands = NULL;
+  static gsize n_development_commands = 0;
+  static gboolean initialized = FALSE;
+
+  if (!initialized)
+    {
+      GModule *module;
+
+      initialized = TRUE;
+      module = g_module_open (DEVELOPMENT_MODULE, G_MODULE_BIND_LOCAL);
+      if (module != NULL)
+        {
+          const ExtensionCommand *(*get_commands) (gsize *);
+
+          if (g_module_symbol (module, "gnome_extensions_get_development_commands",
+                               (gpointer *) &get_commands))
+            {
+              commands = get_commands (&n_development_commands);
+              g_module_make_resident (module);
+            }
+          else
+            g_printerr ("%s\n", g_module_error ());
+
+          g_module_close (module);
+        }
+      else if (g_file_test (DEVELOPMENT_MODULE, G_FILE_TEST_EXISTS))
+        g_printerr ("%s\n", g_module_error ());
+    }
+
+  *n_commands = n_development_commands;
+  return commands;
+}
+
 static int
 handle_version (int argc, char *argv[], gboolean do_help)
 {
@@ -327,6 +364,8 @@ static void
 usage (void)
 {
   g_autofree char *help_command = NULL;
+  const ExtensionCommand *commands;
