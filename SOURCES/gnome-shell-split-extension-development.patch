diff --git a/subprojects/extensions-tool/completion/bash/development.bash b/subprojects/extensions-tool/completion/bash/development.bash
new file mode 100644
index 0000000..e4dfbef
--- /dev/null
+++ b/subprojects/extensions-tool/completion/bash/development.bash
@@ -0,0 +1,38 @@
+# Sourced by the management completion when the development module is installed.
+commands+=" create pack upload"
+
+__gnome_extensions_complete_development() {
+  case "$1" in
+    create)
+      case "$prev" in
+        --template)
+          COMPREPLY=($(compgen -W "`gnome-extensions create --list-templates`" -- "$cur"))
+          return 0
+          ;;
+      esac
+      ;;
+    pack)
+      case "$prev" in
+        --podir|--out-dir|-o)
+          _filedir -d
+          return 0
+          ;;
+        --schema)
+          _filedir gschema.xml
+          return 0
+          ;;
+        --extra-source)
+          _filedir
+          return 0
+          ;;
+      esac
+      ;;
+    upload)
+      if [[ $cur != -* ]]; then
+        _filedir zip
+        return 0
+      fi
+      ;;
+  esac
+  return 1
+}
