+static gchar *
+m365_transport_dup_account_address (CamelService *service)
+{
+	CamelSettings *settings;
+	gchar *account_address = NULL;
+
+	g_return_val_if_fail (CAMEL_IS_M365_TRANSPORT (service), NULL);
+
+	settings = camel_service_ref_settings (service);
+
+	if (CAMEL_IS_M365_SETTINGS (settings)) {
+		CamelM365Settings *m365_settings = CAMEL_M365_SETTINGS (settings);
+
+		if (camel_m365_settings_get_use_impersonation (m365_settings)) {
+			account_address = camel_m365_settings_dup_impersonate_user (m365_settings);
+
+			if (account_address && !*account_address)
+				g_clear_pointer (&account_address, g_free);
+		}
+
+		if (!account_address)
+			account_address = camel_network_settings_dup_user (CAMEL_NETWORK_SETTINGS (settings));
+	}
+
+	g_clear_object (&settings);
+
+	return account_address;
+}
