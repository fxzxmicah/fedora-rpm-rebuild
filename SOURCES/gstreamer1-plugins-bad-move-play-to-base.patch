-      "\tduration %" GST_TIME_FORMAT " -> %" GST_TIME_FORMAT "\n"
-      "\tseek position %" GST_TIME_FORMAT " -> %" GST_TIME_FORMAT "\n"
-      "\tend-of-stream %d -> %d\n"
-      "\terror %d -> %d\n"
