-      return "video-dimensions-changed";
-    case STATE_CHANGE_MEDIA_INFO_UPDATED:
-      return "media-info-updated";
-    case STATE_CHANGE_SEEK_DONE:
-      return "seek-done";
-    case STATE_CHANGE_URI_LOADED:
-      return "uri-loaded";
