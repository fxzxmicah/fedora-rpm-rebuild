-  g_object_set (self->playbin, "vis-plugin", self->current_vis_element, NULL);
-
-  g_mutex_unlock (&self->lock);
-  GST_DEBUG_OBJECT (self, "set vis-plugin to '%s'", name);
-
-  return TRUE;
-
-error_no_element:
-  g_mutex_unlock (&self->lock);
-  GST_WARNING_OBJECT (self, "could not find visualization '%s'", name);
