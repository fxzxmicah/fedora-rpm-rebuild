-{
-  GstColorBalanceChannel *channel;
-  const GList *l, *channels;
-
-  if (type < GST_PLAY_COLOR_BALANCE_BRIGHTNESS ||
-      type > GST_PLAY_COLOR_BALANCE_HUE)
-    return NULL;
-
-  channels =
-      gst_color_balance_list_channels (GST_COLOR_BALANCE (self->playbin));
