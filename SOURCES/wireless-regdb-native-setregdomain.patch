From d8ea1cc8d457d12f34ef961d67a96d7fa9a13a7b Mon Sep 17 00:00:00 2001
From: Fxzx micah <48860358+fxzxmicah@users.noreply.github.com>
Date: Wed, 23 Sep 2026 02:32:03 +0800
Subject: [PATCH] wireless-regdb: add native setregdomain utility

---
 setregdomain/Makefile       |  33 +++
 setregdomain/setregdomain.1 |  45 ++++
 setregdomain/setregdomain.c | 461 ++++++++++++++++++++++++++++++++++++
 3 files changed, 539 insertions(+)
 create mode 100644 setregdomain/Makefile
 create mode 100644 setregdomain/setregdomain.1
 create mode 100644 setregdomain/setregdomain.c

diff --git a/setregdomain/Makefile b/setregdomain/Makefile
new file mode 100644
index 0000000..4d99dc8
--- /dev/null
+++ b/setregdomain/Makefile
@@ -0,0 +1,33 @@
+CC ?= cc
+PKG_CONFIG ?= pkg-config
+PREFIX ?= /usr
+MANDIR ?= $(PREFIX)/share/man
+SBINDIR ?= $(PREFIX)/sbin
+CFLAGS ?= -O2 -Wall -Wextra
+LDFLAGS ?=
+
+NL_CFLAGS := $(shell $(PKG_CONFIG) --cflags libnl-3.0 libnl-genl-3.0)
+NL_LIBS := $(shell $(PKG_CONFIG) --libs libnl-3.0 libnl-genl-3.0)
+
+CPPFLAGS += $(NL_CFLAGS)
+LDLIBS += $(NL_LIBS)
+
+BINARY := setregdomain
+SOURCES := setregdomain.c
+OBJECTS := $(SOURCES:.c=.o)
+
+.PHONY: all clean install
+
+all: $(BINARY)
+
+$(BINARY): $(OBJECTS)
+	$(CC) $(CFLAGS) $(LDFLAGS) -o $@ $^ $(LDLIBS)
+
+clean:
+	rm -f $(OBJECTS) $(BINARY)
+
+install: $(BINARY)
+	install -m 755 -d $(DESTDIR)$(SBINDIR)
+	install -m 755 -t $(DESTDIR)$(SBINDIR)/ $(BINARY)
+	install -m 755 -d $(DESTDIR)$(MANDIR)/man1
+	install -m 644 -t $(DESTDIR)$(MANDIR)/man1/ setregdomain.1
diff --git a/setregdomain/setregdomain.1 b/setregdomain/setregdomain.1
new file mode 100644
index 0000000..bbc4f96
--- /dev/null
+++ b/setregdomain/setregdomain.1
@@ -0,0 +1,45 @@
+.\" Copyright 2009 Red Hat, Inc.
+.TH setregdomain 1 2025-12-03 "CRDA" "User Commands"
+.SH NAME
+setregdomain \- set regulatory domain based on country code
+.SH SYNOPSIS
+.B setregdomain
+.SH DESCRIPTION
+setregdomain sets the regulatory domain for your system; it takes no
+arguments and is normally triggered by system scripts (eg, udev) rather
+than manually by an administrator.  The tool is a native nl80211 client
+and communicates directly with the kernel, so no external helper
+programs such as
+.BR iw (1)
+are required.
+
+The regulatory domain is represented by an ISO / IEC 3166-1 alpha2
+country code.  By default, setregdomain attempts to determine
+the appropriate country code by examining the target of the
+.IR /etc/localtime
+symbolic link.  That information is used to look-up the matching
+country code in the
+.IR /usr/share/zoneinfo/zone.tab
+file.
+
+The country code look-up may fail.  This could be due to faulty
+or incomplete information in the
+.IR /usr/share/zoneinfo/zone.tab
+file, or the use of an actual file rather than a symlink for
+.IR /etc/localtime
+, among other possibilities.  In those cases the system
+administrator should define a COUNTRY environment variable in the
+.IR /etc/sysconfig/regdomain
+file.  This value will be used as the country code and the country
+code look-up will be skipped.
+.PP
+All informational and error messages are emitted to the system log via
+the
+.B wireless
+syslog tag. Errors are also printed to standard error.
+.SH "FILES"
+.BR /etc/sysconfig/regdomain
+.BR /etc/localtime
+.BR /usr/share/zoneinfo/zone.tab
+.SH "SEE ALSO"
+.BR iw (1)
diff --git a/setregdomain/setregdomain.c b/setregdomain/setregdomain.c
new file mode 100644
index 0000000..9320298
--- /dev/null
+++ b/setregdomain/setregdomain.c
@@ -0,0 +1,461 @@
+/*
+ * Copyright 2009-2014 Red Hat, Inc.
+ *
+ * Permission to use, copy, modify, and/or distribute this software for any
+ * purpose with or without fee is hereby granted, provided that the above
+ * copyright notice and this permission notice appear in all copies.
+ *
+ * THE SOFTWARE IS PROVIDED "AS IS" AND THE AUTHOR DISCLAIMS ALL WARRANTIES
+ * WITH REGARD TO THIS SOFTWARE INCLUDING ALL IMPLIED WARRANTIES OF
+ * MERCHANTABILITY AND FITNESS. IN NO EVENT SHALL THE AUTHOR BE LIABLE FOR
+ * ANY SPECIAL, DIRECT, INDIRECT, OR CONSEQUENTIAL DAMAGES OR ANY DAMAGES
+ * WHATSOEVER RESULTING FROM LOSS OF USE, DATA OR PROFITS, WHETHER IN AN
+ * ACTION OF CONTRACT, NEGLIGENCE OR OTHER TORTIOUS ACTION, ARISING OUT OF OR
+ * IN CONNECTION WITH THE USE OR PERFORMANCE OF THIS SOFTWARE.
+ */
+
+#define _GNU_SOURCE
+
+#include <ctype.h>
+#include <errno.h>
+#include <limits.h>
+#include <locale.h>
+#include <stdarg.h>
+#include <stdbool.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <syslog.h>
+#include <unistd.h>
+
+#include <linux/nl80211.h>
+#include <netlink/errno.h>
+#include <netlink/genl/ctrl.h>
+#include <netlink/genl/genl.h>
+#include <netlink/netlink.h>
+#include <netlink/msg.h>
+
+#define REGDOMAIN_FILE "/etc/sysconfig/regdomain"
+#define LOCALTIME_PATH "/etc/localtime"
+#define ZONEINFO_PREFIX "/usr/share/zoneinfo/"
+#define ZONE_TAB_FILE "/usr/share/zoneinfo/zone.tab"
+#define LOGGER_TAG "wireless"
+#define COUNTRY_LEN 2
+
+static void log_error(const char *fmt, ...);
+static void log_info(const char *fmt, ...);
+static char *trim(char *s);
+static void strip_quotes(char *s);
+static void strip_inline_comment(char *s);
+static void ascii_uppercase_inplace(char *s);
+static bool valid_country_code(const char *s);
+enum config_result {
+    CONFIG_NOT_SET,
+    CONFIG_LOADED,
+    CONFIG_ERROR,
+};
+
+enum lookup_result {
+    LOOKUP_ERROR = -1,
+    LOOKUP_NOT_FOUND,
+    LOOKUP_FOUND,
+};
+
+static enum config_result load_country_from_config(char country[COUNTRY_LEN + 1]);
+static bool resolve_timezone(char *zone_name, size_t len);
+static enum lookup_result lookup_country_by_zone(const char *zone_name,
+                                                 char country[COUNTRY_LEN + 1]);
+static bool determine_country_from_timezone(char country[COUNTRY_LEN + 1]);
+static bool determine_country(char country[COUNTRY_LEN + 1]);
+static int set_regulatory_domain(const char *country);
+
+int main(int argc, char **argv)
+{
+    char country[COUNTRY_LEN + 1] = {0};
+    int status = EXIT_FAILURE;
+
+    setlocale(LC_ALL, "");
+    openlog(LOGGER_TAG, LOG_PID | LOG_CONS, LOG_DAEMON);
+
+    if (argc != 1) {
+        log_error("%s takes no arguments", argv[0]);
+        goto out;
+    }
+
+    if (!determine_country(country))
+        goto out;
+
+    if (set_regulatory_domain(country) != 0)
+        goto out;
+
+    status = EXIT_SUCCESS;
+
+out:
+    closelog();
+    return status;
+}
+
+static void log_error(const char *fmt, ...)
+{
+    va_list ap;
+    va_list copy;
+
+    va_start(ap, fmt);
+    va_copy(copy, ap);
+    vsyslog(LOG_ERR, fmt, ap);
+    va_end(ap);
+    vfprintf(stderr, fmt, copy);
+    fputc('\n', stderr);
+    va_end(copy);
+}
+
+static void log_info(const char *fmt, ...)
+{
+    va_list ap;
+
+    va_start(ap, fmt);
+    vsyslog(LOG_INFO, fmt, ap);
+    va_end(ap);
+}
+
+static char *trim(char *s)
+{
+    if (!s)
+        return s;
+
+    while (isspace((unsigned char)*s))
+        s++;
+
+    if (*s == '\0')
+        return s;
+
+    char *end = s + strlen(s) - 1;
+    while (end > s && isspace((unsigned char)*end)) {
+        *end = '\0';
+        end--;
+    }
+
+    return s;
+}
+
+static void strip_quotes(char *s)
+{
+    size_t len;
+
+    if (!s)
+        return;
+
+    len = strlen(s);
+    if (len < 2)
+        return;
+
+    if ((s[0] == '"' && s[len - 1] == '"') || (s[0] == '\'' && s[len - 1] == '\'')) {
+        memmove(s, s + 1, len - 2);
+        s[len - 2] = '\0';
+    }
+}
+
+static void strip_inline_comment(char *s)
+{
+    bool in_single = false;
+    bool in_double = false;
+
+    if (!s)
+        return;
+
+    for (char *p = s; *p; ++p) {
+        if (*p == '\'' && !in_double) {
+            in_single = !in_single;
+            continue;
+        }
+        if (*p == '"' && !in_single) {
+            in_double = !in_double;
+            continue;
+        }
+        if (*p == '#' && !in_single && !in_double) {
+            if (p == s || isspace((unsigned char)*(p - 1))) {
+                *p = '\0';
+                break;
+            }
+        }
+    }
+}
+
+static void ascii_uppercase_inplace(char *s)
+{
+    if (!s)
+        return;
+
+    for (; *s; ++s) {
+        if (*s >= 'a' && *s <= 'z')
+            *s -= 'a' - 'A';
+    }
+}
+
+static bool valid_country_code(const char *s)
+{
+    size_t len;
+
+    if (!s)
+        return false;
+
+    len = strlen(s);
+    if (len != COUNTRY_LEN)
+        return false;
+
+    if (strcmp(s, "00") == 0)
+        return true;
+
+    for (size_t i = 0; i < len; i++) {
+        if (s[i] < 'A' || s[i] > 'Z')
+            return false;
+    }
+
+    return true;
+}
+
+static enum config_result load_country_from_config(char country[COUNTRY_LEN + 1])
+{
+    FILE *fp;
+    char *line = NULL;
+    size_t cap = 0;
+    enum config_result result = CONFIG_NOT_SET;
+
+    fp = fopen(REGDOMAIN_FILE, "r");
+    if (!fp) {
+        if (errno != ENOENT) {
+            log_error("Could not read %s: %s", REGDOMAIN_FILE, strerror(errno));
+            return CONFIG_ERROR;
+        }
+        return CONFIG_NOT_SET;
+    }
+
+    while (getline(&line, &cap, fp) != -1) {
+        char *work = trim(line);
+        char *key;
+        char *value;
+        char *eq;
+
+        strip_inline_comment(work);
+        if (*work == '\0' || *work == '#')
+            continue;
+
+        if (strncmp(work, "export", 6) == 0 && isspace((unsigned char)work[6]))
+            work = trim(work + 6);
+
+        eq = strchr(work, '=');
+        if (!eq)
+            continue;
+
+        *eq = '\0';
+        key = trim(work);
+        value = trim(eq + 1);
+        strip_quotes(value);
+
+        if (strcmp(key, "COUNTRY") != 0)
+            continue;
+
+        if (*value == '\0') {
+            country[0] = '\0';
+            result = CONFIG_NOT_SET;
+            continue;
+        }
+
+        ascii_uppercase_inplace(value);
+        if (!valid_country_code(value)) {
+            log_error("COUNTRY value '%s' in %s is invalid", value, REGDOMAIN_FILE);
+            result = CONFIG_ERROR;
+            break;
+        }
+
+        memcpy(country, value, COUNTRY_LEN + 1);
+        result = CONFIG_LOADED;
+    }
+
+    if (ferror(fp)) {
+        int saved_errno = errno ? errno : EIO;
+        log_error("Could not read %s: %s", REGDOMAIN_FILE,
+                  strerror(saved_errno));
+        result = CONFIG_ERROR;
+    }
+    if (result == CONFIG_LOADED)
+        log_info("Loaded country %s from config %s", country, REGDOMAIN_FILE);
+
+    free(line);
+    fclose(fp);
+    return result;
+}
+
+static bool resolve_timezone(char *zone_name, size_t len)
+{
+    char resolved[PATH_MAX];
+    size_t prefix_len = strlen(ZONEINFO_PREFIX);
+
+    if (!realpath(LOCALTIME_PATH, resolved))
+        return false;
+
+    if (strncmp(resolved, ZONEINFO_PREFIX, prefix_len) != 0)
+        return false;
+
+    if (resolved[prefix_len] == '\0')
+        return false;
+
+    if (strlen(resolved + prefix_len) >= len) {
+        errno = ENAMETOOLONG;
+        return false;
+    }
+
+    snprintf(zone_name, len, "%s", resolved + prefix_len);
+    return true;
+}
+
+static enum lookup_result lookup_country_by_zone(const char *zone_name,
+                                                 char country[COUNTRY_LEN + 1])
+{
+    FILE *fp = fopen(ZONE_TAB_FILE, "r");
+    char *line = NULL;
+    size_t cap = 0;
+    enum lookup_result result = LOOKUP_NOT_FOUND;
+
+    if (!fp) {
+        log_error("Could not read %s: %s", ZONE_TAB_FILE, strerror(errno));
+        return LOOKUP_ERROR;
+    }
+
+    while (result == LOOKUP_NOT_FOUND && getline(&line, &cap, fp) != -1) {
+        char *cursor;
+        char *cc;
+        char *coordinates;
+        char *zone;
+
+        cursor = trim(line);
+        if (*cursor == '\0' || *cursor == '#')
+            continue;
+
+        cc = strtok(cursor, " \t");
+        coordinates = strtok(NULL, " \t");
+        zone = strtok(NULL, " \t\r\n");
+
+        if (!cc || !coordinates || !zone)
+            continue;
+
+        if (strcmp(zone, zone_name) != 0)
+            continue;
+
+        ascii_uppercase_inplace(cc);
+
+        if (!valid_country_code(cc))
+            continue;
+
+        memcpy(country, cc, COUNTRY_LEN + 1);
+        result = LOOKUP_FOUND;
+    }
+
+    if (ferror(fp)) {
+        int saved_errno = errno ? errno : EIO;
+        log_error("Could not read %s: %s", ZONE_TAB_FILE,
+                  strerror(saved_errno));
+        result = LOOKUP_ERROR;
+    }
+
+    free(line);
+    fclose(fp);
+    return result;
+}
+
+static bool determine_country_from_timezone(char country[COUNTRY_LEN + 1])
+{
+    char zone[PATH_MAX] = {0};
+    enum lookup_result result;
+
+    if (!resolve_timezone(zone, sizeof(zone))) {
+        log_error("Timezone information not found");
+        return false;
+    }
+
+    result = lookup_country_by_zone(zone, country);
+    if (result != LOOKUP_FOUND) {
+        if (result == LOOKUP_NOT_FOUND)
+            log_error("Could not determine country from timezone %s", zone);
+        return false;
+    }
+
+    log_info("Determined country %s from timezone %s", country, zone);
+    return true;
+}
+
+static bool determine_country(char country[COUNTRY_LEN + 1])
+{
+    enum config_result result = load_country_from_config(country);
+
+    if (result == CONFIG_LOADED)
+        return true;
+    if (result == CONFIG_ERROR)
+        return false;
+
+    return determine_country_from_timezone(country);
+}
+
+static int set_regulatory_domain(const char *country)
+{
+    struct nl_sock *sock = NULL;
+    struct nl_msg *msg = NULL;
+    int nl80211_id;
+    int ret = -1;
+
+    sock = nl_socket_alloc();
+    if (!sock) {
+        log_error("Failed to allocate netlink socket");
+        goto out;
+    }
+
+    ret = genl_connect(sock);
+    if (ret < 0) {
+        log_error("Failed to connect to generic netlink: %s", nl_geterror(ret));
+        goto out;
+    }
+
+    nl80211_id = genl_ctrl_resolve(sock, "nl80211");
+    if (nl80211_id < 0) {
+        log_error("Could not resolve nl80211 id: %s", nl_geterror(nl80211_id));
+        goto out;
+    }
+
+    msg = nlmsg_alloc();
+    if (!msg) {
+        log_error("Failed to allocate netlink message");
+        goto out;
+    }
+
+    if (!genlmsg_put(msg, 0, 0, nl80211_id, 0, 0, NL80211_CMD_REQ_SET_REG, 0)) {
+        log_error("Failed to setup netlink message");
+        goto out;
+    }
+
+    ret = nla_put_string(msg, NL80211_ATTR_REG_ALPHA2, country);
+    if (ret < 0) {
+        log_error("Failed to append regulatory domain attribute");
+        goto out;
+    }
+
+    ret = nl_send_auto(sock, msg);
+    if (ret < 0) {
+        log_error("Failed to send netlink message: %s", nl_geterror(ret));
+        goto out;
+    }
+
+    ret = nl_wait_for_ack(sock);
+    if (ret < 0) {
+        log_error("nl80211 ack error: %s", nl_geterror(ret));
+        goto out;
+    }
+
+    ret = 0;
+
+out:
+    if (msg)
+        nlmsg_free(msg);
+    if (sock)
+        nl_socket_free(sock);
+    return ret;
+}
-- 
2.54.0

