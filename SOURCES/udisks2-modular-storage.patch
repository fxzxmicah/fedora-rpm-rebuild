+ * along with this program; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA  02110-1301  USA
+ *
+ */
+
+#include "config.h"
+
+#include <blockdev/mdraid.h>
+#include <src/udisksdaemon.h>
+#include <src/udiskslinuxprovider.h>
+#include <src/udisksstate.h>
+
+#include "udisksmdraidstate.h"
+
+#define STATE_FILE "mdraid"
+#define STATE_TYPE G_VARIANT_TYPE ("a{ta{sv}}")
+
+void
+udisks_mdraid_state_add (UDisksState *state,
+                         dev_t        device,
+                         const gchar *uuid,
+                         uid_t        uid)
+{
+  GVariant *value;
+  GVariantBuilder builder;
+  GVariantBuilder details;
+
+  udisks_state_lock (state);
+  value = udisks_state_get (state, STATE_FILE, STATE_TYPE);
+  g_variant_builder_init (&builder, STATE_TYPE);
+  if (value != NULL)
+    {
+      GVariantIter iter;
+      guint64 number;
+      GVariant *entry;
+
+      g_variant_iter_init (&iter, value);
+      while (g_variant_iter_next (&iter, "{t@a{sv}}", &number, &entry))
+        {
+          if (number != device)
+            g_variant_builder_add (&builder, "{t@a{sv}}", number, g_variant_ref (entry));
+          g_variant_unref (entry);
+        }
+      g_variant_unref (value);
+    }
+
+  g_variant_builder_init (&details, G_VARIANT_TYPE_VARDICT);
+  g_variant_builder_add (&details, "{sv}", "uuid", g_variant_new_string (uuid));
+  g_variant_builder_add (&details, "{sv}", "started-by-uid", g_variant_new_uint32 (uid));
+  g_variant_builder_add (&builder, "{t@a{sv}}", (guint64) device, g_variant_builder_end (&details));
+  udisks_state_set (state, STATE_FILE, STATE_TYPE, g_variant_builder_end (&builder));
+  udisks_state_unlock (state);
+}
+
+gboolean
+udisks_mdraid_state_has (UDisksState *state,
+                         GUdevDevice *device,
+                         const gchar *uuid,
+                         uid_t       *out_uid)
+{
+  GVariant *value;
+  GVariant *entry;
+  GVariantIter iter;
+  guint64 number;
+  BDMDDetailData *array;
+  gboolean found = FALSE;
+  guint32 uid = 0;
+  const gchar *saved_uuid;
+
+  udisks_state_lock (state);
+  value = udisks_state_get (state, STATE_FILE, STATE_TYPE);
+  udisks_state_unlock (state);
+  if (value == NULL)
+    return FALSE;
+
+  g_variant_iter_init (&iter, value);
+  while (g_variant_iter_next (&iter, "{t@a{sv}}", &number, &entry))
+    {
+      found = number == g_udev_device_get_device_number (device) &&
+              g_variant_lookup (entry, "uuid", "&s", &saved_uuid) &&
+              g_strcmp0 (saved_uuid, uuid) == 0 &&
+              g_variant_lookup (entry, "started-by-uid", "u", &uid);
+      g_variant_unref (entry);
+      if (found)
+        break;
+    }
+  g_variant_unref (value);
+  if (!found)
+    return FALSE;
+
+  /* Device numbers are reused. Do not grant ownership of a replacement array
+   * while its uevent is still pending.
+   */
+  array = bd_md_detail (g_udev_device_get_device_file (device), NULL);
+  found = array != NULL && g_strcmp0 (array->uuid, uuid) == 0;
+  if (array != NULL)
+    bd_md_detail_data_free (array);
+  if (found && out_uid != NULL)
+    *out_uid = uid;
+  return found;
+}
+
+/* Called by the core state transaction with the state lock held. */
+void
+udisks_mdraid_state_check (UDisksState  *state,
+                           UDisksDaemon *daemon,
+                           gboolean      check_only,
+                           GArray       *devices)
+{
+  GVariant *value;
+  GVariantIter iter;
+  GVariantBuilder builder;
+  GVariant *entry;
+  guint64 number;
+  gboolean changed = FALSE;
+  GUdevClient *client = udisks_linux_provider_get_udev_client (udisks_daemon_get_linux_provider (daemon));
+
+  value = udisks_state_get (state, STATE_FILE, STATE_TYPE);
+  if (value == NULL)
+    return;
+
+  g_variant_builder_init (&builder, STATE_TYPE);
+  g_variant_iter_init (&iter, value);
+  while (g_variant_iter_next (&iter, "{t@a{sv}}", &number, &entry))
+    {
+      GUdevDevice *device = g_udev_client_query_by_device_number (client, G_UDEV_DEVICE_TYPE_BLOCK, number);
+      const gchar *array_state = device != NULL ? g_udev_device_get_sysfs_attr (device, "md/array_state") : NULL;
+      gboolean active = array_state != NULL && !g_str_equal (array_state, "clear");
+
+      if (check_only && array_state != NULL && !active)
+        {
+          dev_t dev = number;
+
+          g_array_append_val (devices, dev);
+        }
+      if (active || check_only)
+        g_variant_builder_add (&builder, "{t@a{sv}}", number, g_variant_ref (entry));
+      else
+        changed = TRUE;
+      g_variant_unref (entry);
+      g_clear_object (&device);
+    }
+  g_variant_unref (value);
+  if (changed)
+    udisks_state_set (state, STATE_FILE, STATE_TYPE, g_variant_builder_end (&builder));
+  else
+    g_variant_builder_clear (&builder);
+}
