+    0,
+    G_OPTION_ARG_NONE,
+    &opt_unlock_lock_no_user_interaction,
+    "Do not authenticate the user if needed",
+    NULL
+  },
+  {
+    "key-file",
+    0, /* no short option */
+    0,
