+#include "udiskslinuxencrypted.h"
+#include "udiskslinuxencryptedhelpers.h"
+
+struct _UDisksLinuxBlockCrypto
+{
+  UDisksBlockCryptoSkeleton parent_instance;
+  UDisksLinuxModuleCrypto *module;
+  UDisksLinuxBlockObject *object;
+};
+
+typedef struct
+{
+  UDisksBlockCryptoSkeletonClass parent_class;
+} UDisksLinuxBlockCryptoClass;
+
+static void block_crypto_iface_init (UDisksBlockCryptoIface *iface);
+static void module_object_iface_init (UDisksModuleObjectIface *iface);
+
+G_DEFINE_TYPE_WITH_CODE (UDisksLinuxBlockCrypto, udisks_linux_block_crypto, UDISKS_TYPE_BLOCK_CRYPTO_SKELETON,
+                         G_IMPLEMENT_INTERFACE (UDISKS_TYPE_BLOCK_CRYPTO, block_crypto_iface_init)
+                         G_IMPLEMENT_INTERFACE (UDISKS_TYPE_MODULE_OBJECT, module_object_iface_init));
+
+static void
+crypto_lock_free (gpointer data)
+{
+  g_mutex_clear (data);
+  g_free (data);
+}
+
+static void
+udisks_linux_block_crypto_finalize (GObject *object)
+{
+  UDisksLinuxBlockCrypto *crypto = UDISKS_LINUX_BLOCK_CRYPTO (object);
+
+  g_object_unref (crypto->module);
+  G_OBJECT_CLASS (udisks_linux_block_crypto_parent_class)->finalize (object);
+}
+
+static void
+udisks_linux_block_crypto_class_init (UDisksLinuxBlockCryptoClass *klass)
+{
+  G_OBJECT_CLASS (klass)->finalize = udisks_linux_block_crypto_finalize;
+}
+
+static void
+udisks_linux_block_crypto_init (UDisksLinuxBlockCrypto *crypto)
+{
+  g_dbus_interface_skeleton_set_flags (G_DBUS_INTERFACE_SKELETON (crypto),
+                                       G_DBUS_INTERFACE_SKELETON_FLAGS_HANDLE_METHOD_INVOCATIONS_IN_THREAD);
+  udisks_block_crypto_set_backing_device (UDISKS_BLOCK_CRYPTO (crypto), "/");
+}
+
+UDisksBlockCrypto *
+udisks_linux_block_crypto_new (UDisksLinuxModuleCrypto *module,
+                               UDisksLinuxBlockObject  *object)
+{
+  UDisksLinuxBlockCrypto *crypto;
+  UDisksBlock *block = udisks_object_peek_block (UDISKS_OBJECT (object));
+
+  /* The block owns the lock so it remains valid while jobs hold the block,
+   * even if its optional interfaces are detached.
+   */
+  if (g_object_get_data (G_OBJECT (block), "udisks-crypto-lock") == NULL)
+    {
+      GMutex *lock = g_new (GMutex, 1);
+
+      g_mutex_init (lock);
+      g_object_set_data_full (G_OBJECT (block), "udisks-crypto-lock", lock, crypto_lock_free);
+    }
+  crypto = g_object_new (UDISKS_TYPE_LINUX_BLOCK_CRYPTO, NULL);
+  crypto->module = g_object_ref (module);
+  crypto->object = object;
+  return UDISKS_BLOCK_CRYPTO (crypto);
+}
+
+void
+udisks_linux_block_crypto_lock (UDisksBlock *block)
+{
+  g_mutex_lock (g_object_get_data (G_OBJECT (block), "udisks-crypto-lock"));
+}
+
+void
+udisks_linux_block_crypto_unlock (UDisksBlock *block)
+{
+  g_mutex_unlock (g_object_get_data (G_OBJECT (block), "udisks-crypto-lock"));
+}
+
+static gchar *
+get_slave_sysfs_path (const gchar *sysfs_path)
+{
+  gchar *ret = NULL;
+  gchar **slaves;
+  slaves = udisks_daemon_util_resolve_links (sysfs_path, "slaves");
+  if (slaves != NULL && g_strv_length (slaves) == 1)
+    {
+      ret = g_strdup (slaves[0]);
+    }
+
+  g_strfreev (slaves);
+  return ret;
+}
+
+void
+udisks_linux_block_crypto_update (UDisksLinuxBlockCrypto *crypto,
+                                  UDisksLinuxDevice      *device)
+{
+  UDisksBlock *block = udisks_object_peek_block (UDISKS_OBJECT (crypto->object));
+  const UDisksCryptoInfo *info = udisks_linux_module_crypto_get_info (device);
+  const gchar *dm_uuid = g_udev_device_get_property (device->udev_device, "DM_UUID");
+
+  if (info != NULL)
+    {
+      if (info->hidden)
+        {
+          udisks_block_set_id_usage (block, "crypto");
+          udisks_block_set_id_type (block, "crypto_unknown");
+        }
+      if (udisks_block_get_id_uuid (block)[0] == '\0' && info->bitlk != NULL)
+        udisks_block_set_id_uuid (block, info->bitlk->uuid);
+    }
+
+  udisks_block_crypto_set_backing_device (UDISKS_BLOCK_CRYPTO (crypto), "/");
+  if (dm_uuid != NULL && (g_str_has_prefix (dm_uuid, "CRYPT-LUKS") ||
+                          g_str_has_prefix (dm_uuid, "CRYPT-BITLK") ||
+                          g_str_has_prefix (dm_uuid, "CRYPT-TCRYPT")))
+    {
+      gchar *path = get_slave_sysfs_path (g_udev_device_get_sysfs_path (device->udev_device));
+
+      while (path != NULL)
+        {
+          UDisksObject *backing = udisks_daemon_find_block_by_sysfs_path (udisks_module_get_daemon (UDISKS_MODULE (crypto->module)), path);
+          gchar *parent;
+
+          if (backing != NULL)
+            {
+              udisks_block_crypto_set_backing_device (UDISKS_BLOCK_CRYPTO (crypto), g_dbus_object_get_object_path (G_DBUS_OBJECT (backing)));
+              g_object_unref (backing);
+              g_free (path);
+              break;
+            }
+          parent = get_slave_sysfs_path (path);
+          g_free (path);
+          path = parent;
+        }
+    }
+}
+
+static gboolean
+process_uevent (UDisksModuleObject *object,
+                const gchar        *action,
+                UDisksLinuxDevice  *device,
+                gboolean           *keep)
+{
+  *keep = g_strcmp0 (action, "remove") != 0;
+  if (*keep)
+    udisks_linux_block_crypto_update (UDISKS_LINUX_BLOCK_CRYPTO (object), device);
+  return TRUE;
+}
+
+static void
+module_object_iface_init (UDisksModuleObjectIface *iface)
+{
+  iface->process_uevent = process_uevent;
+}
+
+static UDisksObject *
+wait_for_luks_uuid (UDisksDaemon *daemon,
+                    gpointer      user_data)
+{
+  UDisksBlock *block = udisks_object_peek_block (user_data);
+
+  if (g_strcmp0 (udisks_block_get_id_type (block), "crypto_LUKS") != 0 ||
+      udisks_block_get_id_uuid (block)[0] == '\0')
+    return NULL;
+  return g_object_ref (user_data);
+}
+
+/* ---------------------------------------------------------------------------------------------------- */
+
+gboolean
+udisks_linux_block_is_luks (UDisksBlock *block)
+{
+  return g_strcmp0 (udisks_block_get_id_usage (block), "crypto") == 0 &&
+         g_strcmp0 (udisks_block_get_id_type (block), "crypto_LUKS") == 0;
+}
+
+gboolean
+udisks_linux_block_is_tcrypt (UDisksBlock *block)
+{
+  return g_strcmp0 (udisks_block_get_id_usage (block), "crypto") == 0 &&
+         g_strcmp0 (udisks_block_get_id_type (block), "crypto_TCRYPT") == 0;
+}
+
+gboolean
+udisks_linux_block_is_bitlk (UDisksBlock *block)
+{
+  return g_strcmp0 (udisks_block_get_id_usage (block), "crypto") == 0 &&
+         g_strcmp0 (udisks_block_get_id_type (block), "BitLocker") == 0;
+}
+
+gboolean
+udisks_linux_block_is_unknown_crypto (UDisksBlock *block)
+{
+  return g_strcmp0 (udisks_block_get_id_usage (block), "crypto") == 0 &&
+         g_strcmp0 (udisks_block_get_id_type (block), "crypto_unknown") == 0;
+}
+
+static UDisksObject *
+create_luks (UDisksObject  *object,
+             CryptoJobData *data,
+             uid_t          caller_uid,
+             GError       **error)
+{
+  UDisksDaemon *daemon = udisks_linux_block_object_get_daemon (UDISKS_LINUX_BLOCK_OBJECT (object));
+  UDisksBlock *block = udisks_object_peek_block (object);
+
+  UDisksObject *luks_uuid_object;
+  UDisksObject *cleartext_object = NULL;
+  UDisksBlock *cleartext_block = NULL;
+  UDisksLinuxDevice *udev_cleartext_device = NULL;
+
+  GError *l_error = NULL;
+
+  data->device = udisks_block_get_device (block);
+
+  /* Create it */
+  udisks_linux_block_crypto_lock (block);
+  if (!udisks_daemon_launch_threaded_job_sync (daemon,
+                                               object,
+                                               "encrypted-format",
+                                               caller_uid,
+                                               FALSE,
+                                               luks_format_job_func,
+                                               data,
+                                               NULL, /* user_data_free_func */
+                                               NULL, /* cancellable */
+                                               &l_error))
+    {
+      g_set_error (error, UDISKS_ERROR, UDISKS_ERROR_FAILED,
+                   "Error creating LUKS device: %s", l_error->message);
+      g_error_free (l_error);
+      udisks_linux_block_crypto_unlock (block);
+      return NULL;
+    }
+  udisks_linux_block_crypto_unlock (block);
+
+  udisks_linux_block_object_trigger_uevent_sync (UDISKS_LINUX_BLOCK_OBJECT (object), UDISKS_DEFAULT_WAIT_TIMEOUT);
+
+  /* Wait for the UUID to be set */
+  luks_uuid_object = udisks_daemon_wait_for_object_sync (daemon,
+                                                         wait_for_luks_uuid,
+                                                         object,
+                                                         NULL,
+                                                         UDISKS_DEFAULT_WAIT_TIMEOUT,
+                                                         error);
+  if (luks_uuid_object == NULL)
+    {
+      g_prefix_error (error, "Error waiting for LUKS UUID: ");
+      return NULL;
+    }
+  g_object_unref (luks_uuid_object);
+
+  /* Open it */
+  data->read_only = FALSE;
+  data->map_name = g_strdup_printf ("luks-%s", udisks_block_get_id_uuid (block));
+
+  udisks_linux_block_crypto_lock (block);
+  if (!udisks_daemon_launch_threaded_job_sync (daemon,
+                                               object,
+                                               "encrypted-unlock",
+                                               caller_uid,
+                                               FALSE,
+                                               luks_open_job_func,
+                                               data,
+                                               NULL, /* user_data_free_func */
+                                               NULL, /* cancellable */
+                                               &l_error))
+    {
+      g_set_error (error, UDISKS_ERROR, UDISKS_ERROR_FAILED,
+                   "Error opening LUKS device: %s", l_error->message);
+      g_error_free (l_error);
+      g_clear_pointer (&data->map_name, g_free);
+      udisks_linux_block_crypto_unlock (block);
+      return NULL;
+    }
+  udisks_linux_block_crypto_unlock (block);
+  g_clear_pointer (&data->map_name, g_free);
+
+  /* Wait for it */
+  cleartext_object = udisks_daemon_wait_for_object_sync (daemon,
+                                                         udisks_linux_encrypted_find_cleartext_object,
+                                                         (gpointer) g_dbus_object_get_object_path (G_DBUS_OBJECT (object)),
+                                                         NULL,
+                                                         UDISKS_DEFAULT_WAIT_TIMEOUT,
+                                                         error);
+  if (cleartext_object == NULL)
+    {
+      g_prefix_error (error, "Error waiting for LUKS cleartext device: ");
+      return NULL;
+    }
+  cleartext_block = udisks_object_peek_block (cleartext_object);
+
+  /* update the unlocked-crypto-dev file */
+  udev_cleartext_device = udisks_linux_block_object_get_device (UDISKS_LINUX_BLOCK_OBJECT (cleartext_object));
+  udisks_crypto_state_add (udisks_daemon_get_state (daemon),
+                           udisks_block_get_device_number (cleartext_block),
+                           udisks_block_get_device_number (block),
+                           udisks_block_get_id_uuid (block),
+                           g_udev_device_get_sysfs_attr (udev_cleartext_device->udev_device, "dm/uuid"),
+                           caller_uid);
+
+  g_object_unref (udev_cleartext_device);
+  return cleartext_object;
+}
+
+/* runs in thread dedicated to handling method call */
+static gboolean
+handle_restore_header (UDisksBlockCrypto     *interface,
+                       GDBusMethodInvocation *invocation,
+                       const gchar           *backup_file,
+                       GVariant              *options)
+{
+  UDisksObject *object;
+  UDisksBlock *block;
+  UDisksDaemon *daemon;
+  UDisksState *state = NULL;
+  const gchar *action_id;
+  uid_t caller_uid;
+  GError *error = NULL;
+  UDisksBaseJob *job;
+  gboolean restored;
+
+  object = udisks_daemon_util_dup_object (interface, &error);
+  if (object == NULL)
+    goto out;
+  block = udisks_object_peek_block (object);
+  daemon = udisks_linux_block_object_get_daemon (UDISKS_LINUX_BLOCK_OBJECT (object));
+  state = udisks_daemon_get_state (daemon);
+  udisks_linux_block_object_lock_for_cleanup (UDISKS_LINUX_BLOCK_OBJECT (object));
+  udisks_state_check_block (state, udisks_block_get_device_number (block));
+
+  if (!udisks_daemon_util_get_caller_uid_sync (daemon, invocation, NULL, &caller_uid, &error))
+    goto out;
+  action_id = "org.freedesktop.udisks2.modify-device";
+  if (!udisks_daemon_util_setup_by_user (daemon, object, caller_uid))
+    {
+      if (udisks_block_get_hint_system (block))
+        action_id = "org.freedesktop.udisks2.modify-device-system";
+      else if (!udisks_daemon_util_on_user_seat (daemon, object, caller_uid))
+        action_id = "org.freedesktop.udisks2.modify-device-other-seat";
+    }
+  if (!udisks_daemon_util_check_authorization_sync (daemon,
+                                                    object,
+                                                    action_id,
+                                                    options,
+                                                    /* Translators: $(device.name) is a device name placeholder. */
+                                                    N_("Authentication is required to restore the encrypted header on $(device.name)"),
+                                                    invocation))
+    goto out;
+
+  job = udisks_daemon_launch_simple_job (daemon, object, "block-restore-encrypted-header", caller_uid, FALSE, NULL);
+  udisks_linux_block_crypto_lock (block);
+  restored = bd_crypto_luks_header_restore (udisks_block_get_device (block), backup_file, &error);
+  udisks_linux_block_crypto_unlock (block);
+  udisks_simple_job_complete (UDISKS_SIMPLE_JOB (job), restored, error != NULL ? error->message : NULL);
+  if (!restored)
+    {
+      g_prefix_error (&error, "Error restoring encrypted header on %s: ", udisks_block_get_device (block));
+      goto out;
+    }
+  udisks_linux_block_object_trigger_uevent_sync (UDISKS_LINUX_BLOCK_OBJECT (object), UDISKS_DEFAULT_WAIT_TIMEOUT);
+  udisks_block_crypto_complete_restore_header (interface, invocation);
+
+ out:
+  if (error != NULL)
+    g_dbus_method_invocation_take_error (invocation, error);
+  if (object != NULL)
+    udisks_linux_block_object_release_cleanup_lock (UDISKS_LINUX_BLOCK_OBJECT (object));
+  if (state != NULL)
+    udisks_state_check (state);
+  g_clear_object (&object);
+  return TRUE;
+}
+
+/* ---------------------------------------------------------------------------------------------------- */
+
+gboolean
+udisks_crypto_teardown_block (UDisksModule          *module,
+                              UDisksBlock           *block,
+                              GDBusMethodInvocation *invocation,
+                              GVariant              *options,
+                              GError               **error)
+{
+  UDisksObject *object = UDISKS_OBJECT (g_dbus_interface_get_object (G_DBUS_INTERFACE (block)));
+  UDisksDaemon *daemon = udisks_module_get_daemon (module);
+  UDisksEncrypted *encrypted;
+
+  encrypted = udisks_object_peek_encrypted (object);
+  if (encrypted != NULL)
+    {
+      UDisksObject *cleartext = udisks_daemon_find_object (daemon, udisks_encrypted_get_cleartext_device (encrypted));
+
+      if (cleartext != NULL)
+        {
+          gboolean ret = udisks_linux_block_teardown (udisks_object_peek_block (cleartext), invocation, options, error);
+
+          g_object_unref (cleartext);
+          if (!ret || !udisks_linux_encrypted_lock (UDISKS_LINUX_ENCRYPTED (encrypted), invocation, options, error))
+            return FALSE;
+        }
+      else if (!udisks_linux_remove_configuration (daemon, udisks_encrypted_get_child_configuration (encrypted), error))
+        return FALSE;
+    }
+
+  return TRUE;
+}
+
+static gboolean
+handle_format (UDisksBlockCrypto     *interface,
+               GDBusMethodInvocation *invocation,
+               GVariant              *passphrase,
+               GVariant              *options)
+{
+  static const UDisksOptionEntry accepted_options[] =
+  {
+    { "auth.no_user_interaction", "b" },
+    { "type", "s" },
+    { "pbkdf", "s" },
+    { "label", "s" },
+    { "memory", "u" },
+    { "iterations", "u" },
+    { "time", "u" },
+    { "threads", "u" },
+    { "tear-down", "b" },
+    { "update-partition-type", "b" },
+    { NULL, NULL }
+  };
+
+  UDisksLinuxBlockCrypto *crypto = UDISKS_LINUX_BLOCK_CRYPTO (interface);
+  UDisksObject *object;
+  UDisksDaemon *daemon;
+  UDisksBlock *block;
+  UDisksObject *mapping = NULL;
+  GError *error = NULL;
+  uid_t caller_uid;
+  gsize size;
+  const gchar *bytes;
+  CryptoJobData data = { 0, };
+  gboolean teardown = FALSE;
+  gboolean update_partition_type = FALSE;
+
+  object = udisks_daemon_util_dup_object (interface, &error);
+  if (object == NULL)
+    goto out;
+  daemon = udisks_module_get_daemon (UDISKS_MODULE (crypto->module));
+  block = udisks_object_peek_block (object);
+  udisks_linux_block_object_lock_for_cleanup (UDISKS_LINUX_BLOCK_OBJECT (object));
+  udisks_state_check_block (udisks_daemon_get_state (daemon), udisks_block_get_device_number (block));
+
+  if (!udisks_daemon_util_check_options (options, accepted_options, &error))
+    goto out;
+  bytes = g_variant_get_fixed_array (passphrase, &size, 1);
+  if (size == 0)
+    {
+      g_set_error_literal (&error, UDISKS_ERROR, UDISKS_ERROR_FAILED, "The passphrase must not be empty");
+      goto out;
+    }
+  data.passphrase = g_string_new_len (bytes, size);
+  g_variant_lookup (options, "type", "&s", &data.type);
+  g_variant_lookup (options, "pbkdf", "&s", &data.pbkdf);
+  g_variant_lookup (options, "label", "&s", &data.label);
+  g_variant_lookup (options, "memory", "u", &data.memory);
+  g_variant_lookup (options, "iterations", "u", &data.iterations);
+  g_variant_lookup (options, "time", "u", &data.time);
+  g_variant_lookup (options, "threads", "u", &data.threads);
+  g_variant_lookup (options, "tear-down", "b", &teardown);
+  g_variant_lookup (options, "update-partition-type", "b", &update_partition_type);
+
+  if (data.type == NULL)
+    data.type = udisks_linux_module_crypto_get_encryption (crypto->module);
+  if ((!g_str_equal (data.type, "luks1") && !g_str_equal (data.type, "luks2")) ||
+      (data.pbkdf != NULL &&
+       !g_str_equal (data.pbkdf, "pbkdf2") &&
+       !g_str_equal (data.pbkdf, "argon2i") &&
+       !g_str_equal (data.pbkdf, "argon2id")) ||
+      (g_str_equal (data.type, "luks1") &&
+       ((data.pbkdf != NULL && !g_str_equal (data.pbkdf, "pbkdf2")) ||
+        data.memory != 0 || data.threads != 0 || data.label != NULL)))
+    {
+      g_set_error_literal (&error, UDISKS_ERROR, UDISKS_ERROR_NOT_SUPPORTED,
+                           "Unsupported encryption type or key derivation settings");
+      goto out;
+    }
+
+  if (!udisks_daemon_util_get_caller_uid_sync (daemon, invocation, NULL, &caller_uid, &error))
+    goto out;
+  if (!udisks_linux_block_check_format (daemon, block, object, caller_uid, options, invocation, FALSE, FALSE, teardown))
+    goto out;
+  if (teardown && !udisks_linux_block_teardown (block, invocation, options, &error))
+    goto out;
+  if (!udisks_linux_block_wipe (daemon, block, object, &error))
+    goto out;
+  mapping = create_luks (object, &data, caller_uid, &error);
+  if (mapping == NULL)
+    goto out;
+
+  if (update_partition_type)
+    {
+      UDisksPartition *partition = udisks_object_peek_partition (object);
+
+      if (partition != NULL)
+        {
+          UDisksObject *table = udisks_daemon_find_object (daemon, udisks_partition_get_table (partition));
+          UDisksPartitionTable *partition_table = table != NULL ? udisks_object_peek_partition_table (table) : NULL;
+          const gchar *partition_type = NULL;
+
+          if (partition_table != NULL)
+            {
+              if (g_str_equal (udisks_partition_table_get_type_ (partition_table), "gpt"))
+                partition_type = "ca7d7ccb-63ed-4c53-861c-1742536059cc";
+              else if (g_str_equal (udisks_partition_table_get_type_ (partition_table), "dos"))
+                partition_type = "0xe8";
+            }
+          if (partition_type != NULL &&
+              !udisks_linux_partition_set_type_sync (UDISKS_LINUX_PARTITION (partition),
+                                                     partition_type, caller_uid, NULL, &error))
+            {
+              g_clear_object (&table);
+              goto out;
+            }
+          g_clear_object (&table);
+        }
+    }
+  udisks_block_crypto_complete_format (interface, invocation, g_dbus_object_get_object_path (G_DBUS_OBJECT (mapping)));
+
+ out:
+  if (error != NULL)
+    g_dbus_method_invocation_take_error (invocation, error);
+  if (object != NULL)
+    udisks_linux_block_object_release_cleanup_lock (UDISKS_LINUX_BLOCK_OBJECT (object));
+  udisks_string_wipe_and_free (data.passphrase);
+  g_clear_object (&mapping);
+  g_clear_object (&object);
+  return TRUE;
+}
+
+static void
+block_crypto_iface_init (UDisksBlockCryptoIface *iface)
+{
+  iface->handle_format = handle_format;
+  iface->handle_restore_header = handle_restore_header;
+}
