+#include "udisksmdraidstate.h"
+
+struct _UDisksLinuxModuleMDRaid
+{
+  UDisksModule parent_instance;
+
+  /* Exported objects are owned by the base module registry. */
+  GHashTable *uuid_to_mdraid;
+  GHashTable *sysfs_path_to_mdraid;
+  GHashTable *sysfs_path_to_mdraid_members;
+};
+
+typedef struct
+{
+  UDisksModuleClass parent_class;
+} UDisksLinuxModuleMDRaidClass;
+
+static void initable_iface_init (GInitableIface *iface);
+
+gchar *udisks_module_id (void);
+UDisksModule *udisks_module_mdraid_new (UDisksDaemon  *daemon,
+                                        GCancellable  *cancellable,
+                                        GError       **error);
+
+G_DEFINE_TYPE_WITH_CODE (UDisksLinuxModuleMDRaid, udisks_linux_module_mdraid, UDISKS_TYPE_MODULE,
+                         G_IMPLEMENT_INTERFACE (G_TYPE_INITABLE, initable_iface_init));
+
+static gboolean
+initable_init (GInitable    *initable,
+               GCancellable *cancellable,
+               GError      **error)
+{
+  BDPluginSpec plugin = { BD_PLUGIN_MDRAID, NULL };
+  BDPluginSpec *plugins[] = { &plugin, NULL };
+
+  return bd_is_plugin_available (BD_PLUGIN_MDRAID) || bd_reinit (plugins, FALSE, NULL, error);
+}
+
+static void
+initable_iface_init (GInitableIface *iface)
+{
+  iface->init = initable_init;
+}
+
+static void
+mdraid_info_free (gpointer data)
+{
+  UDisksMDRaidInfo *info = data;
+
+  if (info->member != NULL)
+    bd_md_examine_data_free (info->member);
+  if (info->array != NULL)
+    bd_md_detail_data_free (info->array);
+  g_free (info);
+}
+
+const UDisksMDRaidInfo *
+udisks_linux_module_mdraid_get_info (UDisksLinuxDevice *device)
+{
+  return g_object_get_data (G_OBJECT (device), "udisks-mdraid-info");
+}
+
+static void
+probe_device (UDisksModule      *module,
+              UDisksLinuxDevice *device)
+{
+  UDisksMDRaidInfo *info;
+  const gchar *array_state;
+  const gchar *device_file;
+
+  if (g_strcmp0 (g_udev_device_get_subsystem (device->udev_device), "block") != 0)
+    return;
+
+  device_file = g_udev_device_get_device_file (device->udev_device);
+  if (device_file == NULL)
+    return;
+
+  info = g_new0 (UDisksMDRaidInfo, 1);
+  if (g_strcmp0 (g_udev_device_get_property (device->udev_device, "ID_FS_TYPE"), "linux_raid_member") == 0)
+    info->member = bd_md_examine (device_file, NULL);
+  array_state = g_udev_device_get_sysfs_attr (device->udev_device, "md/array_state");
+  if (array_state != NULL && g_strcmp0 (array_state, "clear") != 0)
+    info->array = bd_md_detail (device_file, NULL);
+  if (info->member != NULL && (info->member->uuid == NULL ||
+                               g_str_equal (info->member->uuid, "00000000-0000-0000-0000-000000000000")))
+    g_clear_pointer (&info->member, bd_md_examine_data_free);
+  if (info->array != NULL && (info->array->uuid == NULL ||
+                              g_str_equal (info->array->uuid, "00000000-0000-0000-0000-000000000000")))
+    g_clear_pointer (&info->array, bd_md_detail_data_free);
+  g_object_set_data_full (G_OBJECT (device), "udisks-mdraid-info", info, mdraid_info_free);
+}
+
+static void
+update_array (UDisksLinuxModuleMDRaid *module,
+              GHashTable              *devices,
+              UDisksLinuxDevice       *device,
+              const gchar             *uuid,
+              gboolean                 is_member)
+{
+  const gchar *sysfs_path = g_udev_device_get_sysfs_path (device->udev_device);
+  UDisksLinuxMDRaidObject *object = g_hash_table_lookup (devices, sysfs_path);
+
+  if (object != NULL && g_strcmp0 (uuid, udisks_linux_mdraid_object_get_uuid (object)) != 0)
+    {
+      udisks_linux_mdraid_object_uevent (object, "remove", device, is_member);
+      g_hash_table_remove (devices, sysfs_path);
+      if (!udisks_linux_mdraid_object_have_devices (object))
+        {
+          g_hash_table_remove (module->uuid_to_mdraid, udisks_linux_mdraid_object_get_uuid (object));
+          udisks_module_unexport_object (UDISKS_MODULE (module), G_DBUS_OBJECT_SKELETON (object));
+        }
+      object = NULL;
+    }
+
+  if (uuid == NULL)
+    return;
+
+  if (object == NULL)
+    {
+      object = g_hash_table_lookup (module->uuid_to_mdraid, uuid);
+      if (object == NULL)
+        {
+          object = udisks_linux_mdraid_object_new (module, uuid);
+          udisks_linux_mdraid_object_uevent (object, "add", device, is_member);
+          udisks_module_export_object (UDISKS_MODULE (module), G_DBUS_OBJECT_SKELETON (object));
+          g_hash_table_insert (module->uuid_to_mdraid, g_strdup (uuid), object);
+          g_object_unref (object);
+        }
+      else
+        udisks_linux_mdraid_object_uevent (object, "change", device, is_member);
+      g_hash_table_insert (devices, g_strdup (sysfs_path), object);
+    }
+  else
+    udisks_linux_mdraid_object_uevent (object, "change", device, is_member);
+}
+
+static const gchar *
+get_array_path (GHashTable  *devices,
+                const gchar *sysfs_path)
+{
+  UDisksLinuxMDRaidObject *object = g_hash_table_lookup (devices, sysfs_path);
+
+  return object != NULL ? g_dbus_object_get_object_path (G_DBUS_OBJECT (object)) : "/";
+}
+
+static void
+handle_uevent (UDisksModule      *_module,
+               const gchar       *action,
+               UDisksLinuxDevice *device)
+{
+  UDisksLinuxModuleMDRaid *module = UDISKS_LINUX_MODULE_MDRAID (_module);
+  const gchar *sysfs_path = g_udev_device_get_sysfs_path (device->udev_device);
+  const UDisksMDRaidInfo *info = udisks_linux_module_mdraid_get_info (device);
+  UDisksObject *object;
+  UDisksBlockMDRaid *relation;
+
+  if (g_strcmp0 (action, "remove") == 0)
+    info = NULL;
+  update_array (module, module->sysfs_path_to_mdraid, device, info != NULL && info->array != NULL ? info->array->uuid : NULL, FALSE);
+  update_array (module, module->sysfs_path_to_mdraid_members, device, info != NULL && info->member != NULL ? info->member->uuid : NULL, TRUE);
+
+  object = udisks_daemon_find_block_by_sysfs_path (udisks_module_get_daemon (_module), sysfs_path);
+  if (object == NULL)
+    return;
+
+  relation = udisks_object_get_block_mdraid (object);
+  if (relation != NULL)
+    {
+      g_object_freeze_notify (G_OBJECT (relation));
+      udisks_block_mdraid_set_array (relation, get_array_path (module->sysfs_path_to_mdraid, sysfs_path));
+      udisks_block_mdraid_set_member_of (relation, get_array_path (module->sysfs_path_to_mdraid_members, sysfs_path));
+      g_object_thaw_notify (G_OBJECT (relation));
+    }
+  g_clear_object (&relation);
+  g_object_unref (object);
+}
+
+static GType *
+get_block_object_interface_types (UDisksModule *module)
+{
+  static GType types[2];
+
+  if (g_once_init_enter (&types[0]))
+    g_once_init_leave (&types[0], UDISKS_TYPE_LINUX_BLOCK_MDRAID);
+  return types;
+}
+
+static GDBusInterfaceSkeleton *
+new_block_object_interface (UDisksModule           *module,
+                            UDisksLinuxBlockObject *object,
+                            GType                   interface_type)
+{
+  UDisksLinuxDevice *device = udisks_linux_block_object_get_device (object);
+  GDBusInterfaceSkeleton *interface = NULL;
+
+  if (udisks_linux_block_mdraid_is_device (device))
+    interface = G_DBUS_INTERFACE_SKELETON (udisks_linux_block_mdraid_new ());
+  g_object_unref (device);
+  return interface;
+}
+
+static GDBusInterfaceSkeleton *
+new_manager (UDisksModule *module)
+{
+  return G_DBUS_INTERFACE_SKELETON (udisks_linux_manager_mdraid_new (UDISKS_LINUX_MODULE_MDRAID (module)));
+}
+
+static gchar *
+track_parent (UDisksModule *module,
+              const gchar  *path,
+              gchar       **uuid)
+{
+  UDisksObject *object;
+  UDisksBlockMDRaid *relation;
+  gchar *parent = NULL;
+
+  object = udisks_daemon_find_object (udisks_module_get_daemon (module), path);
+  if (object == NULL)
+    return NULL;
+  relation = udisks_object_get_block_mdraid (object);
+  if (relation != NULL && g_strcmp0 (udisks_block_mdraid_get_array (relation), "/") != 0)
+    {
+      UDisksObject *array = udisks_daemon_find_object (udisks_module_get_daemon (module), udisks_block_mdraid_get_array (relation));
+
+      if (array != NULL)
+        {
+          parent = udisks_block_mdraid_dup_array (relation);
+          *uuid = g_strdup (udisks_linux_mdraid_object_get_uuid (UDISKS_LINUX_MDRAID_OBJECT (array)));
+          g_object_unref (array);
+        }
+    }
+  g_clear_object (&relation);
+  g_object_unref (object);
+  return parent;
+}
+
+static void
+check_state (UDisksModule *module,
+             gboolean      check_only,
+             GArray       *devices)
+{
+  udisks_mdraid_state_check (udisks_daemon_get_state (udisks_module_get_daemon (module)),
+                             udisks_module_get_daemon (module), check_only, devices);
+}
+
+static gboolean
+setup_by_user (UDisksModule *module,
+               UDisksObject *object,
+               uid_t         user)
+{
+  UDisksBlockMDRaid *relation = udisks_object_get_block_mdraid (object);
+  UDisksObject *array;
+  UDisksLinuxDevice *device;
+  uid_t owner;
+  gboolean ret = FALSE;
+
+  if (relation == NULL)
+    return FALSE;
+  array = udisks_daemon_find_object (udisks_module_get_daemon (module), udisks_block_mdraid_get_array (relation));
+  device = UDISKS_IS_LINUX_BLOCK_OBJECT (object) ? udisks_linux_block_object_get_device (UDISKS_LINUX_BLOCK_OBJECT (object)) : NULL;
+  if (array != NULL && device != NULL)
+    ret = udisks_mdraid_state_has (udisks_daemon_get_state (udisks_module_get_daemon (module)), device->udev_device,
+                                   udisks_linux_mdraid_object_get_uuid (UDISKS_LINUX_MDRAID_OBJECT (array)), &owner) && owner == user;
+  g_clear_object (&device);
+  g_clear_object (&array);
+  g_object_unref (relation);
+  return ret;
+}
+
+static void
+udisks_linux_module_mdraid_finalize (GObject *object)
+{
+  UDisksLinuxModuleMDRaid *module = UDISKS_LINUX_MODULE_MDRAID (object);
+
+  g_hash_table_unref (module->uuid_to_mdraid);
+  g_hash_table_unref (module->sysfs_path_to_mdraid);
+  g_hash_table_unref (module->sysfs_path_to_mdraid_members);
+  G_OBJECT_CLASS (udisks_linux_module_mdraid_parent_class)->finalize (object);
+}
+
+static void
+udisks_linux_module_mdraid_class_init (UDisksLinuxModuleMDRaidClass *klass)
+{
+  UDisksModuleClass *module_class = UDISKS_MODULE_CLASS (klass);
+
+  G_OBJECT_CLASS (klass)->finalize = udisks_linux_module_mdraid_finalize;
+  module_class->get_block_object_interface_types = get_block_object_interface_types;
+  module_class->new_block_object_interface = new_block_object_interface;
+  module_class->probe_device = probe_device;
+  module_class->handle_uevent = handle_uevent;
+  module_class->new_manager = new_manager;
+  module_class->track_parent = track_parent;
+  module_class->check_state = check_state;
+  module_class->setup_by_user = setup_by_user;
+}
+
+static void
+udisks_linux_module_mdraid_init (UDisksLinuxModuleMDRaid *module)
+{
+  module->uuid_to_mdraid = g_hash_table_new_full (g_str_hash, g_str_equal, g_free, NULL);
+  module->sysfs_path_to_mdraid = g_hash_table_new_full (g_str_hash, g_str_equal, g_free, NULL);
+  module->sysfs_path_to_mdraid_members = g_hash_table_new_full (g_str_hash, g_str_equal, g_free, NULL);
+}
+
+gchar *
+udisks_module_id (void)
+{
