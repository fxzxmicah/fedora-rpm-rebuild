+  interface = g_dbus_object_get_interface (G_DBUS_OBJECT (object), "org.freedesktop.UDisks2.Encrypted");
+  if (interface != NULL)
+    g_object_unref (interface);
+
+  return interface != NULL ? UDISKS_ENCRYPTED (interface) : NULL;
+}
+
+/**
+ * udisks_crypto_get_cleartext_block:
+ * @client: a client
+ * @block: an encrypted container
+ *
+ * Returns: (transfer full) (nullable): the unlocked block device
+ */
+UDisksBlock *
+udisks_crypto_get_cleartext_block (UDisksClient *client,
+                                   UDisksBlock  *block)
+{
+  UDisksObject *object;
+  UDisksEncrypted *encrypted;
+  UDisksBlock *cleartext = NULL;
+
+  object = UDISKS_OBJECT (g_dbus_interface_dup_object (G_DBUS_INTERFACE (block)));
+  if (object == NULL)
+    return NULL;
+  encrypted = udisks_object_get_encrypted (object);
+  if (encrypted != NULL)
+    {
+      UDisksObject *mapping = udisks_client_get_object (client, udisks_encrypted_get_cleartext_device (encrypted));
+
+      if (mapping != NULL)
+        cleartext = udisks_object_get_block (mapping);
+      g_clear_object (&mapping);
+      g_object_unref (encrypted);
+    }
+  g_object_unref (object);
+  return cleartext;
+}
+
+/**
+ * udisks_crypto_get_backing_block:
+ * @client: a client
+ * @block: a cleartext mapping
+ *
+ * Returns: (transfer full) (nullable): the encrypted backing block device
+ */
+UDisksBlock *
+udisks_crypto_get_backing_block (UDisksClient *client,
+                                 UDisksBlock  *block)
+{
+  UDisksObject *object;
+  UDisksBlockCrypto *crypto;
+  UDisksBlock *backing = NULL;
+
+  object = UDISKS_OBJECT (g_dbus_interface_dup_object (G_DBUS_INTERFACE (block)));
+  if (object == NULL)
+    return NULL;
+  crypto = udisks_object_get_block_crypto (object);
+  if (crypto != NULL)
+    {
+      UDisksObject *container = udisks_client_get_object (client, udisks_block_crypto_get_backing_device (crypto));
+
+      if (container != NULL)
+        backing = udisks_object_get_block (container);
+      g_clear_object (&container);
+      g_object_unref (crypto);
+    }
+  g_object_unref (object);
+  return backing;
+}
+
+static const UDisksClientID ids[] =
+{
+  {"crypto",     "crypto_unknown",    NULL,    NC_("fs-type", "Possibly Encrypted"),                NC_("fs-type", "Encrypted?")},
+  {"crypto",     "crypto_LUKS",       "*",     NC_("fs-type", "LUKS Encryption (version %s)"),      NC_("fs-type", "LUKS")},
+  {"crypto",     "crypto_LUKS",       NULL,    NC_("fs-type", "LUKS Encryption"),                   NC_("fs-type", "LUKS")},
+  {"crypto",     "crypto_TCRYPT",     NULL,    NC_("fs-type", "VeraCrypt/TrueCrypt Encryption"),    NC_("fs-type", "VeraCrypt/TrueCrypt")},
+  {"crypto",     "BitLocker",         NULL,    NC_("fs-type", "BitLocker Encryption"),              NC_("fs-type", "BitLocker")},
+  { NULL, NULL, NULL, NULL, NULL }
+};
+
+static const UDisksClientJob jobs[] =
+{
+  { "encrypted-format", NC_("job", "Creating Encrypted Device") },
+  { "encrypted-unlock", NC_("job", "Unlocking Device") },
+  { "encrypted-lock", NC_("job", "Locking Device") },
+  { "encrypted-modify", NC_("job", "Modifying Encrypted Device") },
+  { "encrypted-resize", NC_("job", "Resizing Encrypted Device") },
+  { "encrypted-convert", NC_("job", "Converting Encrypted Device") },
+  { "encrypted-header-backup", NC_("job", "Backing Up Header of an Encrypted Device") },
+  { "block-restore-encrypted-header", NC_("job", "Restoring Header of an Encrypted Device") },
+  { NULL, NULL }
+};
+
+static const UDisksClientInterface interfaces[] =
+{
+  { "org.freedesktop.UDisks2.Manager.Crypto", udisks_manager_crypto_proxy_get_type },
+  { "org.freedesktop.UDisks2.Block.Crypto", udisks_block_crypto_proxy_get_type },
+  { "org.freedesktop.UDisks2.Encrypted", udisks_encrypted_proxy_get_type },
+  { NULL, NULL }
+};
+
+const UDisksClientModule *
+_udisks_client_module_query (void)
+{
+  static const UDisksClientModule module =
+  {
+    .interfaces = interfaces,
+    .ids = ids,
+    .jobs = jobs
+  };
+
+  return &module;
+}
