+static gchar *
+read_passphrase (void)
+{
+  struct termios ts, ots;
+  gint fd;
+  GString *str;
+  gchar *ret = NULL;
+  gchar c;
+  ssize_t n_read;
+
+  fd = open ("/dev/tty", O_RDWR | O_CLOEXEC);
+  if (fd == -1)
+    {
+      g_printerr ("Cannot open the controlling terminal: %m\n");
+      return NULL;
+    }
+  if (tcgetattr (fd, &ots) != 0)
+    {
+      g_printerr ("Cannot read terminal settings: %m\n");
+      goto out;
+    }
+  ts = ots;
+  ts.c_lflag &= ~(ECHO | ECHOE | ECHOK | ECHONL);
+  if (tcsetattr (fd, TCSAFLUSH, &ts) != 0)
+    {
+      g_printerr ("Cannot disable terminal echo: %m\n");
+      goto out;
+    }
+
+  dprintf (fd, "Passphrase: ");
+  str = g_string_new (NULL);
+  while (TRUE)
+    {
+      n_read = read (fd, &c, 1);
+      if (n_read == -1 && errno == EINTR)
+        continue;
+      if (n_read != 1 || c == '\n')
+        break;
+      g_string_append_c (str, c);
+    }
+  if (n_read == -1)
+    g_printerr ("Cannot read the passphrase: %m\n");
+  else if (n_read == 0)
+    g_printerr ("End of input while reading the passphrase.\n");
+
+  if (tcsetattr (fd, TCSAFLUSH, &ots) != 0)
+    g_printerr ("Cannot restore terminal settings: %m\n");
+  dprintf (fd, "\n");
+  if (n_read == 1)
+    ret = g_string_free (str, FALSE);
+  else
+    g_string_free (str, TRUE);
+
+ out:
+  close (fd);
+  return ret;
+}
+
+static gboolean
+encrypted_is_unlocked (UDisksObject *object)
+{
+  UDisksEncrypted *encrypted = udisks_object_peek_encrypted (object);
+
+  return encrypted != NULL && g_strcmp0 (udisks_encrypted_get_cleartext_device (encrypted), "/") != 0;
+}
+
+static gchar   *opt_unlock_lock_object_path = NULL;
+static gchar   *opt_unlock_lock_device = NULL;
+static gboolean opt_unlock_lock_no_user_interaction = FALSE;
+static gchar   *opt_unlock_keyfile = NULL;
+static gboolean opt_unlock_read_only = FALSE;
+
+static const GOptionEntry command_unlock_entries[] =
+{
+  {
