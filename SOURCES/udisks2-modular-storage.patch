+  { "org.freedesktop.UDisks2.LogicalVolume", udisks_logical_volume_proxy_get_type },
+  { "org.freedesktop.UDisks2.VDOVolume", udisks_vdo_volume_proxy_get_type },
+  { NULL, NULL }
