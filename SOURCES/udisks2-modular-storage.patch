+ * Free Software Foundation, Inc., 59 Temple Place, Suite 330,
+ * Boston, MA 02111-1307, USA.
+ */
+
+#include "config.h"
+
+#include <gmodule.h>
+
+#include "udisks-generated.h"
+#include "udisksclientmodule.h"
+
+const GArray *
+_udisks_client_get_modules (void)
+{
+  static gsize initialized;
+  static GArray *modules;
+
+  if (g_once_init_enter (&initialized))
+    {
+      GDir *directory;
+      const gchar *name;
+      const gchar *module_dir;
+      GError *error = NULL;
+
+      modules = g_array_new (FALSE, FALSE, sizeof (const UDisksClientModule *));
+      module_dir = g_getenv ("UDISKS2_CLIENT_MODULE_DIR");
+      if (module_dir == NULL)
+        module_dir = PACKAGE_LIB_DIR "/udisks2/client-modules";
+      directory = g_dir_open (module_dir, 0, &error);
+      if (directory != NULL)
+        {
+          while ((name = g_dir_read_name (directory)) != NULL)
+            {
+              gchar *path;
+              GModule *module;
+              const UDisksClientModule *(*query) (void);
+
+              if (!g_str_has_prefix (name, "libudisks2-") ||
+                  !g_str_has_suffix (name, "." G_MODULE_SUFFIX))
+                continue;
+
+              path = g_build_filename (module_dir, name, NULL);
+              module = g_module_open (path, G_MODULE_BIND_LAZY | G_MODULE_BIND_LOCAL);
+              if (module == NULL)
+                g_warning ("Unable to load UDisks client module %s: %s", path, g_module_error ());
+              else if (!g_module_symbol (module, "_udisks_client_module_query", (gpointer *) &query))
+                {
+                  g_warning ("Invalid UDisks client module %s: %s", path, g_module_error ());
+                  g_module_close (module);
+                }
+              else
+                {
+                  /* Proxy GTypes are static and may outlive every client. */
+                  const UDisksClientModule *info = query ();
+
+                  g_module_make_resident (module);
+                  g_array_append_val (modules, info);
+                  g_module_close (module);
+                }
+              g_free (path);
+            }
+          g_dir_close (directory);
+        }
+      else if (!g_error_matches (error, G_FILE_ERROR, G_FILE_ERROR_NOENT))
+        g_warning ("Unable to enumerate UDisks client modules: %s", error->message);
+      g_clear_error (&error);
+      g_once_init_leave (&initialized, 1);
+    }
+
+  return modules;
+}
+
+GType
+_udisks_client_get_proxy_type (GDBusObjectManagerClient *manager,
+                               const gchar             *object_path,
+                               const gchar             *interface_name,
+                               gpointer                 user_data)
+{
+  const GArray *modules;
+  guint n;
+
+  if (interface_name != NULL)
+    {
+      modules = _udisks_client_get_modules ();
+      for (n = 0; n < modules->len; n++)
+        {
+          const UDisksClientModule *module = g_array_index (modules, const UDisksClientModule *, n);
+          const UDisksClientInterface *interface;
+
+          for (interface = module->interfaces; interface->name != NULL; interface++)
+            if (g_str_equal (interface_name, interface->name))
+              return interface->get_type ();
+        }
+    }
+
+  return udisks_object_manager_client_get_proxy_type (manager, object_path, interface_name, user_data);
+}
+
+UDisksObjectInfo *
+_udisks_client_get_module_object_info (UDisksClient *client,
+                                       UDisksObject *object)
+{
+  const GArray *modules = _udisks_client_get_modules ();
+  guint n;
+
+  for (n = 0; n < modules->len; n++)
+    {
+      const UDisksClientModule *module = g_array_index (modules, const UDisksClientModule *, n);
+
+      if (module->get_object_info != NULL)
+        {
+          UDisksObjectInfo *info = module->get_object_info (client, object);
+
+          if (info != NULL)
+            return info;
+        }
+    }
+  return NULL;
+}
