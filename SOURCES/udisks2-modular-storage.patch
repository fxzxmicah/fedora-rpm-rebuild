--- /dev/null
+++ b/udisks/udisksclientmodule.c
@@ -0,0 +1,135 @@
+/* -*- mode: C; c-file-style: "gnu"; indent-tabs-mode: nil; -*- */
+/*
+ * Copyright (C) 2011 David Zeuthen <zeuthen@gmail.com>
+ *
