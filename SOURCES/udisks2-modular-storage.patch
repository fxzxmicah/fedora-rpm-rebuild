index 0000000..bc955b3
--- /dev/null
+++ b/modules/crypto/udiskscryptostate.c
@@ -0,0 +1,222 @@
+/* -*- mode: C; c-file-style: "gnu"; indent-tabs-mode: nil; -*-
+ *
+ * Copyright (C) 2008-2010 David Zeuthen <zeuthen@gmail.com>
+ *
