+/**
+ * udisks_object_get_manager_btrfs:
+ * @object: a UDisks object
+ *
+ * Gets the #UDisksManagerBTRFS interface of @object, if present.
+ *
+ * Returns: (transfer full) (nullable): the interface
+ */
+UDisksManagerBTRFS *
+udisks_object_get_manager_btrfs (UDisksObject *object)
+{
+  GDBusInterface *interface;
+
+  interface = g_dbus_object_get_interface (G_DBUS_OBJECT (object), "org.freedesktop.UDisks2.Manager.BTRFS");
+
+  return interface != NULL ? UDISKS_MANAGER_BTRFS (interface) : NULL;
+}
+
+/**
+ * udisks_object_peek_manager_btrfs:
+ * @object: a UDisks object
+ *
+ * Gets the #UDisksManagerBTRFS interface of @object, if present.
+ *
+ * Returns: (transfer none) (nullable): the interface
+ */
+UDisksManagerBTRFS *
+udisks_object_peek_manager_btrfs (UDisksObject *object)
+{
+  GDBusInterface *interface;
+
+  interface = g_dbus_object_get_interface (G_DBUS_OBJECT (object), "org.freedesktop.UDisks2.Manager.BTRFS");
+  if (interface != NULL)
+    g_object_unref (interface);
+
+  return interface != NULL ? UDISKS_MANAGER_BTRFS (interface) : NULL;
+}
+
+/**
+ * udisks_object_get_filesystem_btrfs:
+ * @object: a UDisks object
+ *
+ * Gets the #UDisksFilesystemBTRFS interface of @object, if present.
+ *
+ * Returns: (transfer full) (nullable): the interface
+ */
+UDisksFilesystemBTRFS *
+udisks_object_get_filesystem_btrfs (UDisksObject *object)
+{
+  GDBusInterface *interface;
+
+  interface = g_dbus_object_get_interface (G_DBUS_OBJECT (object), "org.freedesktop.UDisks2.Filesystem.BTRFS");
+
+  return interface != NULL ? UDISKS_FILESYSTEM_BTRFS (interface) : NULL;
+}
+
+/**
+ * udisks_object_peek_filesystem_btrfs:
+ * @object: a UDisks object
+ *
+ * Gets the #UDisksFilesystemBTRFS interface of @object, if present.
+ *
+ * Returns: (transfer none) (nullable): the interface
+ */
+UDisksFilesystemBTRFS *
+udisks_object_peek_filesystem_btrfs (UDisksObject *object)
+{
+  GDBusInterface *interface;
+
+  interface = g_dbus_object_get_interface (G_DBUS_OBJECT (object), "org.freedesktop.UDisks2.Filesystem.BTRFS");
+  if (interface != NULL)
+    g_object_unref (interface);
+
+  return interface != NULL ? UDISKS_FILESYSTEM_BTRFS (interface) : NULL;
+}
+
+static const UDisksClientInterface interfaces[] =
+{
+  { "org.freedesktop.UDisks2.Manager.BTRFS", udisks_manager_btrfs_proxy_get_type },
+  { "org.freedesktop.UDisks2.Filesystem.BTRFS", udisks_filesystem_btrfs_proxy_get_type },
+  { NULL, NULL }
+};
+
+const UDisksClientModule *
+_udisks_client_module_query (void)
+{
+  static const UDisksClientModule module = { .interfaces = interfaces };
+
+  return &module;
+}
