+ * along with this program; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA  02110-1301  USA
+ *
+ */
+
+#include "config.h"
+
+#include <blockdev/crypto.h>
+#include <src/udisksdaemon.h>
+#include <src/udiskslinuxprovider.h>
+#include <src/udiskslogging.h>
+#include <src/udisksstate.h>
+
+#include "udiskscryptostate.h"
+#include "udiskslinuxencryptedhelpers.h"
+
+#define STATE_FILE "unlocked-crypto-dev"
+#define STATE_TYPE G_VARIANT_TYPE ("a{ta{sv}}")
+
+void
+udisks_crypto_state_add (UDisksState *state,
+                         dev_t        cleartext_device,
+                         dev_t        backing_device,
+                         const gchar *backing_uuid,
+                         const gchar *dm_uuid,
+                         uid_t        uid)
+{
+  GVariantBuilder builder;
+  GVariantBuilder details;
+  GVariant *value;
+
+  udisks_state_lock (state);
+  value = udisks_state_get (state, STATE_FILE, STATE_TYPE);
+  g_variant_builder_init (&builder, STATE_TYPE);
+  if (value != NULL)
+    {
+      GVariantIter iter;
+      GVariant *entry;
+      guint64 number;
+
+      g_variant_iter_init (&iter, value);
+      while (g_variant_iter_next (&iter, "{t@a{sv}}", &number, &entry))
+        {
+          if (number != cleartext_device)
+            g_variant_builder_add (&builder, "{t@a{sv}}", number, g_variant_ref (entry));
+          g_variant_unref (entry);
+        }
+      g_variant_unref (value);
+    }
+  g_variant_builder_init (&details, G_VARIANT_TYPE_VARDICT);
+  g_variant_builder_add (&details, "{sv}", "backing-device", g_variant_new_uint64 (backing_device));
+  g_variant_builder_add (&details, "{sv}", "backing-uuid", g_variant_new_string (backing_uuid));
+  g_variant_builder_add (&details, "{sv}", "dm-uuid", g_variant_new_string (dm_uuid));
+  g_variant_builder_add (&details, "{sv}", "unlocked-by-uid", g_variant_new_uint32 (uid));
+  g_variant_builder_add (&builder, "{t@a{sv}}", (guint64) cleartext_device, g_variant_builder_end (&details));
+  udisks_state_set (state, STATE_FILE, STATE_TYPE, g_variant_builder_end (&builder));
+  udisks_state_unlock (state);
+}
+
+static GUdevDevice *
+get_mapping (UDisksDaemon *daemon,
+             dev_t         number,
+             const gchar  *uuid)
+{
+  GUdevClient *client = udisks_linux_provider_get_udev_client (udisks_daemon_get_linux_provider (daemon));
+  GUdevDevice *device = g_udev_client_query_by_device_number (client, G_UDEV_DEVICE_TYPE_BLOCK, number);
+
+  if (device != NULL && g_strcmp0 (g_udev_device_get_sysfs_attr (device, "dm/uuid"), uuid) != 0)
+    g_clear_object (&device);
+  return device;
+}
+
+dev_t
+udisks_crypto_state_find (UDisksState  *state,
+                          UDisksDaemon *daemon,
+                          dev_t         backing_device,
+                          const gchar  *backing_uuid,
+                          uid_t        *out_uid)
+{
+  GVariant *value;
+  GVariantIter iter;
+  GVariant *entry;
+  guint64 number;
+  dev_t ret = 0;
+
+  udisks_state_lock (state);
+  value = udisks_state_get (state, STATE_FILE, STATE_TYPE);
+  udisks_state_unlock (state);
+  if (value == NULL)
+    return 0;
+
+  g_variant_iter_init (&iter, value);
+  while (g_variant_iter_next (&iter, "{t@a{sv}}", &number, &entry))
+    {
+      guint64 saved_device;
+      const gchar *saved_uuid;
+      const gchar *dm_uuid;
+      guint32 uid;
+
+      if (g_variant_lookup (entry, "backing-device", "t", &saved_device) && saved_device == backing_device &&
+          g_variant_lookup (entry, "backing-uuid", "&s", &saved_uuid) && g_strcmp0 (saved_uuid, backing_uuid) == 0 &&
+          g_variant_lookup (entry, "dm-uuid", "&s", &dm_uuid) &&
+          g_variant_lookup (entry, "unlocked-by-uid", "u", &uid))
+        {
+          GUdevDevice *device = get_mapping (daemon, number, dm_uuid);
+
+          if (device != NULL)
+            {
+              ret = number;
+              if (out_uid != NULL)
+                *out_uid = uid;
+              g_object_unref (device);
+            }
+        }
+      g_variant_unref (entry);
+      if (ret != 0)
+        break;
+    }
+  g_variant_unref (value);
+  return ret;
+}
+
+static gboolean
+check_entry (UDisksDaemon *daemon,
+             dev_t         number,
+             GVariant     *entry,
+             gboolean      check_only,
+             GArray       *devices)
+{
+  guint64 backing_device;
+  const gchar *dm_uuid;
+  GUdevDevice *mapping;
+  GUdevDevice *backing;
+  GUdevClient *client = udisks_linux_provider_get_udev_client (udisks_daemon_get_linux_provider (daemon));
+  gboolean keep = FALSE;
+
+  if (!g_variant_lookup (entry, "backing-device", "t", &backing_device) ||
+      !g_variant_lookup (entry, "dm-uuid", "&s", &dm_uuid))
+    return FALSE;
+
+  mapping = get_mapping (daemon, number, dm_uuid);
+  if (mapping == NULL)
+    return FALSE;
+  backing = g_udev_client_query_by_device_number (client, G_UDEV_DEVICE_TYPE_BLOCK, backing_device);
+  if (backing != NULL)
+    keep = TRUE;
+  else if (check_only)
+    g_array_append_val (devices, number);
+  else
+    {
+      CryptoJobData data = { 0, };
+      UDisksThreadedJobFunc close_func = luks_close_job_func;
+      GError *error = NULL;
+
+      data.map_name = (gchar *) g_udev_device_get_device_file (mapping);
+      if (g_str_has_prefix (dm_uuid, "CRYPT-BITLK"))
+        close_func = bitlk_close_job_func;
+      else if (g_str_has_prefix (dm_uuid, "CRYPT-TCRYPT"))
+        close_func = tcrypt_close_job_func;
+      if (!udisks_daemon_launch_threaded_job_sync (daemon, NULL, "cleanup", 0, FALSE,
+                                                   close_func, &data, NULL, NULL, &error))
+        {
+          udisks_warning ("Unable to close encrypted mapping %s: %s", data.map_name, error->message);
+          g_error_free (error);
+          keep = TRUE;
+        }
+    }
+  g_clear_object (&backing);
+  g_object_unref (mapping);
+  return keep;
+}
+
+/* The core holds the state transaction lock across both cleanup phases. */
+void
+udisks_crypto_state_check (UDisksState  *state,
+                           UDisksDaemon *daemon,
+                           gboolean      check_only,
+                           GArray       *devices)
+{
+  GVariant *value;
+  GVariantIter iter;
+  GVariantBuilder builder;
+  GVariant *entry;
+  guint64 number;
+  gboolean changed = FALSE;
+
+  value = udisks_state_get (state, STATE_FILE, STATE_TYPE);
+  if (value == NULL)
+    return;
+  g_variant_iter_init (&iter, value);
+  g_variant_builder_init (&builder, STATE_TYPE);
+  while (g_variant_iter_next (&iter, "{t@a{sv}}", &number, &entry))
+    {
+      gboolean keep = check_entry (daemon, number, entry, check_only, devices);
+
+      if (keep || check_only)
+        g_variant_builder_add (&builder, "{t@a{sv}}", number, g_variant_ref (entry));
+      else
+        changed = TRUE;
+      g_variant_unref (entry);
+    }
+  g_variant_unref (value);
+  if (changed)
+    udisks_state_set (state, STATE_FILE, STATE_TYPE, g_variant_builder_end (&builder));
+  else
+    g_variant_builder_clear (&builder);
+}
