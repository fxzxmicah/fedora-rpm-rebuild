+static gchar *
+get_id_for_display (const UDisksClientID *table,
+                    const gchar          *usage,
+                    const gchar          *type,
+                    const gchar          *version,
+                    gboolean              long_string)
+{
+  for (; table->usage != NULL; table++)
+    {
+      const gchar *name;
+
+      if (g_strcmp0 (table->usage, usage) != 0 || g_strcmp0 (table->type, type) != 0)
+        continue;
+      if (g_strcmp0 (table->version, *version != '\0' ? version : NULL) != 0 &&
+          !(g_strcmp0 (table->version, "*") == 0 && *version != '\0'))
+        continue;
+
+      name = g_dpgettext2 (GETTEXT_PACKAGE, "fs-type", long_string ? table->long_name : table->short_name);
+      if (*version == '\0')
+        return g_strdup (name);
+
+      /* These translated formats come from the in-tree description tables. */
+#pragma GCC diagnostic push
+#pragma GCC diagnostic ignored "-Wformat-nonliteral"
+      return g_strdup_printf (name, version);
+#pragma GCC diagnostic pop
+    }
+  return NULL;
+}
