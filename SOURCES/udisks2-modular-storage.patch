+ * This library is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General
+ * Public License along with this library; if not, write to the
+ * Free Software Foundation, Inc., 59 Temple Place, Suite 330,
+ * Boston, MA 02111-1307, USA.
+ */
+
+#include "config.h"
+
+#include <glib/gi18n-lib.h>
+
+#include "udisks-mdraid.h"
+#include "udisksclientmodule.h"
+#include "udisksobjectinfo-private.h"
+
+/**
+ * udisks_object_get_manager_mdraid:
+ * @object: a UDisks object
+ *
+ * Gets the #UDisksManagerMDRaid interface of @object, if present.
+ *
+ * Returns: (transfer full) (nullable): the interface
+ */
+UDisksManagerMDRaid *
+udisks_object_get_manager_mdraid (UDisksObject *object)
+{
+  GDBusInterface *interface;
+
+  interface = g_dbus_object_get_interface (G_DBUS_OBJECT (object), "org.freedesktop.UDisks2.Manager.MDRaid");
+
+  return interface != NULL ? UDISKS_MANAGER_MDRAID (interface) : NULL;
+}
+
+/**
+ * udisks_object_peek_manager_mdraid:
+ * @object: a UDisks object
+ *
+ * Gets the #UDisksManagerMDRaid interface of @object, if present.
+ *
+ * Returns: (transfer none) (nullable): the interface
+ */
+UDisksManagerMDRaid *
+udisks_object_peek_manager_mdraid (UDisksObject *object)
+{
+  GDBusInterface *interface;
+
+  interface = g_dbus_object_get_interface (G_DBUS_OBJECT (object), "org.freedesktop.UDisks2.Manager.MDRaid");
+  if (interface != NULL)
+    g_object_unref (interface);
+
+  return interface != NULL ? UDISKS_MANAGER_MDRAID (interface) : NULL;
+}
+
+/**
+ * udisks_object_get_block_mdraid:
+ * @object: a UDisks object
+ *
+ * Gets the #UDisksBlockMDRaid interface of @object, if present.
+ *
+ * Returns: (transfer full) (nullable): the interface
+ */
+UDisksBlockMDRaid *
+udisks_object_get_block_mdraid (UDisksObject *object)
+{
+  GDBusInterface *interface;
+
+  interface = g_dbus_object_get_interface (G_DBUS_OBJECT (object), "org.freedesktop.UDisks2.Block.MDRaid");
+
+  return interface != NULL ? UDISKS_BLOCK_MDRAID (interface) : NULL;
+}
+
+/**
+ * udisks_object_peek_block_mdraid:
+ * @object: a UDisks object
+ *
+ * Gets the #UDisksBlockMDRaid interface of @object, if present.
+ *
+ * Returns: (transfer none) (nullable): the interface
+ */
+UDisksBlockMDRaid *
+udisks_object_peek_block_mdraid (UDisksObject *object)
+{
+  GDBusInterface *interface;
+
+  interface = g_dbus_object_get_interface (G_DBUS_OBJECT (object), "org.freedesktop.UDisks2.Block.MDRaid");
+  if (interface != NULL)
+    g_object_unref (interface);
+
+  return interface != NULL ? UDISKS_BLOCK_MDRAID (interface) : NULL;
+}
+
+/**
+ * udisks_object_get_mdraid:
+ * @object: a UDisks object
+ *
+ * Gets the #UDisksMDRaid interface of @object, if present.
+ *
+ * Returns: (transfer full) (nullable): the interface
+ */
+UDisksMDRaid *
+udisks_object_get_mdraid (UDisksObject *object)
+{
+  GDBusInterface *interface;
+
+  interface = g_dbus_object_get_interface (G_DBUS_OBJECT (object), "org.freedesktop.UDisks2.MDRaid");
+
+  return interface != NULL ? UDISKS_MDRAID (interface) : NULL;
+}
+
+/**
+ * udisks_object_peek_mdraid:
+ * @object: a UDisks object
+ *
+ * Gets the #UDisksMDRaid interface of @object, if present.
+ *
+ * Returns: (transfer none) (nullable): the interface
+ */
+UDisksMDRaid *
+udisks_object_peek_mdraid (UDisksObject *object)
+{
+  GDBusInterface *interface;
+
+  interface = g_dbus_object_get_interface (G_DBUS_OBJECT (object), "org.freedesktop.UDisks2.MDRaid");
+  if (interface != NULL)
+    g_object_unref (interface);
+
+  return interface != NULL ? UDISKS_MDRAID (interface) : NULL;
+}
+
+/**
+ * udisks_mdraid_get_array_for_block:
+ * @client: a client
+ * @block: an array device or a partition of one
+ *
+ * Returns: (transfer full) (nullable): the array represented by @block
+ */
+UDisksMDRaid *
+udisks_mdraid_get_array_for_block (UDisksClient *client,
+                                   UDisksBlock  *block)
+{
+  UDisksObject *object;
+  UDisksBlockMDRaid *relation;
+  UDisksMDRaid *array = NULL;
+
+  object = UDISKS_OBJECT (g_dbus_interface_dup_object (G_DBUS_INTERFACE (block)));
+  if (object == NULL)
+    return NULL;
+
+  relation = udisks_object_get_block_mdraid (object);
+  if (relation == NULL || g_strcmp0 (udisks_block_mdraid_get_array (relation), "/") == 0)
+    {
+      UDisksPartition *partition = udisks_object_peek_partition (object);
+
+      g_clear_object (&relation);
+      if (partition != NULL)
+        {
+          UDisksObject *table = udisks_client_get_object (client, udisks_partition_get_table (partition));
+
+          if (table != NULL)
+            relation = udisks_object_get_block_mdraid (table);
+          g_clear_object (&table);
+        }
+    }
+  if (relation != NULL)
+    {
+      UDisksObject *array_object = udisks_client_get_object (client, udisks_block_mdraid_get_array (relation));
+
+      if (array_object != NULL)
+        array = udisks_object_get_mdraid (array_object);
+      g_clear_object (&array_object);
+      g_object_unref (relation);
+    }
+  g_object_unref (object);
+  return array;
+}
+
+static GList *
+get_blocks (UDisksClient *client,
+            UDisksMDRaid *array,
+            gboolean      members)
+{
+  GDBusObject *array_object = g_dbus_interface_get_object (G_DBUS_INTERFACE (array));
+  GList *objects;
+  GList *l;
+  GList *blocks = NULL;
+
+  if (array_object == NULL)
+    return NULL;
+
+  objects = g_dbus_object_manager_get_objects (udisks_client_get_object_manager (client));
+  for (l = objects; l != NULL; l = l->next)
+    {
+      UDisksObject *object = UDISKS_OBJECT (l->data);
+      UDisksBlockMDRaid *relation = udisks_object_get_block_mdraid (object);
+
+      if (relation != NULL)
+        {
+          if (g_strcmp0 (members ? udisks_block_mdraid_get_member_of (relation) : udisks_block_mdraid_get_array (relation),
+                         g_dbus_object_get_object_path (array_object)) == 0)
+            {
+              UDisksBlock *block = udisks_object_get_block (object);
+
+              if (block != NULL)
+                blocks = g_list_prepend (blocks, block);
+            }
+          g_object_unref (relation);
+        }
+    }
+  g_list_free_full (objects, g_object_unref);
+  return g_list_reverse (blocks);
+}
+
+/**
+ * udisks_mdraid_get_all_blocks_for_array:
+ * @client: a client
+ * @array: an array
+ *
+ * Includes every running device for @array, including split-brain arrays.
+ *
+ * Returns: (transfer full) (element-type UDisksBlock): the array devices
+ */
+GList *
+udisks_mdraid_get_all_blocks_for_array (UDisksClient *client,
+                                        UDisksMDRaid *array)
+{
+  return get_blocks (client, array, FALSE);
+}
+
+/**
+ * udisks_mdraid_get_members_for_array:
+ * @client: a client
+ * @array: an array
+ *
+ * Returns: (transfer full) (element-type UDisksBlock): the member devices
+ */
+GList *
+udisks_mdraid_get_members_for_array (UDisksClient *client,
+                                     UDisksMDRaid *array)
+{
+  return get_blocks (client, array, TRUE);
+}
+
+/**
+ * udisks_mdraid_get_block_for_array:
+ * @client: a client
+ * @array: an array
+ *
+ * Returns: (transfer full) (nullable): a running array device
+ */
+UDisksBlock *
+udisks_mdraid_get_block_for_array (UDisksClient *client,
+                                   UDisksMDRaid *array)
+{
+  GList *blocks = udisks_mdraid_get_all_blocks_for_array (client, array);
+  UDisksBlock *block = blocks != NULL ? g_object_ref (blocks->data) : NULL;
+
+  g_list_free_full (blocks, g_object_unref);
+  return block;
+}
+
+static const gchar *
+format_mdraid_level (const gchar *level)
+{
+  const gchar *ret = NULL;
+
+  if (g_strcmp0 (level, "raid0") == 0)
+    ret = C_("mdraid-desc", "RAID-0 Array");
+  else if (g_strcmp0 (level, "raid1") == 0)
+    ret = C_("mdraid-desc", "RAID-1 Array");
+  else if (g_strcmp0 (level, "raid4") == 0)
+    ret = C_("mdraid-desc", "RAID-4 Array");
+  else if (g_strcmp0 (level, "raid5") == 0)
+    ret = C_("mdraid-desc", "RAID-5 Array");
+  else if (g_strcmp0 (level, "raid6") == 0)
+    ret = C_("mdraid-desc", "RAID-6 Array");
+  else if (g_strcmp0 (level, "raid10") == 0)
+    ret = C_("mdraid-desc", "RAID-10 Array");
+  else
+    ret = C_("mdraid-desc", "RAID Array");
+
+  return ret;
+}
+
+static void
+udisks_client_get_object_info_for_mdraid (UDisksClient     *client,
+                                          UDisksMDRaid     *mdraid,
+                                          UDisksPartition  *partition,
+                                          UDisksObjectInfo *info)
+{
+  UDisksBlock *block = NULL;
+  guint64 size = 0;
+  gchar *size_str = NULL;
+  const gchar *name;
+  const gchar *level;
+  const gchar *s;
+  gchar *desc;
+
+  block = udisks_mdraid_get_block_for_array (client, mdraid);
+
+  size = udisks_mdraid_get_size (mdraid);
+  if (size > 0)
+    size_str = udisks_client_get_size_for_display (client, size, FALSE, FALSE);
+
+  name = udisks_mdraid_get_name (mdraid);
+  s = strstr (name, ":");
+  if (s != NULL && strlen (s) > 1)
+    info->name = g_strdup (s + 1);
+  else
+    info->name = g_strdup (name);
+  info->icon = g_themed_icon_new_with_default_fallbacks ("drive-multidisk");
+  info->icon_symbolic = g_themed_icon_new_with_default_fallbacks ("drive-multidisk-symbolic");
+
+  level = udisks_mdraid_get_level (mdraid);
+  if (size_str != NULL)
+    {
+      /* Translators: Used to format the description for a RAID array.
+       *              The first %s is the size (e.g. '42.0 GB').
+       *              The second %s is the level (e.g. 'RAID-5 Array').
+       */
+      info->description = g_strdup_printf (C_("mdraid-desc", "%s %s"),
+                                           size_str,
+                                           format_mdraid_level (level));
+    }
+  else
+    {
+      info->description = g_strdup (format_mdraid_level (level));
+    }
+
+  if (partition != NULL)
+    {
+      /* Translators: Used to describe a partition of a RAID Array.
+       *              The %u is the partition number.
+       *              The %s is the description for the drive (e.g. "2 TB RAID-5").
+       */
+      desc = g_strdup_printf (C_("part-raid", "Partition %u of %s"),
+                              udisks_partition_get_number (partition), info->description);
+      g_free (info->description);
+      info->description = desc;
+    }
+
+  if (strlen (info->name) > 0)
+    {
+      if (block != NULL)
+        {
+          /* Translators: String used for one-liner description of running RAID array.
+           *              The first %s is the array name (e.g. "AlphaGo").
+           *              The second %s is the size and level (e.g. "2 TB RAID-5").
+           *              The third %s is the special device file (e.g. "/dev/sda").
+           */
+          info->one_liner = g_strdup_printf (C_("one-liner-mdraid-running", "%s — %s (%s)"),
+                                             info->name,
+                                             info->description,
+                                             udisks_block_get_preferred_device (block));
+        }
+      else
+        {
+          /* Translators: String used for one-liner description of non-running RAID array.
+           *              The first %s is the array name (e.g. "AlphaGo").
+           *              The second %s is the size and level (e.g. "2 TB RAID-5").
+           */
+          info->one_liner = g_strdup_printf (C_("one-liner-mdraid-not-running", "%s — %s"),
+                                             info->name,
+                                             info->description);
+        }
+    }
+  else
+    {
+      if (block != NULL)
+        {
+          /* Translators: String used for one-liner description of running RAID array w/o a name.
+           *              The first %s is the size and level (e.g. "2 TB RAID-5").
+           *              The second %s is the special device file (e.g. "/dev/sda").
+           */
+          info->one_liner = g_strdup_printf (C_("one-liner-mdraid-no-name-running", "%s — %s"),
+                                             info->description,
+                                             udisks_block_get_preferred_device (block));
+        }
+      else
+        {
+          /* Translators: String used for one-liner description of non-running RAID array w/o a name.
+           *              The %s is the size and level (e.g. "2 TB RAID-5").
+           */
+          info->one_liner = g_strdup_printf (C_("one-liner-mdraid-no-name-not-running", "%s"),
+                                             info->description);
+        }
+    }
+
+  g_clear_object (&block);
+
+  info->sort_key = g_strdup_printf ("01_mdraid_%s_%u", udisks_mdraid_get_uuid (mdraid),
+                                    partition != NULL ? udisks_partition_get_number (partition) : 0);
+
+  g_free (size_str);
+}
+
+/* ---------------------------------------------------------------------------------------------------- */
+
+static UDisksObjectInfo *
+get_object_info (UDisksClient *client,
+                 UDisksObject *object)
+{
+  UDisksMDRaid *array = udisks_object_get_mdraid (object);
+  UDisksBlock *block = udisks_object_get_block (object);
+  UDisksPartition *partition = udisks_object_get_partition (object);
+  UDisksObjectInfo *info = NULL;
+
+  if (array == NULL && block != NULL)
+    array = udisks_mdraid_get_array_for_block (client, block);
+  if (array != NULL)
+    {
+      info = _udisks_object_info_new (object);
+      udisks_client_get_object_info_for_mdraid (client, array, partition, info);
+    }
+  g_clear_object (&partition);
+  g_clear_object (&block);
+  g_clear_object (&array);
+  return info;
+}
+
+static const UDisksClientID ids[] =
+{
+  {"raid",       "linux_raid_member", "*",     NC_("fs-type", "Linux RAID Member (version %s)"),    NC_("fs-type", "Linux RAID Member")},
+  {"raid",       "linux_raid_member", NULL,    NC_("fs-type", "Linux RAID Member"),                 NC_("fs-type", "Linux RAID Member")},
+  { NULL, NULL, NULL, NULL, NULL }
+};
+
+static const UDisksClientJob jobs[] =
+{
+  { "md-raid-stop", NC_("job", "Stopping RAID Array") },
+  { "md-raid-start", NC_("job", "Starting RAID Array") },
+  { "md-raid-fault-device", NC_("job", "Marking Device as Faulty") },
+  { "md-raid-remove-device", NC_("job", "Removing Device from Array") },
+  { "md-raid-add-device", NC_("job", "Adding Device to Array") },
+  { "md-raid-set-bitmap", NC_("job", "Setting Write-Intent Bitmap") },
+  { "md-raid-create", NC_("job", "Creating RAID Array") },
+  { "mdraid-create", NC_("job", "Creating RAID Array") },
+  { NULL, NULL }
+};
+
+static const UDisksClientInterface interfaces[] =
+{
+  { "org.freedesktop.UDisks2.Manager.MDRaid", udisks_manager_mdraid_proxy_get_type },
+  { "org.freedesktop.UDisks2.Block.MDRaid", udisks_block_mdraid_proxy_get_type },
+  { "org.freedesktop.UDisks2.MDRaid", udisks_mdraid_proxy_get_type },
+  { NULL, NULL }
+};
+
+const UDisksClientModule *
+_udisks_client_module_query (void)
+{
+  static const UDisksClientModule module =
+  {
+    .interfaces = interfaces,
+    .ids = ids,
+    .jobs = jobs,
+    .get_object_info = get_object_info
+  };
+
+  return &module;
+}
