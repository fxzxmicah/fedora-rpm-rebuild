+
+typedef struct
+{
+  const gchar *name;
+  const gchar *description;
+  gint (*run) (const UDisksCtlContext *context,
+               gint                   *argc,
+               gchar                ***argv,
+               gboolean                request_completion,
+               const gchar            *completion_cur,
+               const gchar            *completion_prev);
