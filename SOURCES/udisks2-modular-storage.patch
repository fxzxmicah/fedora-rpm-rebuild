+
+  interface = g_dbus_object_get_interface (G_DBUS_OBJECT (object), "org.freedesktop.UDisks2.VDOVolume");
+  if (interface != NULL)
+    g_object_unref (interface);
+
+  return interface != NULL ? UDISKS_VDO_VOLUME (interface) : NULL;
+}
+
+static const UDisksClientID ids[] =
+{
+  {"raid",       "LVM2_member",       "*",     NC_("fs-type", "LVM2 Physical Volume (%s)"),         NC_("fs-type", "LVM2 PV")},
+  {"raid",       "LVM2_member",       NULL,    NC_("fs-type", "LVM2 Physical Volume"),              NC_("fs-type", "LVM2 PV")},
+  { NULL, NULL, NULL, NULL, NULL }
+};
+
+static const UDisksClientInterface interfaces[] =
+{
