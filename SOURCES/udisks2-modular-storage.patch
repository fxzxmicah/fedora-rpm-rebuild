+  }
+};
+
+static const GOptionEntry command_lock_entries[] =
+{
+  {
+    "object-path",
+    'p',
+    0,
+    G_OPTION_ARG_STRING,
+    &opt_unlock_lock_object_path,
+    "Object to lock",
