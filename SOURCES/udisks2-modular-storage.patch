+#include "udiskslinuxblockcrypto.h"
+#include "udiskslinuxencrypted.h"
+
+struct _UDisksLinuxModuleCrypto
+{
+  UDisksModule parent_instance;
+  UDisksCrypttabMonitor *crypttab_monitor;
+  const gchar *encryption;
+  gboolean probe_tcrypt;
+};
+
+typedef struct
+{
+  UDisksModuleClass parent_class;
+} UDisksLinuxModuleCryptoClass;
+
+static void initable_iface_init (GInitableIface *iface);
+
+gchar *udisks_module_id (void);
+UDisksModule *udisks_module_crypto_new (UDisksDaemon  *daemon,
+                                        GCancellable  *cancellable,
+                                        GError       **error);
+
+G_DEFINE_TYPE_WITH_CODE (UDisksLinuxModuleCrypto, udisks_linux_module_crypto, UDISKS_TYPE_MODULE,
+                         G_IMPLEMENT_INTERFACE (G_TYPE_INITABLE, initable_iface_init));
+
+static void
+configuration_changed (UDisksCrypttabMonitor *monitor,
+                       UDisksCrypttabEntry   *entry,
+                       gpointer               user_data)
+{
+  UDisksModule *module = UDISKS_MODULE (user_data);
+
+  udisks_daemon_update_configuration (udisks_module_get_daemon (module));
+}
+
+static gboolean
+load_configuration (UDisksLinuxModuleCrypto *module,
+                    GError                 **error)
+{
+  UDisksConfigManager *manager = udisks_daemon_get_config_manager (udisks_module_get_daemon (UDISKS_MODULE (module)));
+  gchar *filename = g_build_filename (udisks_config_manager_get_config_dir (manager),
+                                      "modules.conf.d", "udisks2_crypto.conf", NULL);
+  GKeyFile *config = g_key_file_new ();
+  GError *local_error = NULL;
+  gchar *encryption = NULL;
+  gboolean ret = FALSE;
+
+  if (!g_key_file_load_from_file (config, filename, G_KEY_FILE_NONE, &local_error))
+    {
+      if (g_error_matches (local_error, G_FILE_ERROR, G_FILE_ERROR_NOENT))
+        {
+          g_clear_error (&local_error);
+          ret = TRUE;
+        }
+      goto out;
+    }
+
+  encryption = g_key_file_get_string (config, "crypto", "encryption", NULL);
+  if (encryption != NULL)
+    {
+      if (g_str_equal (encryption, "luks1"))
+        module->encryption = "luks1";
+      else if (g_str_equal (encryption, "luks2"))
+        module->encryption = "luks2";
+      else
+        {
+          g_set_error (error, UDISKS_ERROR, UDISKS_ERROR_FAILED,
+                       "Unsupported encryption type '%s' in %s", encryption, filename);
+          goto out;
+        }
+    }
+  if (g_key_file_has_key (config, "crypto", "probe-tcrypt", NULL))
+    {
+      module->probe_tcrypt = g_key_file_get_boolean (config, "crypto", "probe-tcrypt", &local_error);
+      if (local_error != NULL)
+        goto out;
+    }
+  ret = TRUE;
+
+ out:
+  if (local_error != NULL)
+    g_propagate_error (error, local_error);
+  g_free (encryption);
+  g_key_file_unref (config);
+  g_free (filename);
+  return ret;
+}
+
+static gboolean
+initable_init (GInitable    *initable,
+               GCancellable *cancellable,
+               GError      **error)
+{
+  UDisksLinuxModuleCrypto *module = UDISKS_LINUX_MODULE_CRYPTO (initable);
+  BDPluginSpec plugin = { BD_PLUGIN_CRYPTO, NULL };
+  BDPluginSpec *plugins[] = { &plugin, NULL };
+
+  if (!bd_is_plugin_available (BD_PLUGIN_CRYPTO) && !bd_reinit (plugins, FALSE, NULL, error))
+    return FALSE;
+
+  if (!load_configuration (module, error))
+    return FALSE;
+
+  module->crypttab_monitor = udisks_crypttab_monitor_new ();
+  g_signal_connect (module->crypttab_monitor, "entry-added", G_CALLBACK (configuration_changed), module);
+  g_signal_connect (module->crypttab_monitor, "entry-removed", G_CALLBACK (configuration_changed), module);
+  return TRUE;
+}
+
+static void
+initable_iface_init (GInitableIface *iface)
+{
+  iface->init = initable_init;
+}
+
+UDisksCrypttabMonitor *
+udisks_linux_module_crypto_get_crypttab_monitor (UDisksLinuxModuleCrypto *module)
+{
+  return module->crypttab_monitor;
+}
+
+const gchar *
+udisks_linux_module_crypto_get_encryption (UDisksLinuxModuleCrypto *module)
+{
+  return module->encryption;
+}
+
+static void
+crypto_info_free (gpointer data)
+{
+  UDisksCryptoInfo *info = data;
+
+  if (info->luks != NULL)
+    bd_crypto_luks_info_free (info->luks);
+  if (info->bitlk != NULL)
+    bd_crypto_bitlk_info_free (info->bitlk);
+  g_free (info);
+}
+
+const UDisksCryptoInfo *
+udisks_linux_module_crypto_get_info (UDisksLinuxDevice *device)
+{
+  return g_object_get_data (G_OBJECT (device), "udisks-crypto-info");
+}
+
+static void
+probe_device (UDisksModule      *module,
+              UDisksLinuxDevice *device)
+{
+  const gchar *type = g_udev_device_get_property (device->udev_device, "ID_FS_TYPE");
+  const gchar *filename = g_udev_device_get_device_file (device->udev_device);
+  UDisksCryptoInfo *info;
+
+  if (filename == NULL || g_strcmp0 (g_udev_device_get_subsystem (device->udev_device), "block") != 0)
+    return;
+
+  info = g_new0 (UDisksCryptoInfo, 1);
+  if (g_strcmp0 (type, "crypto_LUKS") == 0)
+    info->luks = bd_crypto_luks_info (filename, NULL);
+  else if (g_strcmp0 (type, "BitLocker") == 0)
+    info->bitlk = bd_crypto_bitlk_info (filename, NULL);
+  else if ((type == NULL || *type == '\0') && UDISKS_LINUX_MODULE_CRYPTO (module)->probe_tcrypt)
+    info->hidden = bd_crypto_device_seems_encrypted (filename, NULL);
+  g_object_set_data_full (G_OBJECT (device), "udisks-crypto-info", info, crypto_info_free);
+}
+
+gboolean
+udisks_linux_module_crypto_is_device (UDisksLinuxDevice *device)
+{
+  const gchar *type = g_udev_device_get_property (device->udev_device, "ID_FS_TYPE");
+  const UDisksCryptoInfo *info = udisks_linux_module_crypto_get_info (device);
+
+  return g_strcmp0 (type, "crypto_LUKS") == 0 || g_strcmp0 (type, "crypto_TCRYPT") == 0 ||
+         g_strcmp0 (type, "BitLocker") == 0 || (info != NULL && info->hidden);
+}
+
+static GType *
+get_block_object_interface_types (UDisksModule *module)
+{
+  static gsize initialized;
+  static GType types[3];
+
+  if (g_once_init_enter (&initialized))
+    {
+      types[0] = UDISKS_TYPE_LINUX_BLOCK_CRYPTO;
+      types[1] = UDISKS_TYPE_LINUX_ENCRYPTED;
+      g_once_init_leave (&initialized, 1);
+    }
+  return types;
+}
+
+static GDBusInterfaceSkeleton *
+new_block_object_interface (UDisksModule           *module,
+                            UDisksLinuxBlockObject *object,
+                            GType                   interface_type)
+{
+  UDisksLinuxDevice *device;
+  GDBusInterfaceSkeleton *interface = NULL;
+
+  if (interface_type == UDISKS_TYPE_LINUX_BLOCK_CRYPTO)
+    return G_DBUS_INTERFACE_SKELETON (udisks_linux_block_crypto_new (UDISKS_LINUX_MODULE_CRYPTO (module), object));
+
+  device = udisks_linux_block_object_get_device (object);
+  if (udisks_linux_module_crypto_is_device (device))
+    interface = G_DBUS_INTERFACE_SKELETON (udisks_linux_encrypted_new (object));
+  g_object_unref (device);
+  return interface;
+}
+
+static GDBusInterfaceSkeleton *
+new_manager (UDisksModule *module)
+{
+  UDisksManagerCrypto *manager = udisks_manager_crypto_skeleton_new ();
+  static const gchar * const types[] = { "luks1", "luks2", NULL };
+
+  udisks_manager_crypto_set_default_encryption_type (manager, UDISKS_LINUX_MODULE_CRYPTO (module)->encryption);
+  udisks_manager_crypto_set_supported_encryption_types (manager, types);
+  return G_DBUS_INTERFACE_SKELETON (manager);
+}
+
+static void
+handle_uevent (UDisksModule      *module,
+               const gchar       *action,
+               UDisksLinuxDevice *device)
+{
+  UDisksDaemon *daemon = udisks_module_get_daemon (module);
+  UDisksObject *object = udisks_daemon_find_block_by_sysfs_path (daemon, g_udev_device_get_sysfs_path (device->udev_device));
+  UDisksBlockCrypto *crypto;
+
+  if (object == NULL)
+    return;
+  crypto = udisks_object_peek_block_crypto (object);
+  if (crypto != NULL)
+    {
+      UDisksObject *backing = udisks_daemon_find_object (daemon, udisks_block_crypto_get_backing_device (crypto));
+      UDisksEncrypted *encrypted = backing != NULL ? udisks_object_peek_encrypted (backing) : NULL;
+      const gchar *path = g_dbus_object_get_object_path (G_DBUS_OBJECT (object));
+
+      if (encrypted != NULL)
+        {
+          if (g_strcmp0 (action, "remove") != 0)
+            udisks_encrypted_set_cleartext_device (encrypted, path);
+          else if (g_strcmp0 (udisks_encrypted_get_cleartext_device (encrypted), path) == 0)
+            udisks_encrypted_set_cleartext_device (encrypted, "/");
+        }
+      g_clear_object (&backing);
+    }
+  g_object_unref (object);
+}
+
+static void
+check_state (UDisksModule *module,
+             gboolean      check_only,
+             GArray       *devices)
+{
+  UDisksDaemon *daemon = udisks_module_get_daemon (module);
+
+  udisks_crypto_state_check (udisks_daemon_get_state (daemon), daemon, check_only, devices);
+}
+
+static gchar *
+track_parent (UDisksModule *module,
+              const gchar  *path,
+              gchar       **uuid)
+{
+  UDisksDaemon *daemon = udisks_module_get_daemon (module);
+  UDisksObject *object = udisks_daemon_find_object (daemon, path);
+  gchar *parent = NULL;
+
+  if (object != NULL)
+    {
+      UDisksBlockCrypto *crypto = udisks_object_peek_block_crypto (object);
+
+      if (crypto != NULL && g_strcmp0 (udisks_block_crypto_get_backing_device (crypto), "/") != 0)
+        {
+          UDisksObject *backing = udisks_daemon_find_object (daemon, udisks_block_crypto_get_backing_device (crypto));
+          UDisksBlock *block = backing != NULL ? udisks_object_peek_block (backing) : NULL;
+
+          if (block != NULL)
+            {
+              parent = udisks_block_crypto_dup_backing_device (crypto);
+              *uuid = udisks_block_dup_id_uuid (block);
+            }
+          g_clear_object (&backing);
+        }
+      g_object_unref (object);
+    }
+  return parent;
+}
+
+static gboolean
+setup_by_user (UDisksModule *module,
+               UDisksObject *object,
+               uid_t         user)
+{
+  UDisksDaemon *daemon = udisks_module_get_daemon (module);
+  UDisksBlockCrypto *crypto = udisks_object_peek_block_crypto (object);
+  UDisksObject *backing;
+  UDisksBlock *block;
+  uid_t owner;
+  dev_t mapping;
+  gboolean ret = FALSE;
+
+  if (crypto == NULL)
+    return FALSE;
+  backing = udisks_daemon_find_object (daemon, udisks_block_crypto_get_backing_device (crypto));
+  block = backing != NULL ? udisks_object_peek_block (backing) : NULL;
+  if (block != NULL)
+    {
+      mapping = udisks_crypto_state_find (udisks_daemon_get_state (daemon), daemon,
+                                          udisks_block_get_device_number (block), udisks_block_get_id_uuid (block), &owner);
+      ret = mapping != 0 && mapping == udisks_block_get_device_number (udisks_object_peek_block (object)) && owner == user;
+    }
+  g_clear_object (&backing);
+  return ret;
+}
+
+static void
+udisks_linux_module_crypto_finalize (GObject *object)
+{
+  UDisksLinuxModuleCrypto *module = UDISKS_LINUX_MODULE_CRYPTO (object);
+
+  g_clear_object (&module->crypttab_monitor);
+  G_OBJECT_CLASS (udisks_linux_module_crypto_parent_class)->finalize (object);
+}
+
+static void
+udisks_linux_module_crypto_class_init (UDisksLinuxModuleCryptoClass *klass)
+{
+  UDisksModuleClass *module_class = UDISKS_MODULE_CLASS (klass);
+
+  G_OBJECT_CLASS (klass)->finalize = udisks_linux_module_crypto_finalize;
+  module_class->check_state = check_state;
+  module_class->track_parent = track_parent;
+  module_class->setup_by_user = setup_by_user;
+  module_class->new_manager = new_manager;
+  module_class->probe_device = probe_device;
+  module_class->get_block_object_interface_types = get_block_object_interface_types;
+  module_class->new_block_object_interface = new_block_object_interface;
+  module_class->handle_uevent = handle_uevent;
+  module_class->teardown_block = udisks_crypto_teardown_block;
+  module_class->append_configuration = udisks_crypto_append_configuration;
+  module_class->get_configuration_handler = udisks_crypto_get_configuration_handler;
+}
+
+static void
+udisks_linux_module_crypto_init (UDisksLinuxModuleCrypto *module)
+{
+  module->encryption = "luks1";
+}
+
+gchar *
+udisks_module_id (void)
+{
+  return g_strdup ("crypto");
+}
+
+UDisksModule *
+udisks_module_crypto_new (UDisksDaemon  *daemon,
+                          GCancellable  *cancellable,
+                          GError       **error)
+{
+  return UDISKS_MODULE (g_initable_new (UDISKS_TYPE_LINUX_MODULE_CRYPTO,
+                                        cancellable, error, "daemon", daemon, "name", "crypto", NULL));
+}
