diff --git a/modules/crypto/Makefile.am b/modules/crypto/Makefile.am
new file mode 100644
index 0000000..e8e18b1
--- /dev/null
+++ b/modules/crypto/Makefile.am
@@ -0,0 +1,117 @@
+## Process this file with automake to produce Makefile.in
+
+SUBDIRS = data
+
+NULL =
+
+AM_CPPFLAGS =                                                                  \
+	-I$(top_builddir) -I$(top_srcdir)                                      \
+	-DPACKAGE_LIBEXEC_DIR=\""$(libexecdir)"\"                              \
+	-DPACKAGE_SYSCONF_DIR=\""$(sysconfdir)"\"                              \
+	-DPACKAGE_DATA_DIR=\""$(datadir)"\"                                    \
+	-DPACKAGE_BIN_DIR=\""$(bindir)"\"                                      \
+	-DPACKAGE_LOCALSTATE_DIR=\""$(localstatedir)"\"                        \
+	-DPACKAGE_LOCALE_DIR=\""$(localedir)"\"                                \
+	-DPACKAGE_LIB_DIR=\""$(libdir)"\"                                      \
+	-D_POSIX_PTHREAD_SEMANTICS -D_REENTRANT                                \
+	-DUDISKS_COMPILATION                                                   \
+	$(POLKIT_GOBJECT_1_CFLAGS)                                             \
+	$(GLIB_CFLAGS)                                                         \
+	$(GIO_CFLAGS)                                                          \
+	$(GUDEV_CFLAGS)                                                        \
+	$(BLOCKDEV_CFLAGS)                                                     \
+	$(WARN_CFLAGS)                                                         \
+	$(NULL)
+
+if ENABLE_DAEMON
+
+
+MODULE_SO = libudisks2_crypto.so
+
+BUILT_SOURCES =                                                                \
+	$(NULL)
+
+libudisks2_cryptodir = $(libdir)/udisks2/modules
+libudisks2_crypto_LTLIBRARIES = libudisks2_crypto.la
+
+
+libudisks2_crypto_la_SOURCES = \
+	udiskscryptotypes.h \
+	udiskslinuxmodulecrypto.c udiskslinuxmodulecrypto.h \
+	udiskslinuxblockcrypto.c udiskslinuxblockcrypto.h \
+	udiskslinuxencrypted.c udiskslinuxencrypted.h \
+	udiskslinuxencryptedhelpers.c udiskslinuxencryptedhelpers.h \
+	udiskscryptostate.c udiskscryptostate.h \
+	udiskscryptoconfiguration.c udiskscryptoconfiguration.h \
+	udiskscrypttabmonitor.c udiskscrypttabmonitor.h \
+	udiskscrypttabentry.c udiskscrypttabentry.h
+
+libudisks2_crypto_la_CPPFLAGS =                                                 \
+	$(AM_CPPFLAGS)                                                         \
+	-DG_LOG_DOMAIN=\"libudisks2-crypto\"                                    \
+	$(NULL)
+
+libudisks2_crypto_la_CFLAGS =                                                   \
+	$(GLIB_CFLAGS)                                                         \
+	$(GIO_CFLAGS)                                                          \
+	$(GUDEV_CFLAGS)                                                        \
+	$(POLKIT_GOBJECT_1_CFLAGS)                                             \
+	$(BLOCKDEV_CFLAGS)                                                     \
+	$(NULL)
+
+libudisks2_crypto_la_LDFLAGS =                                                  \
+	-export-dynamic                                                        \
+	-avoid-version                                                         \
+	-module                                                                \
+	-no-undefined                                                          \
+	-export-symbols-regex                                                  \
+	 '^udisks_.*|g_io_module_load|g_io_module_unload|g_io_module_query'    \
+	$(NULL)
+
+libudisks2_crypto_la_LIBADD =                                                   \
+	$(top_builddir)/udisks/libudisks2-crypto.la                             \
+	$(top_builddir)/src/libudisks2-daemon.la                                \
+	$(GLIB_LIBS)                                                           \
+	$(GIO_LIBS)                                                            \
+	$(GUDEV_LIBS)                                                          \
+	$(POLKIT_GOBJECT_1_LIBS)                                               \
+	$(BLOCKDEV_LIBS)                                                       \
+	$(NULL)
+
+endif # ENABLE_DAEMON
+
+# Optional client commands use the CLI context, with no daemon symbols.
+climoduledir = $(libdir)/udisks2/cli-modules
+climodule_LTLIBRARIES = libudisks2_crypto_cli.la
+libudisks2_crypto_cli_la_SOURCES = udisksctlcrypto.c
+libudisks2_crypto_cli_la_CFLAGS = $(GLIB_CFLAGS) $(GIO_CFLAGS) $(GMODULE_CFLAGS)
+libudisks2_crypto_cli_la_LIBADD = $(top_builddir)/udisks/libudisks2-crypto.la $(GLIB_LIBS) $(GIO_LIBS)
+libudisks2_crypto_cli_la_LDFLAGS = -module -avoid-version -no-undefined
+
+# ------------------------------------------------------------------------------
+
+CLEANFILES =
+
+EXTRA_DIST =                                                                   \
+	$(NULL)
+
+include ../Makefile.uninstalled
+
+dist-hook:
+	(for i in $(BUILT_SOURCES); do rm -f $(distdir)/$$i; done)
+
+clean-local: module_unlink cli-module-unlink
+	rm -f *~ $(BUILT_SOURCES)
+
+if ENABLE_DAEMON
+all-local: module_link cli-module-link
+else
+all-local: cli-module-link
+endif
+
+cli-module-link:
+	$(AM_V_at) $(MKDIR_P) $(top_builddir)/tools/cli-modules
+	$(AM_V_at) ln -rsf .libs/libudisks2_crypto_cli.so $(top_builddir)/tools/cli-modules/libudisks2_crypto_cli.so
+
+cli-module-unlink:
+	$(AM_V_at) rm -f $(top_builddir)/tools/cli-modules/libudisks2_crypto_cli.so
