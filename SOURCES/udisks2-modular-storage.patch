+	udiskslinuxmdraid.c udiskslinuxmdraid.h \
+	udiskslinuxmdraidobject.c udiskslinuxmdraidobject.h \
+	udiskslinuxmdraidhelpers.c udiskslinuxmdraidhelpers.h \
+	udisksmdraidstate.c udisksmdraidstate.h
+
+libudisks2_mdraid_la_CPPFLAGS =                                                 \
+	$(AM_CPPFLAGS)                                                         \
+	-DG_LOG_DOMAIN=\"libudisks2-mdraid\"                                    \
+	$(NULL)
+
+libudisks2_mdraid_la_CFLAGS =                                                   \
+	$(GLIB_CFLAGS)                                                         \
+	$(GIO_CFLAGS)                                                          \
+	$(GUDEV_CFLAGS)                                                        \
+	$(POLKIT_GOBJECT_1_CFLAGS)                                             \
+	$(BLOCKDEV_CFLAGS)                                                     \
+	$(NULL)
+
+libudisks2_mdraid_la_LDFLAGS =                                                  \
+	-export-dynamic                                                        \
+	-avoid-version                                                         \
+	-module                                                                \
+	-no-undefined                                                          \
+	-export-symbols-regex                                                  \
+	 '^udisks_.*|g_io_module_load|g_io_module_unload|g_io_module_query'    \
+	$(NULL)
+
+libudisks2_mdraid_la_LIBADD =                                                   \
+	$(top_builddir)/udisks/libudisks2-mdraid.la                             \
+	$(top_builddir)/src/libudisks2-daemon.la                                \
+	$(GLIB_LIBS)                                                           \
+	$(GIO_LIBS)                                                            \
+	$(GUDEV_LIBS)                                                          \
+	$(POLKIT_GOBJECT_1_LIBS)                                               \
+	$(BLOCKDEV_LIBS)                                                       \
+	$(NULL)
+
+all-local: module_link
+
+endif # ENABLE_DAEMON
+
+# ------------------------------------------------------------------------------
+
+CLEANFILES =
+
+EXTRA_DIST =                                                                   \
+	$(NULL)
+
+include ../Makefile.uninstalled
+
+dist-hook:
+	(for i in $(BUILT_SOURCES); do rm -f $(distdir)/$$i; done)
+
+clean-local: module_unlink
+	rm -f *~ $(BUILT_SOURCES)
