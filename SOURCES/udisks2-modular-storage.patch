+
+/**
+ * udisks_daemon_util_check_options:
+ * @options: an a{sv} dictionary
+ * @entries: a NULL-terminated table of accepted names and variant types
+ * @error: return location for an error
+ *
+ * Validates operation options before performing destructive work.
+ *
+ * Returns: %TRUE if every option has a supported name and type
+ */
+gboolean
+udisks_daemon_util_check_options (GVariant                *options,
+                                  const UDisksOptionEntry *entries,
+                                  GError                 **error)
+{
+  GVariantIter iter;
+  const gchar *name;
+  GVariant *value;
+
+  g_variant_iter_init (&iter, options);
+  while (g_variant_iter_next (&iter, "{&sv}", &name, &value))
+    {
+      const UDisksOptionEntry *entry;
+      gboolean valid;
+
+      for (entry = entries; entry->name != NULL; entry++)
+        if (g_str_equal (name, entry->name))
+          break;
+      valid = entry->name != NULL && g_variant_is_of_type (value, G_VARIANT_TYPE (entry->type));
+      if (!valid)
+        g_set_error (error, UDISKS_ERROR, UDISKS_ERROR_NOT_SUPPORTED,
+                     "Unsupported option or value type for '%s'", name);
+      g_variant_unref (value);
+      if (!valid)
+        return FALSE;
+    }
+  return TRUE;
+}
