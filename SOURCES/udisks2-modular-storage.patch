diff --git a/modules/crypto/udiskscryptoconfiguration.c b/modules/crypto/udiskscryptoconfiguration.c
new file mode 100644
index 0000000..025a0f1
--- /dev/null
+++ b/modules/crypto/udiskscryptoconfiguration.c
@@ -0,0 +1,505 @@
+/* -*- mode: C; c-file-style: "gnu"; indent-tabs-mode: nil; -*-
+ *
