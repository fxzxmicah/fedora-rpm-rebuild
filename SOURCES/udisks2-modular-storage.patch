+
+G_BEGIN_DECLS
+
+/* These descriptors are internal to the in-tree client bindings. The core
+ * owns object proxies; bindings provide independent interface types and
+ * resource descriptions without extending the core object's layout.
+ */
+typedef struct
+{
+  const gchar *name;
+  GType (*get_type) (void);
+} UDisksClientInterface;
+
+typedef struct
+{
+  const gchar *usage;
+  const gchar *type;
+  const gchar *version;
+  const gchar *long_name;
+  const gchar *short_name;
+} UDisksClientID;
+
+typedef struct
+{
+  const gchar *operation;
+  const gchar *description;
+} UDisksClientJob;
+
+typedef struct
+{
+  const UDisksClientInterface *interfaces;
+  const UDisksClientID *ids;
+  const UDisksClientJob *jobs;
+  UDisksObjectInfo *(*get_object_info) (UDisksClient *client,
+                                        UDisksObject *object);
+} UDisksClientModule;
+
+G_MODULE_EXPORT const UDisksClientModule *_udisks_client_module_query (void);
+
+const GArray *_udisks_client_get_modules (void);
+UDisksObjectInfo *_udisks_client_get_module_object_info (UDisksClient *client,
+                                                         UDisksObject *object);
+GType _udisks_client_get_proxy_type (GDBusObjectManagerClient *manager,
+                                     const gchar             *object_path,
+                                     const gchar             *interface_name,
+                                     gpointer                 user_data);
+
+G_END_DECLS
+
+#endif /* __UDISKS_CLIENT_MODULE_H__ */
