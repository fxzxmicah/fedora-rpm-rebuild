+# Encryption module
+have_crypto=no
+AC_ARG_ENABLE(crypto, AS_HELP_STRING([--enable-crypto], [enable encryption support]))
+if test "x$enable_crypto" != "xno" && {
+     test "x$enable_crypto" = "xyes" \
+     -o "x$enable_modules" = "xyes" \
+     -o "x$enable_available_modules" = "xyes"; }; then
+  have_crypto=yes
+  if test "x$enable_daemon" = "xyes"; then
+    # libblockdev crypto
+    SAVE_CFLAGS=$CFLAGS
+    SAVE_LDFLAGS=$LDFLAGS
+
+    CFLAGS="$GLIB_CFLAGS $BLOCKDEV_CFLAGS"
+    LDFLAGS="$GLIB_LIBS"
+    AC_MSG_CHECKING([libblockdev-crypto presence])
+    AC_COMPILE_IFELSE([AC_LANG_PROGRAM([[#include <blockdev/crypto.h>]], [[]])],[AC_MSG_RESULT([yes])
+                   have_crypto=yes],[AC_MSG_RESULT([no])
+                   have_crypto=no])
+
+    CFLAGS=$SAVE_CFLAGS
+    LDFLAGS=$SAVE_LDFLAGS
+
+    if test "x$have_crypto" = "xno" && { test "x$enable_crypto" = "xyes" -o "x$enable_modules" = "xyes"; }; then
+      AC_MSG_ERROR([BLOCKDEV CRYPTO support requested but header or library not found])
+    fi
+
+  fi
+fi
+AM_CONDITIONAL(HAVE_CRYPTO, [test "x$have_crypto" = "xyes"])
+
+# Linux MD RAID module
+have_mdraid=no
+AC_ARG_ENABLE(mdraid, AS_HELP_STRING([--enable-mdraid], [enable Linux MD RAID support]))
