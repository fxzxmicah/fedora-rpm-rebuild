From bc12274a8fdc92c1e0d9a2e1f0d8c13bcbb82936 Mon Sep 17 00:00:00 2001
From: Fxzx micah <48860358+fxzxmicah@users.noreply.github.com>
Date: Sun, 18 Oct 2026 03:38:28 +0800
Subject: [PATCH] encoding: Handle missing converters consistently

Character set support depends on the installed converters. Handle missing
converters as errors instead of passing NULL to conversion APIs.

Only enumerate encodings with conversion support to and from UTF-8, while
keeping charset lookup independent of availability. During loading, skip
unavailable detection candidates and propagate errors for explicit and
fallback encodings. Preserve candidate order and first-candidate fallback.

Distinguish incomplete UTF-8 characters at sample boundaries from invalid
input, and match partial conversion errors in the correct error domain.

Create save converters before replacing the destination so unsupported
encodings fail without opening the target file for replacement.
---
 gtksourceview/gtksourcebufferoutputstream.c | 156 +++++++-------------
 gtksourceview/gtksourceencoding.c           |  28 +++-
 gtksourceview/gtksourcefilesaver.c          |  57 +++----
 3 files changed, 111 insertions(+), 130 deletions(-)

diff --git a/gtksourceview/gtksourcebufferoutputstream.c b/gtksourceview/gtksourcebufferoutputstream.c
index d3a0f159..8f44caac 100644
--- a/gtksourceview/gtksourcebufferoutputstream.c
+++ b/gtksourceview/gtksourcebufferoutputstream.c
@@ -80,7 +80,6 @@ struct _GtkSourceBufferOutputStream
 	guint n_fallback_errors;
 
 	guint is_utf8 : 1;
-	guint use_first : 1;
 
 	guint is_initialized : 1;
 	guint is_closed : 1;
@@ -254,30 +253,24 @@ gtk_source_buffer_output_stream_init (GtkSourceBufferOutputStream *stream)
 	stream->is_initialized = FALSE;
 	stream->is_closed = FALSE;
 	stream->is_utf8 = FALSE;
-	stream->use_first = FALSE;
 }
 
-static const GtkSourceEncoding *
-get_encoding (GtkSourceBufferOutputStream *stream)
+static gboolean
+set_encoding (GtkSourceBufferOutputStream  *stream,
+              const GtkSourceEncoding      *encoding,
+              GError                      **error)
 {
-	if (stream->current_encoding == NULL)
-	{
-		stream->current_encoding = stream->encodings;
-	}
-	else
-	{
-		stream->current_encoding = g_slist_next (stream->current_encoding);
-	}
+	stream->is_utf8 = encoding == gtk_source_encoding_get_utf8 ();
 
-	if (stream->current_encoding != NULL)
+	if (stream->is_utf8)
 	{
-		return stream->current_encoding->data;
+		return TRUE;
 	}
 
-	stream->use_first = TRUE;
-	stream->current_encoding = stream->encodings;
-
-	return stream->current_encoding->data;
+	stream->charset_conv = g_charset_converter_new ("UTF-8",
+	                                              gtk_source_encoding_get_charset (encoding),
+	                                              error);
+	return stream->charset_conv != NULL;
 }
 
 static gboolean
@@ -320,76 +313,60 @@ try_convert (GCharsetConverter *converter,
 		nwritten += bytes_written;
 	} while (res != G_CONVERTER_FINISHED && res != G_CONVERTER_ERROR && err == NULL);
 
-	if (err != NULL)
-	{
-		if (err->code == G_CONVERT_ERROR_PARTIAL_INPUT)
-		{
-			/* FIXME We can get partial input while guessing the
-			   encoding because we just take some amount of text
-			   to guess from. */
-			ret = TRUE;
-		}
-		else
-		{
-			ret = FALSE;
-		}
-
-		g_error_free (err);
-	}
-	else
-	{
-		ret = TRUE;
-	}
-
-	/* FIXME: Check the remainder? */
-	if (ret == TRUE && !g_utf8_validate (out, nwritten, NULL))
-	{
-		ret = FALSE;
-	}
+	/* The sample may end in an incomplete character, but its output must
+	 * still be valid UTF-8.
+	 */
+	ret = (err == NULL || g_error_matches (err, G_IO_ERROR, G_IO_ERROR_PARTIAL_INPUT)) &&
+	      g_utf8_validate (out, nwritten, NULL);
 
+	g_clear_error (&err);
 	g_free (out);
 
 	return ret;
 }
 
-static GCharsetConverter *
+static gboolean
 guess_encoding (GtkSourceBufferOutputStream *stream,
                 const void                  *inbuf,
-                gsize                        inbuf_size)
+                gsize                        inbuf_size,
+                GError                     **error)
 {
-	GCharsetConverter *conv = NULL;
-
 	if (inbuf == NULL || inbuf_size == 0)
 	{
 		stream->is_utf8 = TRUE;
-		return NULL;
+		return TRUE;
 	}
 
-	if (stream->encodings != NULL &&
-	    stream->encodings->next == NULL)
+	if (stream->encodings == NULL)
 	{
-		stream->use_first = TRUE;
+		g_set_error_literal (error, GTK_SOURCE_FILE_LOADER_ERROR,
+		                     GTK_SOURCE_FILE_LOADER_ERROR_ENCODING_AUTO_DETECTION_FAILED,
+		                     "It is not possible to detect the encoding automatically");
+		return FALSE;
 	}
 
-	/* We just check the first block */
-	while (TRUE)
-	{
-		const GtkSourceEncoding *enc;
+	stream->current_encoding = stream->encodings;
 
-		g_clear_object (&conv);
+	/* A single candidate is an explicit choice, not an encoding guess. */
+	if (stream->encodings->next == NULL)
+	{
+		return set_encoding (stream, stream->current_encoding->data, error);
+	}
 
-		/* We get an encoding from the list */
-		enc = get_encoding (stream);
+	/* Probe the first block in candidate order. */
+	for (; stream->current_encoding != NULL;
+	       stream->current_encoding = stream->current_encoding->next)
+	{
+		const GtkSourceEncoding *enc = stream->current_encoding->data;
 
-		/* if it is NULL we didn't guess anything */
-		if (enc == NULL)
+		if (!set_encoding (stream, enc, NULL))
 		{
-			break;
+			continue;
 		}
 
 		DEBUG ({
 		       g_print ("trying charset: %s\n",
-				gtk_source_encoding_get_charset (stream->current_encoding->data));
+				gtk_source_encoding_get_charset (enc));
 		});
 
 		if (enc == gtk_source_encoding_get_utf8 ())
@@ -397,47 +374,31 @@ guess_encoding (GtkSourceBufferOutputStream *stream,
 			gsize remainder;
 			const gchar *end;
 
-			if (g_utf8_validate (inbuf, inbuf_size, &end) ||
-			    stream->use_first)
+			if (g_utf8_validate (inbuf, inbuf_size, &end))
 			{
-				stream->is_utf8 = TRUE;
-				break;
+				return TRUE;
 			}
 
-			/* Check if the end is less than one char */
+			/* Accept a valid UTF-8 prefix ending in an incomplete character. */
 			remainder = inbuf_size - (end - (gchar *)inbuf);
-			if (remainder < 6)
+			if (memchr (end, '\0', remainder) == NULL &&
+			    g_utf8_get_char_validated (end, remainder) == (gunichar)-2)
 			{
-				stream->is_utf8 = TRUE;
-				break;
+				return TRUE;
 			}
-
-			continue;
 		}
-
-		conv = g_charset_converter_new ("UTF-8",
-						gtk_source_encoding_get_charset (enc),
-						NULL);
-
-		/* If we tried all encodings we use the first one */
-		if (stream->use_first)
-		{
-			break;
-		}
-
-		/* Try to convert */
-		if (try_convert (conv, inbuf, inbuf_size))
+		else if (try_convert (stream->charset_conv, inbuf, inbuf_size))
 		{
-			break;
+			g_converter_reset (G_CONVERTER (stream->charset_conv));
+			return TRUE;
 		}
-	}
 
-	if (conv != NULL)
-	{
-		g_converter_reset (G_CONVERTER (conv));
+		g_clear_object (&stream->charset_conv);
 	}
 
-	return conv;
+	/* Keep the first candidate as the fallback when no probe succeeds. */
+	stream->current_encoding = stream->encodings;
+	return set_encoding (stream, stream->current_encoding->data, error);
 }
 
 static GtkSourceNewlineType
@@ -985,17 +946,8 @@ gtk_source_buffer_output_stream_write (GOutputStream  *stream,
 
 	if (!ostream->is_initialized)
 	{
-		ostream->charset_conv = guess_encoding (ostream, buffer, count);
-
-		/* If we still have the previous case is that we didn't guess
-		   anything */
-		if (ostream->charset_conv == NULL &&
-		    !ostream->is_utf8)
+		if (!guess_encoding (ostream, buffer, count, error))
 		{
-			g_set_error_literal (error, GTK_SOURCE_FILE_LOADER_ERROR,
-			                     GTK_SOURCE_FILE_LOADER_ERROR_ENCODING_AUTO_DETECTION_FAILED,
-			                     "It is not possible to detect the encoding automatically");
-
 			goto failure;
 		}
 
diff --git a/gtksourceview/gtksourceencoding.c b/gtksourceview/gtksourceencoding.c
index 710c5792..e4519967 100644
--- a/gtksourceview/gtksourceencoding.c
+++ b/gtksourceview/gtksourceencoding.c
@@ -339,10 +339,30 @@ gtk_source_encoding_get_from_charset (const gchar *charset)
 	return NULL;
 }
 
+static gboolean
+can_convert (const gchar *to_charset,
+             const gchar *from_charset)
+{
+	GIConv converter = g_iconv_open (to_charset, from_charset);
+
+	if (converter == (GIConv)-1)
+	{
+		return FALSE;
+	}
+
+	g_iconv_close (converter);
+	return TRUE;
+}
+
 /**
  * gtk_source_encoding_get_all:
  *
- * Gets all encodings.
+ * Gets all known encodings available on the system for conversion to and
+ * from UTF-8. Encodings whose converters cannot be opened are omitted.
+ * UTF-8 is always included.
+ *
+ * This checks conversion support, not whether a particular document can be
+ * represented in an encoding.
  *
  * Returns: (transfer container) (element-type GtkSource.Encoding): a list of
  * all #GtkSourceEncoding's. Free with g_slist_free().
@@ -355,6 +375,12 @@ gtk_source_encoding_get_all (void)
 
 	for (i = GTK_SOURCE_ENCODING_LAST - 1; i >= 0; i--)
 	{
+		if (!can_convert ("UTF-8", encodings[i].charset) ||
+		    !can_convert (encodings[i].charset, "UTF-8"))
+		{
+			continue;
+		}
+
 		all = g_slist_prepend (all, (gpointer) &encodings[i]);
 	}
 
diff --git a/gtksourceview/gtksourcefilesaver.c b/gtksourceview/gtksourcefilesaver.c
index 0bbc60a0..d343e443 100644
--- a/gtksourceview/gtksourcefilesaver.c
+++ b/gtksourceview/gtksourcefilesaver.c
@@ -113,6 +113,7 @@ typedef struct
 	 */
 	GtkSourceBufferInputStream *input_stream;
 	GOutputStream *output_stream;
+	GCharsetConverter *charset_converter;
 
 	GFileInfo *info;
 
@@ -167,6 +168,7 @@ task_data_free (gpointer data)
 
 	g_clear_object (&task_data->input_stream);
 	g_clear_object (&task_data->output_stream);
+	g_clear_object (&task_data->charset_converter);
 	g_clear_object (&task_data->info);
 	g_clear_error (&task_data->error);
 
@@ -781,7 +783,6 @@ replace_file_cb (GObject      *source_object,
 	GTask *task = G_TASK (user_data);
 	GtkSourceFileSaver *saver;
 	TaskData *task_data;
-	GFileOutputStream *file_output_stream;
 	GOutputStream *output_stream;
 	GError *error = NULL;
 
@@ -792,7 +793,7 @@ replace_file_cb (GObject      *source_object,
 	saver = g_task_get_source_object (task);
 	task_data = g_task_get_task_data (task);
 
-	file_output_stream = g_file_replace_finish (location, result, &error);
+	output_stream = G_OUTPUT_STREAM (g_file_replace_finish (location, result, &error));
 
 	if (g_error_matches (error, G_IO_ERROR, G_IO_ERROR_NOT_MOUNTED) &&
 	    !task_data->tried_mount)
@@ -811,6 +812,9 @@ replace_file_cb (GObject      *source_object,
 		return;
 	}
 
+	g_clear_object (&task_data->output_stream);
+	task_data->output_stream = output_stream;
+
 	if (saver->compression_type == GTK_SOURCE_COMPRESSION_TYPE_GZIP)
 	{
 		GZlibCompressor *compressor;
@@ -821,44 +825,26 @@ replace_file_cb (GObject      *source_object,
 
 		compressor = g_zlib_compressor_new (G_ZLIB_COMPRESSOR_FORMAT_GZIP, -1);
 
-		output_stream = g_converter_output_stream_new (G_OUTPUT_STREAM (file_output_stream),
-							       G_CONVERTER (compressor));
+		task_data->output_stream = g_converter_output_stream_new (output_stream,
+		                                                        G_CONVERTER (compressor));
 
 		g_object_unref (compressor);
-		g_object_unref (file_output_stream);
-	}
-	else
-	{
-		output_stream = G_OUTPUT_STREAM (file_output_stream);
+		g_object_unref (output_stream);
 	}
 
-	/* FIXME: manage converter error? */
-
 	DEBUG ({
 	       g_print ("Encoding charset: %s\n",
 			gtk_source_encoding_get_charset (saver->encoding));
 	});
 
-	if (saver->encoding != gtk_source_encoding_get_utf8 ())
+	if (task_data->charset_converter != NULL)
 	{
-		GCharsetConverter *converter;
-
-		converter = g_charset_converter_new (gtk_source_encoding_get_charset (saver->encoding),
-						     "UTF-8",
-						     NULL);
-
-		g_clear_object (&task_data->output_stream);
+		output_stream = task_data->output_stream;
 		task_data->output_stream = g_converter_output_stream_new (output_stream,
-									  G_CONVERTER (converter));
-
-		g_object_unref (converter);
+		                                                        G_CONVERTER (task_data->charset_converter));
+		g_clear_object (&task_data->charset_converter);
 		g_object_unref (output_stream);
 	}
-	else
-	{
-		g_clear_object (&task_data->output_stream);
-		task_data->output_stream = G_OUTPUT_STREAM (output_stream);
-	}
 
 	task_data->total_size = _gtk_source_buffer_input_stream_get_total_size (task_data->input_stream);
 
@@ -1404,6 +1390,23 @@ gtk_source_file_saver_save_async (GtkSourceFileSaver    *saver,
 		return;
 	}
 
+	/* Check conversion support before opening the file for replacement. */
+	if (saver->encoding != gtk_source_encoding_get_utf8 ())
+	{
+		GError *error = NULL;
+
+		task_data->charset_converter =
+			g_charset_converter_new (gtk_source_encoding_get_charset (saver->encoding),
+			                         "UTF-8",
+			                         &error);
+
+		if (task_data->charset_converter == NULL)
+		{
+			g_task_return_error (saver->task, error);
+			return;
+		}
+	}
+
 	DEBUG ({
 	       g_print ("Start saving\n");
 	});
-- 
